---
/**
 * De beroepsgroeppagina — het ijkpunt van de herbouw.
 *
 * Dit is de landingsplek voor "agressietraining {beroepsgroep}", de
 * zoekopdracht waar dit merk op moet staan, en het is de pagina waar de
 * beslissing valt: welk niveau heeft mijn team nodig?
 *
 * ── Wat deze pagina anders doet dan de vorige ──
 *
 * De vorige versie was een lange strook proza met kaarten eronder. Deze is
 * opgebouwd als dossier: wie hem opent ziet eerst waar het over gaat, dan de
 * harde gegevens, dan het bewijs dat we het vak kennen, dan de keuze, en pas
 * daarna de toelichting.
 *
 * De trainers staan er groot in. Dat is geen opsmuk: er is geen fotografie op
 * deze site, en zonder de twaalf echte gezichten wordt een pagina vol
 * incidenten, cijfers en strakke typografie een rapport van de
 * Arbeidsinspectie. Agressietraining draait om vertrouwen, en vertrouwen heeft
 * een gezicht nodig.
 *
 * De praktijksituaties staan er hooguit twee tegelijk, in een dossiercontainer
 * met een kenmerkregel. Een pagina vol "intimidatie door familieleden" schrikt
 * een inkoper af; twee zinnen in een nette container laten zien dat we weten
 * waar we het over hebben.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import AISummaryBox from '../../../components/geo/AISummaryBox.astro';
import { link } from '../../../lib/link';
import { inZin } from '../../../lib/naam';
import { SECTOR_NAMEN } from '../../../lib/sectoren';
import { alleSituaties } from '../../../lib/situaties';
import { voorDeGroep } from '../../../lib/team';

export async function getStaticPaths() {
  const beroepsgroepen = await getCollection('beroepsgroepen');
  return beroepsgroepen.map((b) => ({
    params: { sector: b.data.sector, beroepsgroep: b.data.slug },
    props: { beroepsgroep: b },
  }));
}

const { beroepsgroep } = Astro.props;
const b = beroepsgroep.data;
const { Content } = await render(beroepsgroep);

const VOLGORDE = { basis: 0, gevorderd: 1, expert: 2 };
const LABEL = { basis: 'Basis', gevorderd: 'Gevorderd', expert: 'Expert' } as const;
const KERN = {
  basis: 'Herkennen en de-escaleren',
  gevorderd: 'Zwaardere en structurele situaties',
  expert: 'Beleid, teamnorm en borging',
} as const;

const trainingen = (await getCollection('trainingen'))
  .filter((t) => t.data.beroepsgroep === b.slug)
  .sort((a, z) => VOLGORDE[a.data.niveau] - VOLGORDE[z.data.niveau]);

const sectorNaam = SECTOR_NAMEN[b.sector] ?? b.sector;
const groep = inZin(b.naam);
const basis = trainingen.find((t) => t.data.niveau === 'basis') ?? trainingen[0];

/*
  Groepsgrootte verschilt per niveau: basis en gevorderd tellen tien
  deelnemers, expert acht. Als bereik tonen in plaats van weglaten — het is een
  van de drie dingen waarop een opdrachtgever scant.
*/
const groepsgrootte = (() => {
  const n = trainingen
    .map((t) => Number(t.data.groepsgrootte.match(/\d+/)?.[0]))
    .filter((x) => Number.isFinite(x));
  if (!n.length) return undefined;
  const laag = Math.min(...n);
  const hoog = Math.max(...n);
  return laag === hoog ? `max. ${hoog} deelnemers` : `max. ${laag}–${hoog} deelnemers`;
})();

const kerngegevens = ([
  ['Duur', trainingen[0]?.data.duur],
  ['Groepsgrootte', groepsgrootte],
  ['Locatie', 'Incompany of in Neede'],
  ['Afsluiting', basis?.data.certificaat ? 'Deelnamecertificaat' : undefined],
  ['Niveaus', `${trainingen.length}, van basis tot expert`],
] as [string, string | undefined][]).filter((r): r is [string, string] => Boolean(r[1]));

/* Hoogstens twee situaties: meer wordt een muur van ellende. */
const situaties = (await alleSituaties())
  .filter((s) => s.beroepsgroep === b.naam)
  .sort((a, z) => z.tekst.length - a.tekst.length)
  .slice(0, 2);

/* De trainers, als menselijk tegenwicht. */
const team = await voorDeGroep();
const fotos = import.meta.glob<{ default: ImageMetadata }>('../../../images/team/*.jpg', {
  eager: true,
});
const fotoVan = (id: string) => {
  const sleutel = Object.keys(fotos).find((p) => p.endsWith(`/${id}.jpg`));
  return sleutel ? fotos[sleutel].default : undefined;
};
const acteurs = team.filter((l) => /acteur/i.test(l.data.rol)).length;

/* Verwante beroepsgroepen: eerst dezelfde sector, daarna roterend de rest. */
const alleGroepen = (await getCollection('beroepsgroepen')).map((g) => g.data);
const opNaam = (x: { naam: string }, y: { naam: string }) => x.naam.localeCompare(y.naam);
const zelfdeSector = alleGroepen
  .filter((g) => g.sector === b.sector && g.slug !== b.slug)
  .sort(opNaam);
const rest = alleGroepen.filter((g) => g.sector !== b.sector).sort(opNaam);
let draai = 0;
for (const teken of b.slug) draai = (draai + teken.charCodeAt(0)) % 9973;
const verwant = [
  ...zelfdeSector,
  ...(rest.length
    ? rest.slice(draai % rest.length).concat(rest.slice(0, draai % rest.length))
    : []),
].slice(0, 3);

/*
  Deze pagina wijst trainingen aan; ze staan er niet zelf op.

  Er stond hier een ItemList met per regel een halve Course: naam, doelgroep,
  niveau en aanbieder, maar zonder hasCourseInstance. Google vraagt dat veld
  sinds 2024 voor elke Course die als resultaat getoond wordt, dus die
  halffabrikaten werden stilzwijgend genegeerd — en tegelijk stond de vólledige
  Course al op de trainingspagina zelf. Twee beschrijvingen van hetzelfde ding,
  waarvan er één niet bruikbaar was.

  Dit is nu het overzichtspatroon dat Google voor zulke pagina's beschrijft:
  een ItemList die alleen naar de detailpagina's verwijst. De volledige
  cursusgegevens staan op één plek, en dat is de plek waar iemand ook echt
  terechtkomt.
*/
const lijstSchema = trainingen.length
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `Agressietraining voor ${groep}`,
      numberOfItems: trainingen.length,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: trainingen.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.data.titel,
        url: new URL(link(`/trainingen/${t.data.slug}/`), Astro.site).href,
      })),
    })
  : null;


/*
  Het direct citeerbare antwoordblok.

  Een AI-antwoordsysteem neemt zelden een hele pagina over; het zoekt een blok
  dat op zichzelf klopt. Deze drie antwoorden komen uit de trainingen van déze
  beroepsgroep, dus ze verschillen per pagina en er staat niets in wat niet
  ergens anders op de site na te trekken is.

  Elk antwoord noemt de organisatie of de beroepsgroep voluit: losgeknipt van
  de pagina moet het nog steeds een compleet antwoord zijn, zonder "hier" of
  "zoals hierboven".
*/
const niveauLijst = trainingen.map((t) => LABEL[t.data.niveau].toLowerCase()).join(', ');
const antwoorden = [
  {
    vraag: `Voor wie is de agressietraining voor ${groep}?`,
    antwoord: `Voor ${groep} die in het werk met agressie, intimidatie of grensoverschrijdend gedrag te maken kunnen krijgen.`,
  },
  {
    vraag: `Hoe lang duurt de training en hoe groot is de groep?`,
    antwoord: `Elke training van Bureau Weerbaar en Veilig duurt ${trainingen[0]?.data.duur ?? '1 dag'}, met ${groepsgrootte ?? 'een kleine groep'}.`,
  },
  {
    vraag: `Welke niveaus zijn er voor ${groep}?`,
    antwoord: `Bureau Weerbaar en Veilig biedt ${trainingen.length === 1 ? 'één niveau' : `${trainingen.length} niveaus`} voor ${groep}: ${niveauLijst}.`,
  },
];

/*
  De niveauschakelaar. Op een breed scherm staan de drie kaarten naast elkaar en
  licht de gekozen kaart op; op een telefoon staat er één tegelijk. Drie dichte
  kaarten onder elkaar is op een klein scherm bijna twee schermen scrollen
  voordat je ze kunt vergelijken, en dan vergelijk je dus niet meer.

  De regels worden gegenereerd uit de trainingen die deze beroepsgroep
  daadwerkelijk heeft: niet elke beroepsgroep heeft alle drie de niveaus.
*/
const schakelaarCss = trainingen
  .map(
    (t) => `
  .niveaukeuze:has(#kies-${t.data.niveau}:checked) label[for="kies-${t.data.niveau}"] {
    background: var(--color-marine); color: #fff; border-color: var(--color-marine);
  }
  @media (max-width: 780px) {
    .niveaukeuze:has(#kies-${t.data.niveau}:checked) .niveaukaart-vol:not([data-niveau="${t.data.niveau}"]) {
      display: none;
    }
  }
  @media (min-width: 781px) {
    .niveaukeuze:has(#kies-${t.data.niveau}:checked) .niveaukaart-vol[data-niveau="${t.data.niveau}"] {
      border-color: var(--accent);
      box-shadow: var(--schaduw-md);
      transform: translateY(-4px);
    }
  }`
  )
  .join('');
---

<Base titel={`Agressietraining ${groep}`} beschrijving={b.samenvatting} schema={lijstSchema ? [lijstSchema] : []}>
  {/* ═══ Paginakop ═══ */}
  <section class="paginakop op-donker">
    <div class="wrap">
      <Breadcrumb
        pad={[
          { naam: 'Home', pad: '/' },
          { naam: 'Sectoren', pad: '/sectoren/' },
          { naam: sectorNaam, pad: `/sectoren/${b.sector}/` },
          { naam: b.naam },
        ]}
      />
      <p class="eyebrow">Beroepsgroep · {sectorNaam}</p>
      <h1>Agressietraining voor {groep}</h1>
      <p class="lede">{b.samenvatting}</p>

      {/*
        De harde feiten meteen in de kop. Ze stonden eerder in een zijkolom, en
        die zakt op een telefoon onder de hele pagina — precies daar waar
        niemand ze ziet.
      */}
      <div class="kop-stats">
        {kerngegevens.map(([label, waarde]) => (
          <div class="kop-stat">
            <b>{waarde}</b>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══ Kort antwoord — het stuk dat een AI-systeem losknipt ═══ */}
  <section class="section section--tight">
    <div class="wrap">
      <AISummaryBox
        onderwerp={`agressietraining voor ${groep}`}
        blokken={antwoorden}
        meer={{ tekst: 'Bekijk de niveaus en het programma', pad: `/sectoren/${b.sector}/${b.slug}/#niveaus` }}
      />
    </div>
  </section>

  {/* ═══ Wat er in dit vak gebeurt — het volle merk-oranje ═══ */}
  {situaties.length > 0 && (
    <section class="section section--tight section--oranje">
      <div class="wrap">
        <p class="eyebrow">Uit de trainingen</p>
        <h2>Dit komt aan bod</h2>
        <div class="grid grid-2 situatieraster">
          {situaties.map((s, i) => (
            <article class={`situatie niveau-${trainingen[i]?.data.niveau ?? 'basis'} komt-op`}>
              <p class="situatie-bron">
                <span>Casus {String(i + 1).padStart(2, '0')}</span>
                <span>{sectorNaam}</span>
              </p>
              <p class="situatie-tekst">{s.tekst}</p>
            </article>
          ))}
        </div>
        <p class="situatie-slot">
          Deze situaties staan letterlijk in de trainingen voor {groep} — ze zijn
          niet bedacht als voorbeeld, maar het uitgangspunt van de oefening.
        </p>
      </div>
    </section>
  )}

  {/* ═══ De keuze ═══ */}
  <section class="section" id="niveaus">
    <div class="wrap">
      <p class="eyebrow">Welk niveau heeft mijn team nodig?</p>
      <h2>{trainingen.length === 1 ? 'De training' : `De ${trainingen.length} niveaus`}</h2>
      <p class="lede">
        Alle niveaus behandelen hetzelfde onderwerp, maar niet dezelfde situaties
        en niet voor dezelfde mensen.
      </p>

      {/*
        De schakelaar staat vóór het raster: op een telefoon is dit het
        bedieningspaneel, op een breed scherm een accent op de kaart waar je
        naar kijkt. Radioknoppen, dus het werkt met JavaScript uit en is met
        het toetsenbord te bedienen.
      */}
      {trainingen.length > 1 && (
        <div class="niveaukeuze" role="group" aria-label="Kies een niveau">
          {trainingen.map((t, i) => (
            <>
              <input
                class="sr-only"
                type="radio"
                name="niveaukeuze"
                id={`kies-${t.data.niveau}`}
                checked={i === 0}
              />
              <label class="niveaukeuze-knop" for={`kies-${t.data.niveau}`}>
                {LABEL[t.data.niveau]}
              </label>
            </>
          ))}
        </div>
      )}

      <div class="grid grid-3 sectorraster">
        {trainingen.map((t) => (
          <article
            class={`card niveaukaart-vol niveau-${t.data.niveau} komt-op`}
            data-niveau={t.data.niveau}
          >
            <span class="badge">{LABEL[t.data.niveau]}</span>
            <h3 class="niveau-kop">
              <a href={link(`/trainingen/${t.data.slug}/`)} class="vlakdek">
                {KERN[t.data.niveau]}
              </a>
            </h3>

            <dl class="gegevens niveau-gegevens">
              <div>
                <dt>Voor wie</dt>
                <dd class="gegeven-lang">{t.data.doelgroep}</dd>
              </div>
              <div>
                <dt>Vooraf</dt>
                <dd class="gegeven-lang">
                  {t.data.voorwaarde
                    ? t.data.voorwaarde.charAt(0).toUpperCase() + t.data.voorwaarde.slice(1)
                    : 'Geen voorkennis nodig'}
                </dd>
              </div>
            </dl>

            <span class="nav-kop niveau-tussenkop">Wat je meeneemt</span>
            <ul class="ladder-lijst">
              {t.data.resultaat.slice(0, 3).map((r) => <li>{r}</li>)}
            </ul>

            <span class="btn-ghost niveau-link">Bekijk het programma</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══ De mensen — het volle blauw ═══ */}
  <section class="section section--blauw op-donker">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">Wie er voor de groep staat</p>
          <h2>Eén vast team, met {acteurs} trainingsacteurs</h2>
          <p class="lede">
            Iedereen hier geeft alle trainingen, want Bureau Weerbaar en Veilig
            doet maar één ding. Dankzij de acteurs oefen je met de situatie die
            jij inbrengt, in plaats van met een bedacht rollenspel.
          </p>
          <div class="hero-actions teamknop">
            <a href={link('/over-ons/')} class="btn btn-outline">Maak kennis met het team</a>
          </div>
        </div>

        <ul class="gezichten">
          {team.map((lid) => {
            const foto = fotoVan(lid.id);
            return foto ? (
              <li>
                <a href={link(`/team/${lid.id}/`)}>
                  <Image
                    src={foto}
                    alt={`${lid.data.naam}, ${inZin(lid.data.rol)}`}
                    width={144}
                    height={144}
                    format="webp"
                    quality={86}
                    loading="lazy"
                    decoding="async"
                    class="gezicht"
                  />
                </a>
              </li>
            ) : null;
          })}
        </ul>
      </div>
    </div>
  </section>

  {/* ═══ De toelichting ═══ */}
  <section class="section section--soft">
    <div class="wrap">
      <p class="eyebrow">Over dit vak</p>
      <div class="leestekst">
        <Content />
      </div>
    </div>
  </section>

  {/* ═══ Verder kijken ═══ */}
  {verwant.length > 0 && (
    <section class="section section--tight">
      <div class="wrap">
        <p class="eyebrow">Ook relevant voor jouw organisatie</p>
        <div class="grid grid-3 sectorraster">
          {verwant.map((g) => (
            <article class="card">
              <h3>
                <a href={link(`/sectoren/${g.sector}/${g.slug}/`)} class="vlakdek">{g.naam}</a>
              </h3>
              <p>{SECTOR_NAMEN[g.sector] ?? g.sector}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ═══ Afsluiting ═══ */}
  <section class="section section--tight">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Vragen over de training voor {groep}?</h2>
          <p>
            Bel of vraag een terugbelverzoek aan. Je krijgt binnen één werkdag
            antwoord.
          </p>
        </div>
        <div class="hero-actions">
          <a href="tel:+31857600435" class="btn btn-outline">Bel 085 760 0435</a>
          <a href={link('/contact/')} class="btn btn-outline">Vraag een terugbelverzoek</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:inline set:html={schakelaarCss} />
