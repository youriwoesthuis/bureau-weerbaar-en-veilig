---
/**
 * De beroepsgroeppagina — het ijkpunt van de herbouw.
 *
 * Dit is de landingsplek voor "agressietraining {beroepsgroep}", de
 * zoekopdracht waar dit merk op moet staan, en het is de pagina waar de
 * beslissing valt: welk niveau heeft mijn team nodig?
 *
 * ── Wat deze pagina anders doet dan de vorige ──
 *
 * De vorige versie was een lange strook proza met kaarten eronder. Deze is
 * opgebouwd als dossier: wie hem opent ziet eerst waar het over gaat, dan de
 * harde gegevens, dan het bewijs dat we het vak kennen, dan de keuze, en pas
 * daarna de toelichting.
 *
 * De trainers staan er groot in. Dat is geen opsmuk: er is geen fotografie op
 * deze site, en zonder de twaalf echte gezichten wordt een pagina vol
 * incidenten, cijfers en strakke typografie een rapport van de
 * Arbeidsinspectie. Agressietraining draait om vertrouwen, en vertrouwen heeft
 * een gezicht nodig.
 *
 * De praktijksituaties staan er hooguit twee tegelijk, in een dossiercontainer
 * met een kenmerkregel. Een pagina vol "intimidatie door familieleden" schrikt
 * een inkoper af; twee zinnen in een nette container laten zien dat we weten
 * waar we het over hebben.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { link } from '../../../lib/link';
import { inZin } from '../../../lib/naam';
import { SECTOR_NAMEN } from '../../../lib/sectoren';
import { ORGANISATIE } from '../../../lib/organisatie';
import { alleSituaties } from '../../../lib/situaties';
import { voorDeGroep } from '../../../lib/team';

export async function getStaticPaths() {
  const beroepsgroepen = await getCollection('beroepsgroepen');
  return beroepsgroepen.map((b) => ({
    params: { sector: b.data.sector, beroepsgroep: b.data.slug },
    props: { beroepsgroep: b },
  }));
}

const { beroepsgroep } = Astro.props;
const b = beroepsgroep.data;
const { Content } = await render(beroepsgroep);

const VOLGORDE = { basis: 0, gevorderd: 1, expert: 2 };
const LABEL = { basis: 'Basis', gevorderd: 'Gevorderd', expert: 'Expert' } as const;
const KERN = {
  basis: 'Herkennen en de-escaleren',
  gevorderd: 'Zwaardere en structurele situaties',
  expert: 'Beleid, teamnorm en borging',
} as const;

const trainingen = (await getCollection('trainingen'))
  .filter((t) => t.data.beroepsgroep === b.slug)
  .sort((a, z) => VOLGORDE[a.data.niveau] - VOLGORDE[z.data.niveau]);

const sectorNaam = SECTOR_NAMEN[b.sector] ?? b.sector;
const groep = inZin(b.naam);
const basis = trainingen.find((t) => t.data.niveau === 'basis') ?? trainingen[0];

/*
  Groepsgrootte verschilt per niveau: basis en gevorderd tellen tien
  deelnemers, expert acht. Als bereik tonen in plaats van weglaten — het is een
  van de drie dingen waarop een opdrachtgever scant.
*/
const groepsgrootte = (() => {
  const n = trainingen
    .map((t) => Number(t.data.groepsgrootte.match(/\d+/)?.[0]))
    .filter((x) => Number.isFinite(x));
  if (!n.length) return undefined;
  const laag = Math.min(...n);
  const hoog = Math.max(...n);
  return laag === hoog ? `max. ${hoog} deelnemers` : `max. ${laag}–${hoog} deelnemers`;
})();

const kerngegevens = ([
  ['Duur', trainingen[0]?.data.duur],
  ['Groepsgrootte', groepsgrootte],
  ['Locatie', 'Incompany of in Neede'],
  ['Afsluiting', basis?.data.certificaat ? 'Deelnamecertificaat' : undefined],
  ['Niveaus', `${trainingen.length}, van basis tot expert`],
] as [string, string | undefined][]).filter((r): r is [string, string] => Boolean(r[1]));

/* Hoogstens twee situaties: meer wordt een muur van ellende. */
const situaties = (await alleSituaties())
  .filter((s) => s.beroepsgroep === b.naam)
  .sort((a, z) => z.tekst.length - a.tekst.length)
  .slice(0, 2);

/* De trainers, als menselijk tegenwicht. */
const team = await voorDeGroep();
const fotos = import.meta.glob<{ default: ImageMetadata }>('../../../images/team/*.jpg', {
  eager: true,
});
const fotoVan = (id: string) => {
  const sleutel = Object.keys(fotos).find((p) => p.endsWith(`/${id}.jpg`));
  return sleutel ? fotos[sleutel].default : undefined;
};
const acteurs = team.filter((l) => /acteur/i.test(l.data.rol)).length;

/* Verwante beroepsgroepen: eerst dezelfde sector, daarna roterend de rest. */
const alleGroepen = (await getCollection('beroepsgroepen')).map((g) => g.data);
const opNaam = (x: { naam: string }, y: { naam: string }) => x.naam.localeCompare(y.naam);
const zelfdeSector = alleGroepen
  .filter((g) => g.sector === b.sector && g.slug !== b.slug)
  .sort(opNaam);
const rest = alleGroepen.filter((g) => g.sector !== b.sector).sort(opNaam);
let draai = 0;
for (const teken of b.slug) draai = (draai + teken.charCodeAt(0)) % 9973;
const verwant = [
  ...zelfdeSector,
  ...(rest.length
    ? rest.slice(draai % rest.length).concat(rest.slice(0, draai % rest.length))
    : []),
].slice(0, 3);

const lijstSchema = trainingen.length
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `Agressietraining voor ${groep}`,
      numberOfItems: trainingen.length,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: trainingen.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Course',
          name: t.data.titel,
          description: t.data.doelgroep,
          educationalLevel: t.data.niveau,
          url: new URL(link(`/trainingen/${t.data.slug}/`), Astro.site).href,
          provider: ORGANISATIE,
        },
      })),
    })
  : null;
---

<Base
  titel={`Agressietraining ${groep}`}
  beschrijving={b.samenvatting}
  schema={lijstSchema ? [lijstSchema] : []}
>
  {/* ── Kop: waar ben ik, waar gaat dit over, wat zijn de feiten ── */}
  <section class="vlak-donker op-donker kopvlak">
    <div class="omvat">
      <Breadcrumb
        pad={[
          { naam: 'Home', pad: '/' },
          { naam: 'Sectoren', pad: '/sectoren/' },
          { naam: sectorNaam, pad: `/sectoren/${b.sector}/` },
          { naam: b.naam },
        ]}
      />

      <div class="kopblok">
        <div>
          <p class="label kopblok-label">Beroepsgroep · {sectorNaam}</p>
          <h1 class="kopblok-titel">Agressietraining voor {groep}</h1>
          <p class="kopblok-lead">{b.samenvatting}</p>

          <div class="kopblok-acties">
            <a href="#niveaus" class="knop knop-accent niveau-basis">
              Kies je niveau
              <span class="pijl" aria-hidden="true">→</span>
            </a>
            <a href={link('/contact/')} class="knop knop-rand">Overleg met ons</a>
          </div>
        </div>

        {/*
          De harde feiten staan naast de kop, niet in een zijkolom. Die zakt op
          een telefoon onder de hele pagina, en dan ziet niemand ze.
        */}
        <dl class="gegevens kopblok-feiten">
          {kerngegevens.map(([label, waarde]) => (
            <div>
              <dt>{label}</dt>
              <dd>{waarde}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  {/* ── Het bewijs: wat er in dit vak echt gebeurt ── */}
  {situaties.length > 0 && (
    <section class="vlak-papier vlak-krap">
      <div class="omvat">
        <p class="label">Uit de trainingen</p>
        <div class="dossierrij">
          {situaties.map((s, i) => (
            <article class={`dossier niveau-${trainingen[i]?.data.niveau ?? 'basis'} komt-op`}>
              <p class="dossier-kenmerk">
                <span>Casus {String(i + 1).padStart(2, '0')}</span>
                <span>{sectorNaam}</span>
              </p>
              <p class="dossier-tekst">{s.tekst}</p>
            </article>
          ))}
        </div>
        <p class="dossier-bij">
          Deze situaties staan letterlijk in de trainingen voor {groep}. Ze zijn
          niet bedacht als voorbeeld — ze zijn het uitgangspunt van de oefening.
        </p>
      </div>
    </section>
  )}

  {/* ── De keuze ── */}
  <section id="niveaus" class="vlak">
    <div class="omvat">
      <p class="label">Welk niveau heeft mijn team nodig?</p>
      <h2 class="sectie-titel">
        {trainingen.length === 1 ? 'De training' : `De ${trainingen.length} niveaus`}
      </h2>
      <p class="sectie-lead">
        Alle niveaus behandelen hetzelfde onderwerp, maar niet dezelfde situaties
        en niet voor dezelfde mensen.
      </p>

      <ol class="niveaus">
        {trainingen.map((t) => (
          <li class={`niveau-${t.data.niveau} kaart niveaukaart komt-op`}>
            <span class="niveaumerk">{LABEL[t.data.niveau]}</span>
            <h3 class="niveaukaart-titel">{KERN[t.data.niveau]}</h3>

            <dl class="gegevens niveaukaart-info">
              <div>
                <dt>Voor wie</dt>
                <dd>{t.data.doelgroep}</dd>
              </div>
              <div>
                <dt>Vooraf</dt>
                <dd>
                  {t.data.voorwaarde
                    ? t.data.voorwaarde.charAt(0).toUpperCase() + t.data.voorwaarde.slice(1)
                    : 'Geen voorkennis nodig'}
                </dd>
              </div>
            </dl>

            <p class="niveaukaart-kopje">Wat je meeneemt</p>
            <ul class="niveaukaart-lijst">
              {t.data.resultaat.slice(0, 3).map((r) => <li>{r}</li>)}
            </ul>

            <a href={link(`/trainingen/${t.data.slug}/`)} class="knop knop-accent niveaukaart-knop vlakdek">
              Bekijk het programma
              <span class="sr-only"> van het niveau {LABEL[t.data.niveau].toLowerCase()}</span>
              <span class="pijl" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ── De mensen: het warme tegenwicht ── */}
  <section class="vlak-donker op-donker vlak">
    <div class="omvat mensen">
      <div>
        <p class="label">Wie er voor de groep staat</p>
        <h2 class="sectie-titel mensen-titel">
          Eén vast team, met {acteurs} trainingsacteurs
        </h2>
        <p class="mensen-tekst">
          Iedereen hier geeft alle trainingen, want Bureau Weerbaar en Veilig doet
          maar één ding. Dankzij de acteurs oefen je met de situatie die jij
          inbrengt, in plaats van met een bedacht rollenspel.
        </p>
        <a href={link('/over-ons/')} class="knop knop-rand mensen-knop">
          Maak kennis met het team
          <span class="pijl" aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="gezichtenrij">
        {team.map((lid) => {
          const foto = fotoVan(lid.id);
          return foto ? (
            <li>
              <a href={link(`/team/${lid.id}/`)}>
                <Image
                  src={foto}
                  alt={`${lid.data.naam}, ${inZin(lid.data.rol)}`}
                  width={112}
                  height={112}
                  format="webp"
                  quality={86}
                  loading="lazy"
                  decoding="async"
                  class="gezicht"
                />
              </a>
            </li>
          ) : null;
        })}
      </ul>
    </div>
  </section>

  {/* ── De toelichting: hier zit iemand die bijna besloten heeft ── */}
  <section class="vlak">
    <div class="omvat-smal">
      <p class="label">Over dit vak</p>
      <div class="leestekst leestekst-na-label">
        <Content />
      </div>
    </div>
  </section>

  {/* ── Verder kijken ── */}
  {verwant.length > 0 && (
    <section class="vlak-papier vlak-krap">
      <div class="omvat">
        <p class="label">Ook relevant voor jouw organisatie</p>
        <ul class="verwant">
          {verwant.map((g) => (
            <li class="kaart verwant-kaart">
              <h3 class="verwant-naam">
                <a href={link(`/sectoren/${g.sector}/${g.slug}/`)} class="vlakdek">
                  {g.naam}
                </a>
              </h3>
              <p class="verwant-sector">{SECTOR_NAMEN[g.sector] ?? g.sector}</p>
              <span class="pijl verwant-pijl" aria-hidden="true">→</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>
