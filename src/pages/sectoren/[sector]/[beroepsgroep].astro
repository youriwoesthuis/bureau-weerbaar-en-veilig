---
import { link } from '../../../lib/link';
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import NiveauBadge from '../../../components/NiveauBadge.astro';
import Terugbelverzoek from '../../../components/Terugbelverzoek.astro';
import { SECTOR_NAMEN, NIVEAU_BESCHRIJVING } from '../../../lib/sectoren';

export async function getStaticPaths() {
  const beroepsgroepen = await getCollection('beroepsgroepen');
  return beroepsgroepen.map((b) => ({
    params: { sector: b.data.sector, beroepsgroep: b.data.slug },
    props: { beroepsgroep: b },
  }));
}

const { beroepsgroep } = Astro.props;
const b = beroepsgroep.data;
const { Content } = await render(beroepsgroep);

const NIVEAU_VOLGORDE = { basis: 0, gevorderd: 1, expert: 2 };
const trainingen = (await getCollection('trainingen'))
  .filter((t) => t.data.beroepsgroep === b.slug)
  .sort((a, z) => NIVEAU_VOLGORDE[a.data.niveau] - NIVEAU_VOLGORDE[z.data.niveau]);

const sectorNaam = SECTOR_NAMEN[b.sector] ?? b.sector;
---

<Base titel={`Agressietraining ${b.naam.toLowerCase()}`} beschrijving={b.samenvatting}>
  <div class="vlak-donker op-donker relative overflow-hidden text-white">
    <div class="motief-chevron absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-10 md:py-14">
      <Breadcrumb
        pad={[
          { naam: 'Home', pad: '/' },
          { naam: 'Sectoren', pad: '/sectoren/' },
          { naam: sectorNaam, pad: `/sectoren/${b.sector}/` },
          { naam: b.naam },
        ]}
      />
      <p class="kicker mt-7">Beroepsgroep</p>
      <h1 class="mt-4 max-w-3xl text-3xl font-bold leading-[1.15] md:text-5xl">
        Agressietraining voor {b.naam.toLowerCase()}
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-white/85">{b.samenvatting}</p>
    </div>
  </div>
  <div class="lijn-merk" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 py-12">
    <section class="leestekst">
      <Content />
    </section>

    <!-- De drie niveaus naast elkaar -->
    <section class="mt-14" aria-labelledby="niveaus-titel">
      <p class="kicker">Drie niveaus</p>
      <h2 id="niveaus-titel" class="kop-onderstreept mt-4 text-3xl font-bold text-marine">
        Kies je niveau
      </h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {trainingen.map((t) => (
          <article class={`niveau-${t.data.niveau} kaart flex flex-col p-6`}>
            <NiveauBadge niveau={t.data.niveau} />
            <h3 class="mt-4 text-lg font-bold leading-snug text-marine">{t.data.titel}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-grijs">
              {NIVEAU_BESCHRIJVING[t.data.niveau]}
            </p>
            <dl class="mt-5 divide-y divide-lijn border-t border-lijn text-sm">
              <div class="flex justify-between gap-2 py-2">
                <dt class="font-semibold text-grijs">Duur</dt>
                <dd class="text-right font-medium">{t.data.duur}</dd>
              </div>
              <div class="flex justify-between gap-2 py-2">
                <dt class="font-semibold text-grijs">Groep</dt>
                <dd class="text-right font-medium">{t.data.groepsgrootte}</dd>
              </div>
            </dl>
            <a
              href={link(`/trainingen/${t.data.slug}/`)}
              class="mt-5 inline-flex items-center justify-center gap-2 rounded-md px-4 py-2.5 text-center text-sm font-bold text-white after:absolute after:inset-0"
              style="background: var(--accent-sterk)"
            >
              Bekijk deze training
              <span class="pijl" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <div class="mt-12 max-w-3xl">
      <Terugbelverzoek onderwerp={`de agressietraining voor ${b.naam.toLowerCase()}`} />
    </div>
  </div>
</Base>
