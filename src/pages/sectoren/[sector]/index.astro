---
import { link } from '../../../lib/link';
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import NiveauBadge from '../../../components/NiveauBadge.astro';
import Terugbelverzoek from '../../../components/Terugbelverzoek.astro';

export async function getStaticPaths() {
  const sectoren = await getCollection('sectoren');
  return sectoren.map((s) => ({ params: { sector: s.data.slug }, props: { sector: s } }));
}

const { sector } = Astro.props;
const { Content } = await render(sector);

const beroepsgroepen = (await getCollection('beroepsgroepen')).filter(
  (b) => b.data.sector === sector.data.slug
);
const trainingen = (await getCollection('trainingen')).filter(
  (t) => t.data.sector === sector.data.slug
);

const NIVEAU_VOLGORDE = { basis: 0, gevorderd: 1, expert: 2 };
const trainingenVan = (beroepsgroep: string) =>
  trainingen
    .filter((t) => t.data.beroepsgroep === beroepsgroep)
    .sort((a, b) => NIVEAU_VOLGORDE[a.data.niveau] - NIVEAU_VOLGORDE[b.data.niveau]);
---

<Base
  titel={`Agressietraining ${sector.data.naam.toLowerCase()}`}
  beschrijving={sector.data.samenvatting}
>
  <div class="vlak-donker op-donker relative overflow-hidden text-white">
    <div class="motief-chevron absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-10 md:py-14">
      <Breadcrumb
        pad={[
          { naam: 'Home', pad: '/' },
          { naam: 'Sectoren', pad: '/sectoren/' },
          { naam: sector.data.naam },
        ]}
      />
      <p class="kicker mt-7">Sector</p>
      <h1 class="mt-4 max-w-3xl text-3xl font-bold leading-[1.15] md:text-5xl">
        Agressietraining in de sector {sector.data.naam.toLowerCase()}
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-white/85">
        {sector.data.samenvatting}
      </p>
    </div>
  </div>
  <div class="lijn-merk" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 py-12">
    <section class="max-w-3xl space-y-4 leading-relaxed [&_p]:mb-4">
      <Content />
    </section>

    <section class="mt-14" aria-labelledby="beroepsgroepen-titel">
      <p class="kicker">Binnen deze sector</p>
      <h2 id="beroepsgroepen-titel" class="kop-onderstreept mt-4 text-3xl font-bold text-marine">
        Kies je beroepsgroep
      </h2>
      <div class="mt-8 space-y-6">
        {beroepsgroepen.map((b) => (
          <div class="relative overflow-hidden rounded-xl border border-lijn bg-white p-6 shadow-[var(--shadow-kaart)] md:p-7">
            <span class="lijn-merk absolute inset-x-0 top-0" aria-hidden="true"></span>
            <h3 class="text-xl font-bold text-marine">
              <a
                href={link(`/sectoren/${sector.data.slug}/${b.data.slug}/`)}
                class="group inline-flex items-center gap-2 hover:underline"
              >
                {b.data.naam}
                <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </h3>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-grijs">{b.data.samenvatting}</p>
            <ul class="mt-5 grid gap-3 md:grid-cols-3">
              {trainingenVan(b.data.slug).map((t) => (
                <li
                  class={`niveau-${t.data.niveau} kaart p-4`}
                  style="border-radius: .5rem"
                >
                  <NiveauBadge niveau={t.data.niveau} />
                  <a
                    href={link(`/trainingen/${t.data.slug}/`)}
                    class="mt-3 block text-sm font-bold text-marine after:absolute after:inset-0"
                  >
                    {t.data.titel}
                    <span class="pijl" aria-hidden="true">→</span>
                  </a>
                  <p class="mt-1.5 text-xs font-medium text-grijs">{t.data.duur}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <div class="mt-12 max-w-3xl">
      <Terugbelverzoek onderwerp={`agressietraining in de ${sector.data.naam.toLowerCase()}`} />
    </div>
  </div>
</Base>
