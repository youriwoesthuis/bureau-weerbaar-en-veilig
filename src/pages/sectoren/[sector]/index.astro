---
import { link } from '../../../lib/link';
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { inZin } from '../../../lib/naam';
import { situatieSelectie } from '../../../lib/situaties';
import Terugbelverzoek from '../../../components/Terugbelverzoek.astro';

export async function getStaticPaths() {
  const sectoren = await getCollection('sectoren');
  return sectoren.map((s) => ({ params: { sector: s.data.slug }, props: { sector: s } }));
}

const { sector } = Astro.props;
const { Content } = await render(sector);

const beroepsgroepen = (await getCollection('beroepsgroepen')).filter(
  (b) => b.data.sector === sector.data.slug
);
const trainingen = (await getCollection('trainingen')).filter(
  (t) => t.data.sector === sector.data.slug
);

const situaties = await situatieSelectie(6, sector.data.slug);

const NIVEAU_VOLGORDE = { basis: 0, gevorderd: 1, expert: 2 };
const trainingenVan = (beroepsgroep: string) =>
  trainingen
    .filter((t) => t.data.beroepsgroep === beroepsgroep)
    .sort((a, b) => NIVEAU_VOLGORDE[a.data.niveau] - NIVEAU_VOLGORDE[b.data.niveau]);

/*
  Deze pagina wijst de beroepsgroepen binnen de sector aan, en dat is ook wat
  er in de gestructureerde data staat: een ItemList met verwijzingen. Geen
  Course hier — een sector is geen cursus, en de cursusgegevens staan een
  niveau dieper al volledig opgevoerd. Dubbel opvoeren maakt het niet
  geloofwaardiger, alleen dubbel.
*/
const lijstSchema = beroepsgroepen.length
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `Agressietraining in de sector ${inZin(sector.data.naam)}`,
      numberOfItems: beroepsgroepen.length,
      itemListElement: beroepsgroepen.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.data.naam,
        url: new URL(link(`/sectoren/${sector.data.slug}/${b.data.slug}/`), Astro.site).href,
      })),
    })
  : null;
---

<Base
  titel={`Agressietraining ${inZin(sector.data.naam)}`}
  beschrijving={sector.data.samenvatting}
  schema={lijstSchema ? [lijstSchema] : []}
>
  {/* ═══ Paginakop ═══ */}
  <section class="paginakop op-donker">
    <div class="wrap">
      <Breadcrumb
        pad={[
          { naam: 'Home', pad: '/' },
          { naam: 'Sectoren', pad: '/sectoren/' },
          { naam: sector.data.naam },
        ]}
      />
      <p class="eyebrow">Sector</p>
      <h1>Agressietraining in de sector {inZin(sector.data.naam)}</h1>
      <p class="lede">{sector.data.samenvatting}</p>

      {/*
        Wat deze sector omvat, in cijfers. Ze staan verderop in de kaarten ook
        wel, maar dan moet je tellen; hier is in één blik te zien of dit een
        sector met één beroepsgroep is of met acht.
      */}
      <div class="kop-stats">
        {[
          [String(beroepsgroepen.length), beroepsgroepen.length === 1 ? 'Beroepsgroep' : 'Beroepsgroepen'],
          [String(trainingen.length), 'Trainingen'],
          ['1 dag', 'Elke training'],
          ['Neede', 'Of incompany'],
        ].map(([waarde, label]) => (
          <div class="kop-stat">
            <b>{waarde}</b>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══ De sectortekst ═══ */}
  <section class="section">
    <div class="wrap">
      <div class="leestekst">
        <Content />
      </div>
    </div>
  </section>

  {/*
    ═══ De situaties uit déze sector, letterlijk uit de trainingen eronder ═══

    Een sectorpagina die alleen uitlegt dat er trainingen zijn, leest als een
    inhoudsopgave. Deze zinnen laten in één blik zien dat we het vak kennen —
    en ze zijn per sector anders, want ze komen uit de trainingen van die
    sector. Dat is precies wat een bezoeker hier komt controleren: begrijpen
    jullie mijn werk eigenlijk wel?
  */}
  {situaties.length > 0 && (
    <section class="section section--oranje" aria-labelledby="situaties-titel">
      <div class="wrap">
        <p class="eyebrow">Waar het over gaat</p>
        {/*
          "de sector {naam}" en niet "de {naam}": sectornamen hebben niet
          allemaal hetzelfde lidwoord — het is de zorg maar het openbaar
          vervoer, en de horeca maar het onderwijs. Door "sector" ertussen te
          zetten klopt de zin voor alle negentien zonder dat er per sector een
          lidwoord in de data hoeft.
        */}
        <h2 id="situaties-titel">
          Situaties uit de sector {inZin(sector.data.naam)}, zoals ze in de trainingen staan
        </h2>

        <div class="grid grid-2 situatieraster">
          {situaties.map((s) => (
            <div class="situatie komt-op">
              <p class="situatie-tekst">{s.tekst}</p>
              <p class="situatie-bron">
                <a href={link(`/trainingen/${s.slug}/`)}>{s.beroepsgroep}</a>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ═══ De beroepsgroepen ═══ */}
  <section class="section section--soft" aria-labelledby="beroepsgroepen-titel">
    <div class="wrap">
      <p class="eyebrow">Binnen deze sector</p>
      <h2 id="beroepsgroepen-titel">Kies je beroepsgroep</h2>

      <div class="groepenlijst">
        {beroepsgroepen.map((b) => (
          <article class="groep">
            <h3 class="groep-titel">
              <a href={link(`/sectoren/${sector.data.slug}/${b.data.slug}/`)}>{b.data.naam}</a>
            </h3>
            <p class="groep-tekst">{b.data.samenvatting}</p>

            <ul class="grid grid-3 groep-niveaus">
              {trainingenVan(b.data.slug).map((t) => (
                <li class={`niveaukaart niveau-${t.data.niveau}`}>
                  <span class="badge">
                    {{ basis: 'Basis', gevorderd: 'Gevorderd', expert: 'Expert' }[t.data.niveau]}
                  </span>
                  <a href={link(`/trainingen/${t.data.slug}/`)} class="niveaukaart-link vlakdek">
                    {t.data.titel}
                  </a>
                  <span class="niveaukaart-duur">{t.data.duur}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══ Afsluiting ═══ */}
  <section class="section section--tight">
    <div class="wrap">
      <Terugbelverzoek onderwerp={`agressietraining in de ${inZin(sector.data.naam)}`} />
    </div>
  </section>
</Base>
