---
import { link } from '../../lib/link';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SECTOR_NAMEN } from '../../lib/sectoren';

const sectoren = await getCollection('sectoren');
const trainingen = await getCollection('trainingen');

const perSector = (slug: string) => trainingen.filter((t) => t.data.sector === slug).length;

/* Sectoren met een eigen contentbestand eerst, daarna de nog te vullen sectoren als lijst */
const gevuld = sectoren.sort((a, b) => a.data.naam.localeCompare(b.data.naam));
const gevuldeSlugs = new Set(gevuld.map((s) => s.data.slug));
const nogTeVullen = Object.entries(SECTOR_NAMEN).filter(([slug]) => !gevuldeSlugs.has(slug));
---

<Base
  titel="Agressietraining per sector"
  beschrijving="Bureau Weerbaar en Veilig biedt agressietraining in 19 sectoren, van zorg en onderwijs tot retail en openbaar vervoer: per beroepsgroep en in drie niveaus."
>
  <div class="vlak-donker op-donker relative overflow-hidden text-white">
    <div class="motief-chevron absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-10 md:py-14">
      <Breadcrumb pad={[{ naam: 'Home', pad: '/' }, { naam: 'Sectoren' }]} />
      <p class="kicker mt-7">Kies je vertrekpunt</p>
      <h1 class="mt-4 text-3xl font-bold leading-[1.15] md:text-5xl">
        Agressietraining per sector
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-white/85">
        Bureau Weerbaar en Veilig traint teams in 19 sectoren. Elke sector kent zijn
        eigen agressieproblematiek: daarom is elke training per beroepsgroep
        uitgewerkt, in drie niveaus: basis, gevorderd en expert.
      </p>
    </div>
  </div>
  <div class="lijn-merk" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 py-16">
    <ul class="kaartraster grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {gevuld.map((s) => (
        <li class="kaart flex flex-col p-6">
          <h2 class="text-xl font-bold text-marine">
            {/* De pseudo-laag maakt de hele kaart klikbaar, dus ook de regel eronder */}
            <a href={link(`/sectoren/${s.data.slug}/`)} class="after:absolute after:inset-0">
              {s.data.naam}
            </a>
          </h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-grijs">{s.data.samenvatting}</p>
          <p
            class="mt-4 inline-flex items-center gap-2 text-sm font-bold"
            style="color: var(--accent-tekst)"
          >
            {perSector(s.data.slug)} trainingen
            <span class="pijl" aria-hidden="true">→</span>
          </p>
        </li>
      ))}
      {nogTeVullen.map(([, naam]) => (
        <li class="rounded-xl border border-dashed border-lijn bg-vlak-warm p-6">
          <h2 class="text-xl font-bold text-grijs">{naam}</h2>
          <p class="mt-2 text-sm leading-relaxed text-grijs">
            Trainingen voor deze sector volgen binnenkort op deze pagina.
            Bel gerust alvast via
            <a href="tel:+31857600435" class="font-semibold text-blauw hover:underline">085 760 0435</a>.
          </p>
        </li>
      ))}
    </ul>
  </div>
</Base>
