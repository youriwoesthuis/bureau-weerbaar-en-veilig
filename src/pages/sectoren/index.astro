---
import { link } from '../../lib/link';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SectorIcoon from '../../components/SectorIcoon.astro';
import { SECTOR_NAMEN, telwoord } from '../../lib/sectoren';

const sectoren = await getCollection('sectoren');
const trainingen = await getCollection('trainingen');
const beroepsgroepen = await getCollection('beroepsgroepen');

const perSector = (slug: string) => trainingen.filter((t) => t.data.sector === slug).length;
const perGroepen = (slug: string) => beroepsgroepen.filter((b) => b.data.sector === slug).length;

/* Sectoren met een eigen contentbestand eerst, daarna de nog te vullen sectoren als lijst */
const gevuld = sectoren.sort((a, b) => a.data.naam.localeCompare(b.data.naam));
const gevuldeSlugs = new Set(gevuld.map((s) => s.data.slug));
const nogTeVullen = Object.entries(SECTOR_NAMEN).filter(([slug]) => !gevuldeSlugs.has(slug));
---

<Base
  titel="Agressietraining per sector"
  beschrijving="Bureau Weerbaar en Veilig biedt agressietraining in 19 sectoren, van zorg en onderwijs tot retail en openbaar vervoer: per beroepsgroep en in drie niveaus."
>
  {/* ═══ Paginakop ═══ */}
  <section class="paginakop op-donker">
    <div class="wrap">
      <Breadcrumb pad={[{ naam: 'Home', pad: '/' }, { naam: 'Sectoren' }]} />
      <p class="eyebrow">Kies je vertrekpunt</p>
      <h1>Agressietraining per sector</h1>
      <p class="lede">
        Bureau Weerbaar en Veilig traint teams in 19 sectoren. Elke sector kent zijn
        eigen agressieproblematiek: daarom is elke training per beroepsgroep
        uitgewerkt, in drie niveaus — basis, gevorderd en expert.
      </p>

      <div class="kop-stats">
        {[
          [String(gevuld.length), 'Sectoren'],
          [String(beroepsgroepen.length), 'Beroepsgroepen'],
          [String(trainingen.length), 'Trainingen'],
          ['3', 'Niveaus'],
        ].map(([waarde, label]) => (
          <div class="kop-stat">
            <b>{waarde}</b>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══ Het keuzeraster ═══ */}
  <section class="section">
    <div class="wrap">
      {/*
        Zelfde keuze als op de homepage: geen samenvatting in het keuzeraster.
        Elke samenvatting opent met dezelfde vijf woorden, dus negentien kaarten
        naast elkaar leverden negentien identieke openingszinnen op. De naam en
        twee harde getallen verschillen wél per sector en zijn te vergelijken.
      */}
      <ul class="grid grid-3 sectorlijst">
        {gevuld.map((s) => (
          <li class="sectorkaart komt-op">
            <span class="card-icon" aria-hidden="true">
              <SectorIcoon sector={s.data.slug} />
            </span>
            <div class="sectorkaart-tekst">
              <h2>
                <a href={link(`/sectoren/${s.data.slug}/`)} class="vlakdek">{s.data.naam}</a>
              </h2>
              <p>
                {telwoord(perSector(s.data.slug), 'training', 'trainingen')} ·
                {' '}{telwoord(perGroepen(s.data.slug), 'beroepsgroep', 'beroepsgroepen')}
              </p>
            </div>
            <span class="sectorkaart-pijl" aria-hidden="true">→</span>
          </li>
        ))}
        {nogTeVullen.map(([, naam]) => (
          <li class="sectorkaart sectorkaart--leeg">
            <div class="sectorkaart-tekst">
              <h2>{naam}</h2>
              <p>Volgt binnenkort</p>
            </div>
          </li>
        ))}
      </ul>

      {nogTeVullen.length > 0 && (
        <p class="sectorlijst-noot">
          Staat jouw sector er nog niet bij? Bel
          {' '}<a href="tel:+31857600435">085 760 0435</a> — Bureau Weerbaar en Veilig
          traint ook buiten deze lijst.
        </p>
      )}
    </div>
  </section>

  {/* ═══ Afsluiting ═══ */}
  <section class="section section--tight">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <p class="eyebrow">Weet je de sector, maar niet het niveau?</p>
          <h2>Begin bij de trainingsgids</h2>
          <p>
            Vijf vragen die je langs de keuze leiden: welk niveau, wie erbij moet
            zitten, wat je intern regelt en hoe je het na afloop vasthoudt.
          </p>
        </div>
        <div class="hero-actions">
          <a href={link('/trainingsgids/')} class="btn btn-outline">Naar de trainingsgids</a>
          <a href={link('/contact/')} class="btn btn-outline">Overleg even</a>
        </div>
      </div>
    </div>
  </section>
</Base>
