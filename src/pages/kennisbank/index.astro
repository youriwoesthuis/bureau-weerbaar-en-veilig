---
import { link } from '../../lib/link';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const artikelen = (await getCollection('kennisbank')).sort(
  (a, b) => b.data.datum.getTime() - a.data.datum.getTime()
);

/*
  Bewust geen kaartraster op deze pagina. Kleur betekent op deze site het niveau
  van een training; artikelen hebben geen niveau. Ze krijgen daarom een neutrale
  lijn die bij hover het merkverloop wordt, in plaats van 53 kaarten die drie
  kleuren afwisselen zonder dat die iets zeggen.
*/
---

<Base
  titel="Kennisbank over agressie op de werkvloer"
  beschrijving="Praktijkgerichte artikelen van Bureau Weerbaar en Veilig over omgaan met agressie: de-escaleren, grenzen stellen, nazorg, meldbeleid en veilig werken."
>
  <div class="vlak-donker op-donker relative overflow-hidden text-white">
    <div class="motief-chevron absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-10 md:py-14">
      <Breadcrumb pad={[{ naam: 'Home', pad: '/' }, { naam: 'Kennisbank' }]} />
      <p class="kicker mt-7">Uit de praktijk</p>
      <h1 class="mt-4 text-3xl font-bold leading-[1.15] md:text-5xl">Kennisbank</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-white/85">
        Praktijkgerichte artikelen van Bureau Weerbaar en Veilig over omgaan met
        agressie op de werkvloer: de-escaleren, grenzen stellen, nazorg en
        beleid. Voor achtergrond en cijfers over agressie verwijzen we naar
        <a
          href="https://agressievisie.nl"
          class="font-semibold text-white underline decoration-white/40 underline-offset-2 hover:decoration-white"
          >agressievisie.nl</a
        >.
      </p>
    </div>
  </div>
  <div class="lijn-merk" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 py-16">
    {artikelen.length === 0 ? (
      <p class="text-grijs">De artikelen worden op dit moment overgezet en verschijnen hier binnenkort.</p>
    ) : (
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {artikelen.map((a) => (
          <li class="kaart flex flex-col p-6">
            <p class="text-xs font-bold uppercase tracking-wide text-grijs">
              {a.data.onderwerp}
            </p>
            <h2 class="mt-2 text-lg font-bold leading-snug text-marine">
              <a href={link(`/kennisbank/${a.data.slug}/`)} class="after:absolute after:inset-0">
                {a.data.titel}
              </a>
            </h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-grijs">{a.data.samenvatting}</p>
            <p class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-blauw">
              Lees het artikel
              <span class="pijl" aria-hidden="true">→</span>
            </p>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
