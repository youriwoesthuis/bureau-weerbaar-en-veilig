---
import { link } from '../../lib/link';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
  const artikelen = await getCollection('kennisbank');
  return artikelen.map((a) => ({ params: { slug: a.data.slug }, props: { artikel: a } }));
}

const { artikel } = Astro.props;
const d = artikel.data;
const { Content, headings, remarkPluginFrontmatter } = await render(artikel);

/*
  Inhoudsopgave uit de H2's van het artikel. Alleen tonen vanaf drie koppen:
  bij één of twee is het geen wegwijzer maar ruis. Astro geeft elke kop tijdens
  het bouwen een id, dus de ankers werken zonder dat er iets extra's hoeft.
*/
const inhoudsopgave = headings.filter((h) => h.depth === 2);
const toonInhoudsopgave = inhoudsopgave.length >= 3;

/* Berekend tijdens het bouwen door de remark-plugin in astro.config.mjs */
const leestijd: number = remarkPluginFrontmatter.leestijd ?? 1;
const woorden: number = remarkPluginFrontmatter.woorden ?? 0;

const trainingen = await getCollection('trainingen');
const gerelateerd = d.gerelateerde_trainingen
  .map((slug) => trainingen.find((t) => t.data.slug === slug))
  .filter((t) => t !== undefined);

const datumNL = d.datum.toLocaleDateString('nl-NL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const artikelSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.titel,
  description: d.samenvatting,
  datePublished: d.datum.toISOString().slice(0, 10),
  inLanguage: 'nl',
  wordCount: woorden,
  timeRequired: `PT${leestijd}M`,
  about: d.onderwerp,
  author: { '@type': 'Organization', name: 'Bureau Weerbaar en Veilig' },
  publisher: {
    '@type': 'Organization',
    name: 'Bureau Weerbaar en Veilig',
    url: 'https://bureauweerbaarenveilig.nl',
  },
});
---

<Base titel={d.seo_titel ?? d.titel} beschrijving={d.samenvatting} schema={[artikelSchema]}>
  <article>
    <div class="vlak-donker op-donker relative overflow-hidden text-white">
      <div class="motief-chevron absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-4 py-10 md:py-14">
        <Breadcrumb
          pad={[
            { naam: 'Home', pad: '/' },
            { naam: 'Kennisbank', pad: '/kennisbank/' },
            { naam: d.titel },
          ]}
        />
        <div class="mt-7 max-w-3xl">
          <p class="kicker">{d.onderwerp}</p>
          <h1 class="mt-4 text-3xl font-bold leading-[1.15] md:text-5xl">{d.titel}</h1>

          <!-- Leestijd en publicatiedatum, bewust ingetogen -->
          <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-white/70">
            <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0" aria-hidden="true" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M10 2a8 8 0 100 16 8 8 0 000-16zm0 1.6a6.4 6.4 0 110 12.8 6.4 6.4 0 010-12.8zm.8 2.4H9.2v4.4l3.5 2.1.8-1.3-2.7-1.6V6z"
                clip-rule="evenodd"
              />
            </svg>
            <span>{leestijd} {leestijd === 1 ? 'minuut' : 'minuten'} lezen</span>
            <span aria-hidden="true">·</span>
            <time datetime={d.datum.toISOString().slice(0, 10)}>{datumNL}</time>
          </p>

          <p class="mt-5 text-lg leading-relaxed text-white/85">{d.samenvatting}</p>
        </div>
      </div>
    </div>
    <div class="lijn-merk" aria-hidden="true"></div>

    <div class="mx-auto max-w-6xl px-4 py-12">
      <div class="grid gap-12 lg:grid-cols-[1fr_20rem]">
        <section
          class="leestekst min-w-0"
        >
          <Content />
          {d.verdieping_extern && (
            <p class="mt-8 rounded-lg bg-vlak p-4 text-sm">
              Meer achtergrond over dit onderwerp lees je op
              <a href={d.verdieping_extern} class="font-semibold text-blauw hover:underline">
                agressievisie.nl
              </a>.
            </p>
          )}
        </section>

        <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
          {toonInhoudsopgave && (
            <nav
              class="relative overflow-hidden rounded-xl border border-lijn bg-vlak-warm p-6"
              aria-labelledby="inhoud-titel"
            >
              <span class="lijn-merk absolute inset-x-0 top-0" aria-hidden="true"></span>
              <h2 id="inhoud-titel" class="text-sm font-bold uppercase tracking-wide text-grijs">
                In dit artikel
              </h2>
              <ol class="mt-4 space-y-2.5 text-sm">
                {inhoudsopgave.map((h, i) => (
                  <li class="flex gap-3">
                    <span class="font-bold tabular-nums text-oranje-tekst" aria-hidden="true">
                      {i + 1}
                    </span>
                    <a
                      href={`#${h.slug}`}
                      class="font-semibold text-marine hover:text-blauw hover:underline"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}

          {gerelateerd.length > 0 && (
            <div class="rounded-xl border border-lijn p-6">
              <h2 class="text-lg font-bold text-marine">Bijpassende trainingen</h2>
              <ul class="mt-3 space-y-2 text-sm">
                {gerelateerd.map((t) => (
                  <li>
                    <a href={link(`/trainingen/${t.data.slug}/`)} class="font-medium text-blauw hover:underline">
                      {t.data.titel}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </div>
  </article>
</Base>
