---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
  const artikelen = await getCollection('kennisbank');
  return artikelen.map((a) => ({ params: { slug: a.data.slug }, props: { artikel: a } }));
}

const { artikel } = Astro.props;
const d = artikel.data;
const { Content, remarkPluginFrontmatter } = await render(artikel);

/* Berekend tijdens het bouwen door de remark-plugin in astro.config.mjs */
const leestijd: number = remarkPluginFrontmatter.leestijd ?? 1;
const woorden: number = remarkPluginFrontmatter.woorden ?? 0;

const trainingen = await getCollection('trainingen');
const gerelateerd = d.gerelateerde_trainingen
  .map((slug) => trainingen.find((t) => t.data.slug === slug))
  .filter((t) => t !== undefined);

const datumNL = d.datum.toLocaleDateString('nl-NL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const artikelSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.titel,
  description: d.samenvatting,
  datePublished: d.datum.toISOString().slice(0, 10),
  inLanguage: 'nl',
  wordCount: woorden,
  timeRequired: `PT${leestijd}M`,
  about: d.onderwerp,
  author: { '@type': 'Organization', name: 'Bureau Weerbaar en Veilig' },
  publisher: {
    '@type': 'Organization',
    name: 'Bureau Weerbaar en Veilig',
    url: 'https://bureauweerbaarenveilig.nl',
  },
});
---

<Base titel={d.seo_titel ?? d.titel} beschrijving={d.samenvatting} schema={[artikelSchema]}>
  <article>
    <div class="border-b border-lijn bg-vlak">
      <div class="mx-auto max-w-6xl px-4 py-8">
        <Breadcrumb
          pad={[
            { naam: 'Home', pad: '/' },
            { naam: 'Kennisbank', pad: '/kennisbank/' },
            { naam: d.titel },
          ]}
        />
        <div class="mt-6 max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-wide text-oranje">{d.onderwerp}</p>
          <h1 class="mt-2 text-3xl font-bold leading-tight text-marine md:text-4xl">{d.titel}</h1>

          <!-- Leestijd en publicatiedatum, bewust ingetogen -->
          <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-grijs">
            <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0" aria-hidden="true" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M10 2a8 8 0 100 16 8 8 0 000-16zm0 1.6a6.4 6.4 0 110 12.8 6.4 6.4 0 010-12.8zm.8 2.4H9.2v4.4l3.5 2.1.8-1.3-2.7-1.6V6z"
                clip-rule="evenodd"
              />
            </svg>
            <span>{leestijd} {leestijd === 1 ? 'minuut' : 'minuten'} lezen</span>
            <span aria-hidden="true">·</span>
            <time datetime={d.datum.toISOString().slice(0, 10)}>{datumNL}</time>
          </p>

          <p class="mt-4 text-lg leading-relaxed">{d.samenvatting}</p>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-6xl px-4 py-12">
      <div class="grid gap-12 lg:grid-cols-[1fr_20rem]">
        <section
          class="min-w-0 max-w-3xl space-y-4 leading-relaxed [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-marine [&_h3]:mt-6 [&_h3]:text-lg [&_h3]:font-bold [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-1 [&_p]:mb-4"
        >
          <Content />
          {d.verdieping_extern && (
            <p class="mt-8 rounded-lg bg-vlak p-4 text-sm">
              Meer achtergrond over dit onderwerp lees je op
              <a href={d.verdieping_extern} class="font-semibold text-blauw hover:underline">
                agressievisie.nl
              </a>.
            </p>
          )}
        </section>

        <aside class="lg:sticky lg:top-6 lg:self-start">
          {gerelateerd.length > 0 && (
            <div class="rounded-xl border border-lijn p-6">
              <h2 class="text-lg font-bold text-marine">Bijpassende trainingen</h2>
              <ul class="mt-3 space-y-2 text-sm">
                {gerelateerd.map((t) => (
                  <li>
                    <a href={`/trainingen/${t.data.slug}/`} class="font-medium text-blauw hover:underline">
                      {t.data.titel}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </div>
  </article>
</Base>
