---
import { link } from '../../lib/link';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const team = (await getCollection('team')).sort((a, b) => a.data.volgorde - b.data.volgorde);
const trainingen = await getCollection('trainingen');
const beroepsgroepen = await getCollection('beroepsgroepen');
const sectoren = await getCollection('sectoren');

/*
  Eén team, één raster. Er stonden hier eerst kopjes boven — trainers, acteurs,
  achter de schermen — maar dat las als drie losse afdelingen terwijl het één
  club is die samen op een trainingsdag staat. De rol staat op elke kaart, dus
  wie wil weten wie wat doet, ziet dat gewoon.

  Alleen het aantal acteurs wordt nog geteld, want dat getal zegt iets in de
  tekst erboven.
*/
const acteurs = team.filter((lid) => /acteur/i.test(lid.data.rol));

/** Initialen als terugval wanneer er nog geen portretfoto is. */
const initialen = (naam: string) =>
  naam
    .split(/\s+/)
    .filter((w) => w.length > 2 || /^[A-Z]/.test(w))
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();

/*
  Portretfoto's staan in src/images/team/ zodat Astro ze tijdens het bouwen
  omzet naar moderne, lichte beeldformaten met vaste afmetingen. De koppeling
  loopt via de bestandsnaam, die gelijk is aan de bestandsnaam van het teamlid.
*/
const fotos = import.meta.glob<{ default: ImageMetadata }>('../../images/team/*.jpg', {
  eager: true,
});

function fotoVan(id: string) {
  const sleutel = Object.keys(fotos).find((pad) => pad.endsWith(`/${id}.jpg`));
  return sleutel ? fotos[sleutel].default : undefined;
}
---

<Base
  titel="Over Bureau Weerbaar en Veilig"
  beschrijving="Bureau Weerbaar en Veilig is dé specialist in agressietraining, gevestigd in Neede (Gelderland) en onderdeel van de Actinmove-groep. Eén onderwerp, tot in de diepte, per beroepsgroep."
>
  {/* ═══ Paginakop ═══ */}
  <section class="paginakop op-donker">
    <div class="wrap">
      <Breadcrumb pad={[{ naam: 'Home', pad: '/' }, { naam: 'Over ons' }]} />
      <p class="eyebrow">Eén onderwerp, tot in de diepte</p>
      <h1>Over Bureau Weerbaar en Veilig</h1>
      <p class="lede">
        Bureau Weerbaar en Veilig is dé specialist in agressietraining: omgaan
        met agressie, intimidatie en grensoverschrijdend gedrag op de werkvloer.
        Eén onderwerp, tot in de diepte, vertaald naar de praktijk van elke
        beroepsgroep.
      </p>

      <div class="kop-stats">
        <div class="kop-stat"><b>{trainingen.length}</b><span>Trainingen</span></div>
        <div class="kop-stat"><b>{beroepsgroepen.length}</b><span>Beroepsgroepen</span></div>
        <div class="kop-stat"><b>{sectoren.length}</b><span>Sectoren</span></div>
        <div class="kop-stat"><b>{acteurs.length}</b><span>Trainingsacteurs</span></div>
      </div>
    </div>
  </section>

  {/* ═══ Waarom één onderwerp ═══ */}
  <section class="section" aria-labelledby="verhaal">
    <div class="wrap">
      <div class="leestekst">
        <p class="eyebrow">Waar dit merk vandaan komt</p>
        <h2 id="verhaal">Waarom één onderwerp</h2>
        <p>
          Veel trainingsbureaus bieden agressietraining aan als één van vele
          onderwerpen. Bureau Weerbaar en Veilig is bewust opgericht om precies
          het omgekeerde te doen: alléén agressietraining, en dat onderwerp tot in
          de diepte. Elke sector kent zijn eigen situaties — de balie van een
          gemeente is de spreekkamer van een huisarts niet, en dat verschil
          bepaalt de training.
        </p>
        <p>
          Bureau Weerbaar en Veilig is onderdeel van de
          {' '}<a href="https://actinmove.nl">Actinmove</a>-groep. Wie een breder
          communicatie- of trainingsvraagstuk heeft, kan daar terecht; voor kennis
          en achtergrond over agressie op de werkvloer is er
          {' '}<a href="https://agressievisie.nl">agressievisie.nl</a>. Voor
          agressietraining per beroepsgroep ben je hier op de juiste plek.
        </p>
      </div>
    </div>
  </section>

  {/* ═══ Het team ═══ */}
  <section class="section section--soft" aria-labelledby="team-titel" id="team">
    <div class="wrap">
      <p class="eyebrow">Wie er voor de groep staat</p>
      <h2 id="team-titel">Trainers en trainingsacteurs</h2>

      <div class="leestekst">
        <p>
          Iedereen hier geeft alle trainingen, want Bureau Weerbaar en Veilig
          doet maar één ding: agressietraining. Er is dus geen trainer die dit
          er even bij doet naast een cursus timemanagement.
        </p>
        <p>
          Wat het team bijzonder maakt, is de verhouding: naast de trainers werken
          er <strong>{acteurs.length} trainingsacteurs</strong>. Dat is de reden
          dat er geoefend kan worden met situaties die kloppen. Het bekendste
          bezwaar tegen agressietraining is de acteur die harder schreeuwt dan
          welke cliënt ook, waarna iedereen zich opgelaten voelt en niemand iets
          meeneemt. Een acteur die het vak beheerst doet het omgekeerde: die
          speelt precies de patiënt, huurder of klant die jíj beschreef, en kan
          halverwege bijsturen als het te makkelijk of te heftig wordt.
        </p>
      </div>

      {team.length === 0 ? (
        <p class="sectorlijst-noot">De teampagina wordt op dit moment gevuld.</p>
      ) : (
        <ul class="grid grid-4 teamraster">
          {team.map((lid, i) => {
            const foto = fotoVan(lid.id);
            /*
              De bovenste rij staat boven de vouw en bepaalt daar de gemeten
              laadtijd. Die vier laden meteen en met voorrang; de rest blijft
              lui, want dat scheelt bij het openen van de pagina acht
              afbeeldingen die nog niemand ziet.
            */
            const bovenDeVouw = i < 4;
            return (
              <li class="teamkaart">
                {foto ? (
                  <Image
                    src={foto}
                    alt={lid.data.foto?.alt ?? `Portretfoto van ${lid.data.naam}`}
                    width={400}
                    height={500}
                    widths={[300, 400, 600]}
                    sizes="(min-width: 1024px) 260px, (min-width: 640px) 45vw, 90vw"
                    format="webp"
                    quality={88}
                    loading={bovenDeVouw ? 'eager' : 'lazy'}
                    fetchpriority={bovenDeVouw ? 'high' : 'auto'}
                    class="teamfoto"
                  />
                ) : (
                  /*
                    Nog geen portretfoto. Bewust géén merkverloop hier: dat is
                    precies de achtergrond van de échte portretten, waardoor zo'n
                    kaart eruitzag als een foto die niet geladen was. Nu een
                    rustig vlak met initialen, dat zichtbaar iets anders is.
                  */
                  <div class="teamfoto teamfoto--leeg" aria-hidden="true">
                    <span>{initialen(lid.data.naam)}</span>
                  </div>
                )}
                <div class="teamkaart-tekst">
                  <h3>
                    <a href={link(`/team/${lid.id}/`)} class="vlakdek">{lid.data.naam}</a>
                  </h3>
                  <p class="teamkaart-rol">{lid.data.rol}</p>
                  <p class="teamkaart-link">
                    Lees het verhaal <span aria-hidden="true">→</span>
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  </section>

  {/* ═══ Contact en bezoek ═══ */}
  <section class="section section--blauw op-donker" aria-labelledby="bezoek">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">Waar we zitten</p>
          <h2 id="bezoek">Contact en bezoek</h2>
          <p class="lede">
            Bureau Weerbaar en Veilig traint incompany door heel Nederland, en
            ontvangt groepen op de eigen locatie in Neede.
          </p>
          <div class="hero-actions teamknop">
            <a href="tel:+31857600435" class="btn btn-outline">Bel 085 760 0435</a>
            <a href={link('/contact/')} class="btn btn-outline">Naar contact</a>
          </div>
        </div>

        <dl class="gegevens">
          <div>
            <dt>Adres</dt>
            <dd>Russchemorsweg 5-04, 7161 RT Neede</dd>
          </div>
          <div>
            <dt>Telefoon</dt>
            <dd><a href="tel:+31857600435">085 760 0435</a></dd>
          </div>
          <div>
            <dt>E-mail</dt>
            <dd><a href="mailto:info@bureauweerbaarenveilig.nl">info@bureauweerbaarenveilig.nl</a></dd>
          </div>
          <div>
            <dt>Openingstijden</dt>
            <dd>Ma t/m vr 08:30–17:00</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Base>
