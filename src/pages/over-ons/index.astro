---
import { link } from '../../lib/link';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const team = (await getCollection('team')).sort((a, b) => a.data.volgorde - b.data.volgorde);

/*
  Eén team, één raster. Er stonden hier eerst kopjes boven — trainers, acteurs,
  achter de schermen — maar dat las als drie losse afdelingen terwijl het één
  club is die samen op een trainingsdag staat. De rol staat op elke kaart, dus
  wie wil weten wie wat doet, ziet dat gewoon.

  Alleen het aantal acteurs wordt nog geteld, want dat getal zegt iets in de
  tekst erboven.
*/
const acteurs = team.filter((lid) => /acteur/i.test(lid.data.rol));

/** Initialen als terugval wanneer er nog geen portretfoto is. */
const initialen = (naam: string) =>
  naam
    .split(/\s+/)
    .filter((w) => w.length > 2 || /^[A-Z]/.test(w))
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();

/*
  Portretfoto's staan in src/images/team/ zodat Astro ze tijdens het bouwen
  omzet naar moderne, lichte beeldformaten met vaste afmetingen. De koppeling
  loopt via de bestandsnaam, die gelijk is aan de bestandsnaam van het teamlid.
*/
const fotos = import.meta.glob<{ default: ImageMetadata }>('../../images/team/*.jpg', {
  eager: true,
});

function fotoVan(id: string) {
  const sleutel = Object.keys(fotos).find((pad) => pad.endsWith(`/${id}.jpg`));
  return sleutel ? fotos[sleutel].default : undefined;
}
---

<Base
  titel="Over Bureau Weerbaar en Veilig"
  beschrijving="Bureau Weerbaar en Veilig is dé specialist in agressietraining, gevestigd in Neede (Gelderland) en onderdeel van de Actinmove-groep. Eén onderwerp, tot in de diepte, per beroepsgroep."
>
  <div class="vlak-donker op-donker relative overflow-hidden text-white">
    <div class="motief-chevron absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-10 md:py-14">
      <Breadcrumb pad={[{ naam: 'Home', pad: '/' }, { naam: 'Over ons' }]} />
      <h1 class="mt-7 text-3xl font-bold leading-[1.15] md:text-5xl">Over Bureau Weerbaar en Veilig</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-white/85">
        Bureau Weerbaar en Veilig is dé specialist in agressietraining: omgaan
        met agressie, intimidatie en grensoverschrijdend gedrag op de werkvloer.
        Eén onderwerp, tot in de diepte, vertaald naar de praktijk van elke
        beroepsgroep.
      </p>
    </div>
  </div>
  <div class="lijn-merk" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 py-12">
    <section class="max-w-3xl space-y-4 leading-relaxed" aria-labelledby="verhaal">
      <h2 id="verhaal" class="text-2xl font-bold text-marine">Waarom één onderwerp</h2>
      <p>
        Veel trainingsbureaus bieden agressietraining aan als één van vele
        onderwerpen. Bureau Weerbaar en Veilig is bewust opgericht om precies
        het omgekeerde te doen: alléén agressietraining, en dat onderwerp tot in
        de diepte. Elke sector kent zijn eigen situaties: de balie van een
        gemeente is de spreekkamer van een huisarts niet, en dat verschil
        bepaalt de training.
      </p>
      <p>
        Bureau Weerbaar en Veilig is onderdeel van de
        <a href="https://actinmove.nl" class="font-semibold text-blauw hover:underline">Actinmove</a>-groep.
        Wie een breder communicatie- of trainingsvraagstuk heeft, kan daar
        terecht; voor kennis en achtergrond over agressie op de werkvloer is er
        <a href="https://agressievisie.nl" class="font-semibold text-blauw hover:underline">agressievisie.nl</a>.
        Voor agressietraining per beroepsgroep ben je hier op de juiste plek.
      </p>
    </section>

    <section class="mt-14" aria-labelledby="team-titel" id="team">
      <p class="kicker">Wie er voor de groep staat</p>
      <h2 id="team-titel" class="kop-onderstreept mt-4 text-3xl font-bold text-marine">
        Trainers en trainingsacteurs
      </h2>

      <div class="leestekst mt-6">
        <p>
          Iedereen hier geeft alle trainingen, want Bureau Weerbaar en Veilig
          doet maar één ding: agressietraining. Er is dus geen trainer die dit
          er even bij doet naast een cursus timemanagement.
        </p>
        <p>
          Wat het team bijzonder maakt, is de verhouding: naast de trainers werken
          er <strong>{acteurs.length} trainingsacteurs</strong>. Dat is de reden
          dat er geoefend kan worden met situaties die kloppen. Het bekendste
          bezwaar tegen agressietraining is de acteur die harder schreeuwt dan
          welke cliënt ook, waarna iedereen zich opgelaten voelt en niemand iets
          meeneemt. Een acteur die het vak beheerst doet het omgekeerde: die
          speelt precies de patiënt, huurder of klant die jíj beschreef, en kan
          halverwege bijsturen als het te makkelijk of te heftig wordt.
        </p>
      </div>

      {team.length === 0 ? (
        <p class="mt-3 text-grijs">De teampagina wordt op dit moment gevuld.</p>
      ) : (
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {team.map((lid) => {
            const foto = fotoVan(lid.id);
            return (
              <li class="kaart overflow-hidden">
                {foto ? (
                  <Image
                    src={foto}
                    alt={lid.data.foto?.alt ?? `Portretfoto van ${lid.data.naam}`}
                    width={400}
                    height={500}
                    widths={[300, 400, 600]}
                    sizes="(min-width: 1024px) 260px, (min-width: 640px) 45vw, 90vw"
                    format="webp"
                    quality={88}
                    loading="lazy"
                    class="aspect-[4/5] w-full object-cover object-top"
                  />
                ) : (
                  /*
                    Nog geen portretfoto. Bewust géén merkverloop hier: dat is
                    precies de achtergrond van de échte portretten, waardoor zo'n
                    kaart eruitzag als een foto die niet geladen was. Nu een
                    rustig vlak met initialen, dat zichtbaar iets anders is.
                  */
                  <div
                    class="flex aspect-[4/5] w-full items-center justify-center bg-vlak-warm"
                    aria-hidden="true"
                  >
                    <span class="text-3xl font-bold text-lijn">{initialen(lid.data.naam)}</span>
                  </div>
                )}
                <div class="p-5">
                  <h3 class="font-bold text-marine">
                    {/* De pseudo-laag maakt de hele kaart klikbaar */}
                    <a href={link(`/team/${lid.id}/`)} class="after:absolute after:inset-0">
                      {lid.data.naam}
                    </a>
                  </h3>
                  <p class="mt-1 text-sm leading-snug text-grijs">{lid.data.rol}</p>
                  <p class="mt-3 inline-flex items-center gap-1.5 text-sm font-bold text-blauw">
                    Lees het verhaal
                    <span class="pijl" aria-hidden="true">→</span>
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>

    <section class="mt-12 max-w-3xl" aria-labelledby="bezoek">
      <h2 id="bezoek" class="text-2xl font-bold text-marine">Contact en bezoek</h2>
      <dl class="mt-4 space-y-2 text-sm leading-relaxed">
        <div><dt class="inline font-semibold">Adres:</dt> <dd class="inline">Russchemorsweg 5-04, 7161 RT Neede (Gelderland)</dd></div>
        <div><dt class="inline font-semibold">Telefoon:</dt> <dd class="inline"><a href="tel:+31857600435" class="text-blauw hover:underline">085 760 0435</a></dd></div>
        <div><dt class="inline font-semibold">E-mail:</dt> <dd class="inline"><a href="mailto:info@bureauweerbaarenveilig.nl" class="text-blauw hover:underline">info@bureauweerbaarenveilig.nl</a></dd></div>
        <div><dt class="inline font-semibold">Openingstijden:</dt> <dd class="inline">maandag t/m vrijdag 08:30–17:00</dd></div>
      </dl>
    </section>
  </div>
</Base>
