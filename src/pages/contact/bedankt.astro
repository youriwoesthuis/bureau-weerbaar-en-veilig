---
import { link } from '../../lib/link';
import Base from '../../layouts/Base.astro';
---

<Base
  titel="Bedankt voor je bericht"
  beschrijving="Je terugbelverzoek is verstuurd. Bureau Weerbaar en Veilig neemt binnen één werkdag contact met je op."
>
  <div class="mx-auto max-w-3xl px-4 py-20">
    <div class="rounded-xl border border-lijn bg-vlak p-8">
      <p class="kicker">Verstuurd</p>
      <h1 class="mt-3 text-3xl font-bold text-marine">Bedankt voor je bericht</h1>
      <p class="mt-4 text-lg leading-relaxed">
        Je terugbelverzoek is bij Bureau Weerbaar en Veilig aangekomen. Je hoort
        binnen één werkdag van ons: op werkdagen tussen 08:30 en 17:00.
      </p>
      <p class="mt-4 leading-relaxed text-grijs">
        Is het dringend? Bel dan gerust rechtstreeks naar
        <a href="tel:+31857600435" class="font-semibold text-blauw hover:underline">085 760 0435</a>.
      </p>
      <a
        href={link('/')}
        class="knop knop-primair mt-6"
      >
        Terug naar de homepage
      </a>
    </div>
  </div>
</Base>
