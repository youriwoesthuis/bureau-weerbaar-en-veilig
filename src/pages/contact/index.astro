---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

/*
  Het formulier verstuurt via Web3Forms: geen eigen server, geen tracking, geen
  cookies. Vul de access key in .env in als PUBLIC_WEB3FORMS_KEY (zie WERKWIJZE.md,
  stap 7). Zolang die ontbreekt, toont de pagina telefoon en e-mail als route en
  blijft het formulier zichtbaar maar uitgeschakeld: zo staat er nooit een knop
  die stilletjes niets doet.
*/
const KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const actief = KEY.length > 0;
---

<Base
  titel="Contact en terugbelverzoek"
  beschrijving="Neem contact op met Bureau Weerbaar en Veilig: bel 085 760 0435, mail info@bureauweerbaarenveilig.nl of vraag een terugbelverzoek aan. Reactie binnen één werkdag."
>
  {/* ═══ Paginakop ═══ */}
  <section class="paginakop op-donker">
    <div class="wrap">
      <Breadcrumb pad={[{ naam: 'Home', pad: '/' }, { naam: 'Contact' }]} />
      <p class="eyebrow">Reactie binnen één werkdag</p>
      <h1>Contact</h1>
      <p class="lede">
        Bureau Weerbaar en Veilig reageert binnen één werkdag. Bel, mail of laat je
        gegevens achter voor een terugbelverzoek — dan bellen wij.
      </p>

      <div class="kop-stats">
        <div class="kop-stat"><b>085 760 0435</b><span>Ma t/m vr 08:30–17:00</span></div>
        <div class="kop-stat"><b>1 werkdag</b><span>Reactietijd</span></div>
        <div class="kop-stat"><b>Neede</b><span>Gelderland</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="contact-grid">
        {/* ─── Direct contact ─── */}
        <section aria-labelledby="direct-titel">
          <p class="eyebrow">Het snelst</p>
          <h2 id="direct-titel">Direct contact</h2>

          <dl class="contactkaarten">
            <div class="contactkaart">
              <dt>Telefoon (ma t/m vr 08:30–17:00)</dt>
              <dd><a href="tel:+31857600435">085 760 0435</a></dd>
            </div>
            <div class="contactkaart">
              <dt>E-mail</dt>
              <dd>
                <a href="mailto:info@bureauweerbaarenveilig.nl" class="contact-mail">
                  info@bureauweerbaarenveilig.nl
                </a>
              </dd>
            </div>
            <div class="contactkaart">
              <dt>Bezoekadres</dt>
              <dd class="contact-plat">Russchemorsweg 5-04, 7161 RT Neede</dd>
            </div>
          </dl>

          <div class="leestekst contact-uitleg">
            <h3>Wat we als eerste vragen</h3>
            <p>
              Om welke beroepsgroep het gaat, wat er op de werkvloer misgaat en
              met hoeveel mensen je wilt trainen. Daarna volgt een voorstel voor
              het niveau dat past: basis, gevorderd of expert. Elke training
              duurt één dag.
            </p>
          </div>
        </section>

        {/* ─── Terugbelverzoek ─── */}
        <section aria-labelledby="terugbel-titel" class="formulierblok">
          <p class="eyebrow">Liever teruggebeld?</p>
          <h2 id="terugbel-titel">Terugbelverzoek</h2>

          {!actief && (
            <p class="formulier-melding">
              Het formulier wordt op dit moment gekoppeld. Bel of mail zolang gerust
              rechtstreeks: je krijgt binnen één werkdag antwoord.
            </p>
          )}

          <form
            method="POST"
            action={actief ? 'https://api.web3forms.com/submit' : undefined}
            class="formulier"
          >
            {actief && <input type="hidden" name="access_key" value={KEY} />}
            <input type="hidden" name="subject" value="Terugbelverzoek via bureauweerbaarenveilig.nl" />
            <input type="hidden" name="from_name" value="Website Bureau Weerbaar en Veilig" />

            <div class="veld">
              <label for="naam">Naam</label>
              <input id="naam" name="naam" type="text" required autocomplete="name" disabled={!actief} />
            </div>
            <div class="veld">
              <label for="telefoon">Telefoonnummer</label>
              <input id="telefoon" name="telefoon" type="tel" required autocomplete="tel" disabled={!actief} />
            </div>
            <div class="veld">
              <label for="organisatie">
                Organisatie <span class="veld-bij">(optioneel)</span>
              </label>
              <input id="organisatie" name="organisatie" type="text" autocomplete="organization" disabled={!actief} />
            </div>
            <div class="veld">
              <label for="bericht">
                Waar gaat het over? <span class="veld-bij">(optioneel)</span>
              </label>
              <textarea id="bericht" name="bericht" rows="4" disabled={!actief}></textarea>
            </div>

            <!-- Honeypot tegen spam: onzichtbaar voor mensen, ingevuld door bots -->
            <input type="checkbox" name="botcheck" tabindex="-1" class="honeypot" aria-hidden="true" />
            <!-- Waar de bezoeker na verzending naartoe gaat -->
            <input type="hidden" name="redirect" value="https://bureauweerbaarenveilig.nl/contact/bedankt/" />

            <button type="submit" disabled={!actief} class="btn btn-primary formulier-knop">
              Verstuur terugbelverzoek
            </button>
            <p class="formulier-noot">
              Je gegevens worden alleen gebruikt om contact met je op te nemen en nergens
              anders voor. Geen nieuwsbrieven, geen tracking, geen cookies.
            </p>
          </form>
        </section>
      </div>
    </div>
  </section>
</Base>
