---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import NiveauBadge from '../../components/NiveauBadge.astro';
import Terugbelverzoek from '../../components/Terugbelverzoek.astro';
import { SECTOR_NAMEN } from '../../lib/sectoren';
import { trainingTitel } from '../../lib/seo';

export async function getStaticPaths() {
  const trainingen = await getCollection('trainingen');
  return trainingen.map((t) => ({ params: { slug: t.data.slug }, props: { training: t } }));
}

const { training } = Astro.props;
const d = training.data;
const { Content } = await render(training);

const alleTrainingen = await getCollection('trainingen');
const gerelateerd = d.gerelateerd
  .map((slug) => alleTrainingen.find((t) => t.data.slug === slug))
  .filter((t) => t !== undefined);
const andereNiveaus = alleTrainingen.filter(
  (t) => t.data.beroepsgroep === d.beroepsgroep && t.data.slug !== d.slug
);

const niveauLabel = { basis: 'Basis', gevorderd: 'Gevorderd', expert: 'Expert' }[d.niveau];

/* Korte, zoekwoordgerichte title: de volledige H1 past zelden binnen 60 tekens. */
const beroepsgroep = (await getCollection('beroepsgroepen')).find((b) => b.data.slug === d.beroepsgroep);
const seoTitel = d.seo_titel ?? trainingTitel(beroepsgroep?.data.naam ?? d.beroepsgroep, niveauLabel);
const seoBeschrijving = d.seo_beschrijving ?? d.samenvatting;

const aanbieder = {
  '@type': 'Organization',
  name: 'Bureau Weerbaar en Veilig',
  url: 'https://bureauweerbaarenveilig.nl',
};

const courseSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: d.titel,
  description: d.samenvatting,
  provider: aanbieder,
  educationalLevel: niveauLabel,
  timeRequired: d.duur,
  inLanguage: 'nl',
  teaches: d.resultaat,
  audience: { '@type': 'EducationalAudience', educationalRole: 'professional', audienceType: d.doelgroep },
  ...(d.voorwaarde ? { coursePrerequisites: d.voorwaarde } : {}),
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'onsite',
    courseWorkload: d.duur,
    location: {
      '@type': 'Place',
      name: d.locatie_detail ?? 'Incompany of bij Bureau Weerbaar en Veilig',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'NL',
        addressRegion: 'Gelderland',
      },
    },
  },
  ...(d.certificaat
    ? {
        educationalCredentialAwarded: {
          '@type': 'EducationalOccupationalCredential',
          name: d.certificaat.replace(/ na afloop$/, ''),
          credentialCategory: 'certificate',
          recognizedBy: aanbieder,
        },
      }
    : {}),
});

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.veelgestelde_vragen.map((f) => ({
    '@type': 'Question',
    name: f.vraag,
    acceptedAnswer: { '@type': 'Answer', text: f.antwoord },
  })),
});

const praktisch: [string, string | undefined][] = [
  ['Duur', d.duur],
  ['Groepsgrootte', d.groepsgrootte],
  ['Locatie', d.locatie_detail ?? d.locatie],
  ['Certificaat', d.certificaat],
  ['Voorwaarde', d.voorwaarde],
  ['Doelgroep', d.doelgroep],
];
---

<Base titel={seoTitel} beschrijving={seoBeschrijving} schema={[courseSchema, faqSchema]}>
  <article>
    <!-- Kop -->
    <div class="border-b border-lijn bg-vlak">
      <div class="mx-auto max-w-6xl px-4 py-8">
        <Breadcrumb
          pad={[
            { naam: 'Home', pad: '/' },
            { naam: 'Sectoren', pad: '/sectoren/' },
            { naam: SECTOR_NAMEN[d.sector] ?? d.sector, pad: `/sectoren/${d.sector}/` },
            { naam: d.titel },
          ]}
        />
        <div class="mt-6 max-w-3xl">
          <NiveauBadge niveau={d.niveau} />
          <h1 class="mt-3 text-3xl font-bold leading-tight text-marine md:text-4xl">
            {d.titel}
          </h1>
          <!-- GEO-openingsantwoord: direct citeerbaar, vóór alle marketingtaal -->
          <p class="mt-4 text-lg leading-relaxed text-inkt">{d.samenvatting}</p>
        </div>
      </div>
    </div>

    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-12 lg:grid-cols-[1fr_20rem]">
      <div class="min-w-0 space-y-12">
        <!-- Bodytekst uit markdown: waarom + praktijksituaties -->
        <section
          class="prose-koppen space-y-4 leading-relaxed [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-marine [&_h2]:mt-10 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-1"
        >
          <Content />
        </section>

        <!-- Resultaat -->
        <section aria-labelledby="resultaat-titel">
          <h2 id="resultaat-titel" class="text-2xl font-bold text-marine">Wat je leert</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {d.resultaat.map((r) => (
              <li class="flex items-start gap-3 rounded-lg border border-lijn p-4">
                <span aria-hidden="true" class="mt-0.5 font-bold text-oranje">✓</span>
                <span>{r}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Programma -->
        <section aria-labelledby="programma-titel">
          <h2 id="programma-titel" class="text-2xl font-bold text-marine">Programma</h2>
          <ol class="mt-4 space-y-4">
            {d.programma.map((blok, i) => (
              <li class="flex gap-4">
                <span
                  aria-hidden="true"
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-oranje text-sm font-bold text-white"
                >
                  {i + 1}
                </span>
                <div>
                  <h3 class="font-bold text-inkt">{blok.titel}</h3>
                  <p class="mt-1 text-grijs">{blok.inhoud}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- Werkvormen -->
        <section aria-labelledby="werkvormen-titel">
          <h2 id="werkvormen-titel" class="text-2xl font-bold text-marine">Werkvormen</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {d.werkvormen.map((w) => (
              <li class="rounded-full bg-vlak px-4 py-2 text-sm font-medium">{w}</li>
            ))}
          </ul>
        </section>

        <!-- FAQ -->
        <section aria-labelledby="faq-titel">
          <h2 id="faq-titel" class="text-2xl font-bold text-marine">Veelgestelde vragen</h2>
          <div class="mt-4 divide-y divide-lijn border-y border-lijn">
            {d.veelgestelde_vragen.map((f) => (
              <details class="group py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
                  {f.vraag}
                  <span aria-hidden="true" class="text-oranje transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 leading-relaxed text-grijs">{f.antwoord}</p>
              </details>
            ))}
          </div>
        </section>

        <Terugbelverzoek onderwerp={`de ${d.titel.toLowerCase()}`} />
      </div>

      <!-- Zijkolom -->
      <aside class="space-y-6 lg:sticky lg:top-6 lg:self-start">
        <div class="rounded-xl border border-lijn p-6">
          <h2 class="text-lg font-bold text-marine">Praktische informatie</h2>
          <dl class="mt-4 space-y-3 text-sm">
            {praktisch
              .filter(([, waarde]) => waarde)
              .map(([label, waarde]) => (
                <div>
                  <dt class="font-semibold text-grijs">{label}</dt>
                  <dd class="mt-0.5">{waarde}</dd>
                </div>
              ))}
          </dl>
          <a
            href="/contact/"
            class="mt-6 block rounded-md bg-oranje px-5 py-3 text-center text-sm font-bold text-white hover:bg-oranje-donker"
          >
            Plan deze training
          </a>
        </div>

        {andereNiveaus.length > 0 && (
          <div class="rounded-xl border border-lijn p-6">
            <h2 class="text-lg font-bold text-marine">Andere niveaus</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {andereNiveaus.map((t) => (
                <li>
                  <a href={`/trainingen/${t.data.slug}/`} class="font-medium text-blauw hover:underline">
                    {t.data.titel}: {t.data.niveau}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {gerelateerd.length > 0 && (
          <div class="rounded-xl border border-lijn p-6">
            <h2 class="text-lg font-bold text-marine">Gerelateerde trainingen</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {gerelateerd.map((t) => (
                <li>
                  <a href={`/trainingen/${t.data.slug}/`} class="font-medium text-blauw hover:underline">
                    {t.data.titel}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </article>
</Base>
