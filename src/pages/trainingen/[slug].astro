---
import { link } from '../../lib/link';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Terugbelverzoek from '../../components/Terugbelverzoek.astro';
import TrainersBlok from '../../components/TrainersBlok.astro';
import { SECTOR_NAMEN } from '../../lib/sectoren';
import { trainingTitel } from '../../lib/seo';
import { inZin } from '../../lib/naam';
import { situatiesVan } from '../../lib/situaties';
import { voorDeGroep as teamVoorDeGroep } from '../../lib/team';
import { ORGANISATIE, persoonId } from '../../lib/organisatie';

export async function getStaticPaths() {
  const trainingen = await getCollection('trainingen');
  return trainingen.map((t) => ({ params: { slug: t.data.slug }, props: { training: t } }));
}

const { training } = Astro.props;
const d = training.data;
const { Content } = await render(training);

const alleTrainingen = await getCollection('trainingen');
const gerelateerd = d.gerelateerd
  .map((slug) => alleTrainingen.find((t) => t.data.slug === slug))
  .filter((t) => t !== undefined);
const andereNiveaus = alleTrainingen.filter(
  (t) => t.data.beroepsgroep === d.beroepsgroep && t.data.slug !== d.slug
);

const niveauLabel = { basis: 'Basis', gevorderd: 'Gevorderd', expert: 'Expert' }[d.niveau];

/* Korte, zoekwoordgerichte title: de volledige H1 past zelden binnen 60 tekens. */
const beroepsgroep = (await getCollection('beroepsgroepen')).find((b) => b.data.slug === d.beroepsgroep);
const seoTitel = d.seo_titel ?? (await trainingTitel(beroepsgroep?.data.naam ?? d.beroepsgroep, d.niveau));
const seoBeschrijving = d.seo_beschrijving ?? d.samenvatting;

/*
  De organisatie stond hier twee keer volledig uitgeschreven: als provider van
  de training en als uitgever van het certificaat. Voor een consument van
  gestructureerde data waren dat twee naamloze knooppunten die toevallig
  dezelfde naam droegen — en geen van beide was verbonden met de sitebrede
  Organization. Nu verwijzen ze allebei naar dat ene identificatienummer.
*/
const aanbieder = ORGANISATIE;

/*
  Wie de training geeft, ook in de gestructureerde data.

  Een gloednieuw merk heeft geen geschiedenis waar een zoekmachine of
  AI-systeem op kan afgaan. Mensen wel: die hebben een naam, een rol en een
  eigen pagina. Door de trainers hier te noemen wordt de training gekoppeld aan
  personen die elders op de site als Person staan beschreven, in plaats van
  alleen aan een organisatienaam die nergens anders voorkomt.

  Dit voegt niets toe wat de pagina niet al zegt: hetzelfde rijtje staat er
  zichtbaar in het trainersblok. Het is een verwijzing naar de teampagina's, en
  niet de volledige Person-opmaak — die staat daar al, en twee keer opvoeren
  maakt het niet geloofwaardiger.

  Naast het identificatienummer staan hier wel `name` en `url`. Een verwijzing
  die alleen uit een `@id` bestaat is voor een lezer die de teampagina niet
  ophaalt een lege huls; met deze twee velden is de vermelding op zichzelf al
  te begrijpen, terwijl het `@id` de koppeling legt voor wie het netwerk wél
  opbouwt.
*/
const trainers = (await teamVoorDeGroep()).map((lid) => {
  const paginaUrl = new URL(link(`/team/${lid.id}/`), Astro.site).href;
  return {
    '@type': 'Person',
    '@id': persoonId(paginaUrl),
    name: lid.data.naam,
    url: paginaUrl,
  };
});

const courseSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: d.titel,
  description: d.samenvatting,
  provider: aanbieder,
  educationalLevel: niveauLabel,
  timeRequired: d.duur,
  inLanguage: 'nl',
  teaches: d.resultaat,
  audience: { '@type': 'EducationalAudience', educationalRole: 'professional', audienceType: d.doelgroep },
  ...(d.voorwaarde ? { coursePrerequisites: d.voorwaarde } : {}),
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'onsite',
    courseWorkload: d.duur,
    /* instructor hoort volgens schema.org bij de CourseInstance, niet bij de Course. */
    ...(trainers.length ? { instructor: trainers } : {}),
    location: {
      '@type': 'Place',
      name: d.locatie_detail ?? 'Incompany of bij Bureau Weerbaar en Veilig',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'NL',
        addressRegion: 'Gelderland',
      },
    },
  },
  ...(d.certificaat
    ? {
        educationalCredentialAwarded: {
          '@type': 'EducationalOccupationalCredential',
          name: d.certificaat.replace(/ na afloop$/, ''),
          credentialCategory: 'certificate',
          recognizedBy: aanbieder,
        },
      }
    : {}),
});

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.veelgestelde_vragen.map((f) => ({
    '@type': 'Question',
    name: f.vraag,
    acceptedAnswer: { '@type': 'Answer', text: f.antwoord },
  })),
});

const praktisch: [string, string | undefined][] = [
  ['Duur', d.duur],
  ['Groepsgrootte', d.groepsgrootte],
  ['Locatie', d.locatie_detail ?? d.locatie],
  ['Certificaat', d.certificaat],
  ['Voorwaarde', d.voorwaarde],
  ['Doelgroep', d.doelgroep],
];

/*
  De praktijksituaties van deze training, uit de eigen markdown-body. Dit is
  het materiaal waarop een bezoeker beslist — "begrijpen jullie mijn werk
  eigenlijk wel" — en het stond alleen als opsomming halverwege de lopende
  tekst. Hier krijgt het een eigen blok, direct onder het openingsantwoord.
*/
const eigenSituaties = await situatiesVan(d.slug);

/* De vier feiten voor de kop: kort, en dat waarop iemand als eerste scant. */
const kopFeiten = ([
  ['Duur', d.duur],
  ['Groep', d.groepsgrootte.replace(/^maximaal /, 'max. ')],
  ['Locatie', d.locatie === 'incompany' ? 'Incompany of in Neede' : d.locatie],
  ['Afsluiting', d.certificaat ? 'Deelnamecertificaat' : undefined],
] as [string, string | undefined][]).filter((r): r is [string, string] => Boolean(r[1]));
---

<Base titel={seoTitel} beschrijving={seoBeschrijving} schema={[courseSchema, faqSchema]}>
  <article class={`niveau-${d.niveau}`}>
    {/* ═══ Paginakop ═══ */}
    <section class="paginakop op-donker">
      <div class="wrap">
        <Breadcrumb
          pad={[
            { naam: 'Home', pad: '/' },
            { naam: 'Sectoren', pad: '/sectoren/' },
            { naam: SECTOR_NAMEN[d.sector] ?? d.sector, pad: `/sectoren/${d.sector}/` },
            ...(beroepsgroep
              ? [{ naam: beroepsgroep.data.naam, pad: `/sectoren/${d.sector}/${d.beroepsgroep}/` }]
              : []),
            { naam: niveauLabel },
          ]}
        />
        <p class="eyebrow">Niveau {niveauLabel.toLowerCase()}</p>
        <h1>{d.titel}</h1>
        {/* GEO-openingsantwoord: direct citeerbaar, vóór alle verkooptaal */}
        <p class="lede">{d.samenvatting}</p>

        <div class="kop-stats">
          {kopFeiten.map(([label, waarde]) => (
            <div class="kop-stat">
              <b>{waarde}</b>
              <span>{label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ═══ De situaties uit deze training ═══ */}
    {eigenSituaties.length > 0 && (
      <section class="section section--oranje" aria-labelledby="situaties-titel">
        <div class="wrap">
          <p class="eyebrow">Waar het over gaat</p>
          <h2 id="situaties-titel">Dit staat er in deze training, letterlijk</h2>

          {/*
            Elke situatie klapt open naar wat je er die dag mee doet. Dat is de
            brug van herkenning naar aanbod: eerst "dit gebeurt bij ons", dan
            "en hier oefen je dat".
          */}
          <div class="ladder ladderblok">
            {eigenSituaties.map((tekst, i) => (
              <details class="ladder-item">
                <summary class="ladder-kop">
                  <span class="ladder-nr">{String(i + 1).padStart(2, '0')}</span>
                  <span><span class="ladder-titel">{tekst}</span></span>
                  <span class="ladder-teken" aria-hidden="true"></span>
                </summary>
                <div class="ladder-inhoud">
                  <p>
                    Deze situatie komt op de trainingsdag terug in de werkvormen
                    {' '}<strong>{d.werkvormen.slice(0, 2).map(inZin).join(' en ')}</strong>.
                    Je oefent hem met een trainingsacteur, en bespreekt na wat er
                    werkte en wat niet.
                  </p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ═══ Waarom deze training ═══ */}
    <section class="section">
      <div class="wrap">
        <div class="leestekst">
          <Content />
        </div>
      </div>
    </section>

    {/* ═══ Wat je leert — het volle merk-oranje ═══ */}
    <section class="section section--oranje">
      <div class="wrap">
        <p class="eyebrow">Na deze dag</p>
        <h2>Wat je meeneemt</h2>
        <ul class="grid grid-2 leerlijst">
          {d.resultaat.map((r) => (
            <li class="leerpunt komt-op">{r}</li>
          ))}
        </ul>
      </div>
    </section>

    {/* ═══ Programma ═══ */}
    <section class="section">
      <div class="wrap">
        <p class="eyebrow">Het verloop van de dag</p>
        <h2>Programma</h2>
        <ol class="ladder ladderblok">
          {d.programma.map((blok, i) => (
            <li class="ladder-item programma-blok">
              <div class="ladder-kop programma-kop">
                <span class="ladder-nr">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <span class="ladder-titel">{blok.titel}</span>
                  <span class="ladder-bij">{blok.inhoud}</span>
                </span>
              </div>
            </li>
          ))}
        </ol>

        <p class="eyebrow werkvormen-kop">Werkvormen</p>
        <ul class="werkvormen">
          {d.werkvormen.map((w) => <li class="badge">{w}</li>)}
        </ul>

        <div class="praktisch">
          <p class="eyebrow">Praktisch</p>
          <dl class="gegevens">
            {praktisch
              .filter((r): r is [string, string] => Boolean(r[1]))
              .map(([label, waarde]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{waarde}</dd>
                </div>
              ))}
          </dl>
        </div>
      </div>
    </section>

    {/* ═══ Het team — het volle blauw ═══ */}
    <TrainersBlok />

    {/* ═══ Veelgestelde vragen ═══ */}
    <section class="section section--soft">
      <div class="wrap">
        <p class="eyebrow">Voor je boekt</p>
        <h2>Veelgestelde vragen</h2>
        <div class="ladder ladderblok">
          {d.veelgestelde_vragen.map((f) => (
            <details class="ladder-item">
              <summary class="ladder-kop">
                <span><span class="ladder-titel">{f.vraag}</span></span>
                <span class="ladder-teken" aria-hidden="true"></span>
              </summary>
              <div class="ladder-inhoud">
                <p>{f.antwoord}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ═══ De andere niveaus ═══ */}
    {andereNiveaus.length > 0 && (
      <section class="section section--tight">
        <div class="wrap">
          <p class="eyebrow">Andere niveaus voor deze beroepsgroep</p>
          <div class="grid grid-2 sectorraster">
            {andereNiveaus.map((t) => (
              <article class={`card niveau-${t.data.niveau}`}>
                <span class="badge">
                  {{ basis: 'Basis', gevorderd: 'Gevorderd', expert: 'Expert' }[t.data.niveau]}
                </span>
                <h3 class="niveau-kop">
                  <a href={link(`/trainingen/${t.data.slug}/`)} class="vlakdek">{t.data.titel}</a>
                </h3>
                <p>{t.data.doelgroep}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ═══ Gerelateerde beroepsgroepen ═══ */}
    {gerelateerd.length > 0 && (
      <section class="section section--tight">
        <div class="wrap">
          <p class="eyebrow">Ook getraind door Bureau Weerbaar en Veilig</p>
          <div class="grid grid-3 sectorraster">
            {gerelateerd.map((t) => (
              <article class="card">
                <h3>
                  <a href={link(`/trainingen/${t.data.slug}/`)} class="vlakdek">{t.data.titel}</a>
                </h3>
                <p>{SECTOR_NAMEN[t.data.sector] ?? t.data.sector}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ═══ Afsluiting ═══ */}
    <section class="section section--tight">
      <div class="wrap">
        <Terugbelverzoek onderwerp={`de ${inZin(d.titel)}`} />
      </div>
    </section>
  </article>
</Base>
