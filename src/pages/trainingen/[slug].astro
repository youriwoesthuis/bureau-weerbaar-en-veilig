---
import { link } from '../../lib/link';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import NiveauBadge from '../../components/NiveauBadge.astro';
import Terugbelverzoek from '../../components/Terugbelverzoek.astro';
import TrainersBlok from '../../components/TrainersBlok.astro';
import { SECTOR_NAMEN } from '../../lib/sectoren';
import { trainingTitel } from '../../lib/seo';
import { voorDeGroep as teamVoorDeGroep } from '../../lib/team';
import { ORGANISATIE, persoonId } from '../../lib/organisatie';

export async function getStaticPaths() {
  const trainingen = await getCollection('trainingen');
  return trainingen.map((t) => ({ params: { slug: t.data.slug }, props: { training: t } }));
}

const { training } = Astro.props;
const d = training.data;
const { Content } = await render(training);

const alleTrainingen = await getCollection('trainingen');
const gerelateerd = d.gerelateerd
  .map((slug) => alleTrainingen.find((t) => t.data.slug === slug))
  .filter((t) => t !== undefined);
const andereNiveaus = alleTrainingen.filter(
  (t) => t.data.beroepsgroep === d.beroepsgroep && t.data.slug !== d.slug
);

const niveauLabel = { basis: 'Basis', gevorderd: 'Gevorderd', expert: 'Expert' }[d.niveau];

/* Korte, zoekwoordgerichte title: de volledige H1 past zelden binnen 60 tekens. */
const beroepsgroep = (await getCollection('beroepsgroepen')).find((b) => b.data.slug === d.beroepsgroep);
const seoTitel = d.seo_titel ?? trainingTitel(beroepsgroep?.data.naam ?? d.beroepsgroep, d.niveau);
const seoBeschrijving = d.seo_beschrijving ?? d.samenvatting;

/*
  De organisatie stond hier twee keer volledig uitgeschreven: als provider van
  de training en als uitgever van het certificaat. Voor een consument van
  gestructureerde data waren dat twee naamloze knooppunten die toevallig
  dezelfde naam droegen — en geen van beide was verbonden met de sitebrede
  Organization. Nu verwijzen ze allebei naar dat ene identificatienummer.
*/
const aanbieder = ORGANISATIE;

/*
  Wie de training geeft, ook in de gestructureerde data.

  Een gloednieuw merk heeft geen geschiedenis waar een zoekmachine of
  AI-systeem op kan afgaan. Mensen wel: die hebben een naam, een rol en een
  eigen pagina. Door de trainers hier te noemen wordt de training gekoppeld aan
  personen die elders op de site als Person staan beschreven, in plaats van
  alleen aan een organisatienaam die nergens anders voorkomt.

  Dit voegt niets toe wat de pagina niet al zegt: hetzelfde rijtje staat er
  zichtbaar in het trainersblok. Het is een verwijzing naar de teampagina's, en
  niet de volledige Person-opmaak — die staat daar al, en twee keer opvoeren
  maakt het niet geloofwaardiger.

  Naast het identificatienummer staan hier wel `name` en `url`. Een verwijzing
  die alleen uit een `@id` bestaat is voor een lezer die de teampagina niet
  ophaalt een lege huls; met deze twee velden is de vermelding op zichzelf al
  te begrijpen, terwijl het `@id` de koppeling legt voor wie het netwerk wél
  opbouwt.
*/
const trainers = (await teamVoorDeGroep()).map((lid) => {
  const paginaUrl = new URL(link(`/team/${lid.id}/`), Astro.site).href;
  return {
    '@type': 'Person',
    '@id': persoonId(paginaUrl),
    name: lid.data.naam,
    url: paginaUrl,
  };
});

const courseSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: d.titel,
  description: d.samenvatting,
  provider: aanbieder,
  educationalLevel: niveauLabel,
  timeRequired: d.duur,
  inLanguage: 'nl',
  teaches: d.resultaat,
  audience: { '@type': 'EducationalAudience', educationalRole: 'professional', audienceType: d.doelgroep },
  ...(d.voorwaarde ? { coursePrerequisites: d.voorwaarde } : {}),
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'onsite',
    courseWorkload: d.duur,
    /* instructor hoort volgens schema.org bij de CourseInstance, niet bij de Course. */
    ...(trainers.length ? { instructor: trainers } : {}),
    location: {
      '@type': 'Place',
      name: d.locatie_detail ?? 'Incompany of bij Bureau Weerbaar en Veilig',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'NL',
        addressRegion: 'Gelderland',
      },
    },
  },
  ...(d.certificaat
    ? {
        educationalCredentialAwarded: {
          '@type': 'EducationalOccupationalCredential',
          name: d.certificaat.replace(/ na afloop$/, ''),
          credentialCategory: 'certificate',
          recognizedBy: aanbieder,
        },
      }
    : {}),
});

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.veelgestelde_vragen.map((f) => ({
    '@type': 'Question',
    name: f.vraag,
    acceptedAnswer: { '@type': 'Answer', text: f.antwoord },
  })),
});

const praktisch: [string, string | undefined][] = [
  ['Duur', d.duur],
  ['Groepsgrootte', d.groepsgrootte],
  ['Locatie', d.locatie_detail ?? d.locatie],
  ['Certificaat', d.certificaat],
  ['Voorwaarde', d.voorwaarde],
  ['Doelgroep', d.doelgroep],
];
---

<Base titel={seoTitel} beschrijving={seoBeschrijving} schema={[courseSchema, faqSchema]}>
  <article class={`niveau-${d.niveau}`}>
    <!-- Kop -->
    <div class="vlak-donker op-donker relative overflow-hidden text-white">
      <div class="motief-chevron absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-4 py-10 md:py-14">
        {/*
          De beroepsgroep hoort in dit pad. Hij ontbrak, en daarmee sprong het
          kruimelpad van de sector rechtstreeks naar de training — een niveau
          dat in de sitestructuur wél bestaat.

          Dat had twee gevolgen. De BreadcrumbList in de gestructureerde data
          beschreef een andere hiërarchie dan de site heeft. En de
          beroepsgroeppagina's, juist de pagina's die op "agressietraining
          {beroepsgroep}" moeten landen, kregen geen enkele link vanaf de
          honderdtweeëndertig trainingen die eronder vallen: alleen vanaf de
          sectorpagina en het trainingsoverzicht, twee stuks.

          Het niveau sluit het pad af in plaats van de volledige titel. Die
          titel herhaalt de beroepsgroep die er nu vlak voor staat, en liep
          over meerdere regels.
        */}
        <Breadcrumb
          pad={[
            { naam: 'Home', pad: '/' },
            { naam: 'Sectoren', pad: '/sectoren/' },
            { naam: SECTOR_NAMEN[d.sector] ?? d.sector, pad: `/sectoren/${d.sector}/` },
            ...(beroepsgroep
              ? [
                  {
                    naam: beroepsgroep.data.naam,
                    pad: `/sectoren/${d.sector}/${d.beroepsgroep}/`,
                  },
                ]
              : []),
            { naam: niveauLabel },
          ]}
        />
        <div class="mt-7 max-w-3xl">
          <span
            class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3 py-1 text-xs font-bold uppercase tracking-wide"
          >
            <span class="h-1.5 w-1.5 rounded-full" style="background: var(--accent)" aria-hidden="true"></span>
            Niveau: {d.niveau}
          </span>
          <h1 class="mt-4 text-3xl font-bold leading-[1.15] md:text-5xl">
            {d.titel}
          </h1>
          <!-- GEO-openingsantwoord: direct citeerbaar, vóór alle marketingtaal -->
          <p class="mt-5 text-lg leading-relaxed text-white/85">{d.samenvatting}</p>
        </div>

        {/*
          De vier feiten waarop een opdrachtgever meteen scant: hoe lang, met
          hoeveel mensen, waar, en krijgen ze iets mee.

          Ze stonden alleen in de zijkolom "Praktische informatie". Op een breed
          scherm valt die rechts naast de tekst, maar op een telefoon zakt hij
          onder de hele pagina — dus precies daar waar de meeste bezoekers hem
          nooit zien. Hier staan ze boven de vouw, in dezelfde volgorde als de
          vragen die mensen stellen.
        */}
        <ul class="mt-9 flex flex-wrap gap-x-8 gap-y-4 border-t border-white/15 pt-7">
          {[
            ['Duur', d.duur],
            ['Groep', d.groepsgrootte.replace(/^maximaal /, 'max. ')],
            ['Locatie', d.locatie === 'incompany' ? 'Incompany of in Neede' : d.locatie],
            ...(d.certificaat ? [['Afsluiting', 'Deelnamecertificaat']] : []),
          ].map(([label, waarde]) => (
            <li>
              <span class="block text-xs font-bold uppercase tracking-wide text-white/55">
                {label}
              </span>
              <span class="mt-1 block font-semibold">{waarde}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="lijn-merk" aria-hidden="true"></div>

    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-12 lg:grid-cols-[1fr_20rem]">
      <div class="min-w-0 space-y-12">
        <!-- Bodytekst uit markdown: waarom + praktijksituaties -->
        <section
          class="leestekst"
        >
          <Content />
        </section>

        <!-- Resultaat -->
        <section aria-labelledby="resultaat-titel">
          <h2 id="resultaat-titel" class="kop-onderstreept text-2xl font-bold text-marine">
            Wat je leert
          </h2>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {d.resultaat.map((r) => (
              <li
                class="flex items-start gap-3 rounded-lg border border-lijn p-4 transition-colors"
                style="background: var(--accent-vlak)"
              >
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  class="mt-0.5 h-5 w-5 flex-none"
                  style="color: var(--accent)"
                  fill="currentColor"
                >
                  <path
                    d="M10 1.7a8.3 8.3 0 1 0 0 16.6 8.3 8.3 0 0 0 0-16.6Zm4.1 6.2-5 5a.9.9 0 0 1-1.3 0L5.9 11a.9.9 0 1 1 1.3-1.3l1.3 1.4 4.3-4.4a.9.9 0 1 1 1.3 1.3Z"
                  />
                </svg>
                <span>{r}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Programma -->
        <section aria-labelledby="programma-titel">
          <h2 id="programma-titel" class="kop-onderstreept text-2xl font-bold text-marine">
            Programma
          </h2>
          <ol class="tijdlijn mt-6">
            {d.programma.map((blok, i) => (
              <li class="tijdlijn-stap">
                <span aria-hidden="true" class="tijdlijn-bol">{i + 1}</span>
                <div class="pb-7">
                  <h3 class="font-bold text-marine">{blok.titel}</h3>
                  <p class="mt-1.5 leading-relaxed text-grijs">{blok.inhoud}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- Werkvormen -->
        <section aria-labelledby="werkvormen-titel">
          <h2 id="werkvormen-titel" class="kop-onderstreept text-2xl font-bold text-marine">
            Werkvormen
          </h2>
          <ul class="mt-6 flex flex-wrap gap-2">
            {d.werkvormen.map((w) => (
              <li
                class="rounded-full border px-4 py-2 text-sm font-semibold"
                style="background: var(--accent-vlak); border-color: color-mix(in srgb, var(--accent) 28%, transparent); color: var(--accent-tekst)"
              >
                {w}
              </li>
            ))}
          </ul>
        </section>

        {/*
          De vragen op een eigen vlak. Deze pagina liep hiervoor als één wit
          blok van ruim vierduizend pixels door: verhaal, leeruitkomsten,
          programma, werkvormen en vragen zonder één zichtbare overgang. Dan
          voelt het lang, ook als elk onderdeel op zichzelf kort is.

          Dit is het laatste blok voordat de bezoeker een keuze maakt, en het
          eigen vlak markeert dat.
        */}
        <section
          class="gloed-warm -mx-4 rounded-2xl px-5 py-8 sm:mx-0 sm:px-8"
          aria-labelledby="faq-titel"
        >
          <h2 id="faq-titel" class="kop-onderstreept text-2xl font-bold text-marine">
            Veelgestelde vragen
          </h2>
          <div class="mt-6 space-y-3">
            {d.veelgestelde_vragen.map((f) => (
              <details class="uitklap rounded-lg border border-lijn bg-white px-5 py-4 transition-shadow open:shadow-md">
                <summary class="font-semibold text-marine">
                  {f.vraag}
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    class="chevron mt-1 h-5 w-5"
                    style="color: var(--accent)"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m5 7.5 5 5 5-5" />
                  </svg>
                </summary>
                <p class="mt-3 leading-relaxed text-grijs">{f.antwoord}</p>
              </details>
            ))}
          </div>
        </section>

        <TrainersBlok />

        <Terugbelverzoek onderwerp={`de ${d.titel.toLowerCase()}`} />
      </div>

      <!-- Zijkolom -->
      <aside class="space-y-5 lg:sticky lg:top-6 lg:self-start">
        <div class="relative overflow-hidden rounded-xl border border-lijn bg-white shadow-[var(--shadow-kaart)]">
          <span class="lijn-merk block" aria-hidden="true"></span>
          <div class="p-6">
            <h2 class="text-lg font-bold text-marine">Praktische informatie</h2>
            <dl class="mt-4 divide-y divide-lijn text-sm">
              {/*
                Het niveau stond hier niet bij, terwijl het het eerste is wat
                een opdrachtgever wil verifiëren. Het verwijst door naar het
                overzicht van dat niveau over alle sectoren heen: die drie
                pagina's kregen anders nauwelijks links, en wie twijfelt of dit
                het juiste niveau is, is daar precies op zijn plek.
              */}
              <div class="py-2.5 first:pt-0 last:pb-0">
                <dt class="text-xs font-bold uppercase tracking-wide text-grijs">Niveau</dt>
                <dd class="mt-1 font-medium text-inkt">
                  <a href={link(`/niveaus/${d.niveau}/`)} class="text-blauw hover:underline">
                    {niveauLabel}
                  </a>
                </dd>
              </div>
              {praktisch
                .filter(([, waarde]) => waarde)
                .map(([label, waarde]) => (
                  <div class="py-2.5 first:pt-0 last:pb-0">
                    <dt class="text-xs font-bold uppercase tracking-wide text-grijs">{label}</dt>
                    <dd class="mt-1 font-medium text-inkt">{waarde}</dd>
                  </div>
                ))}
            </dl>
            <a href={link('/contact/')} class="knop knop-primair mt-6 w-full text-sm">
              Plan deze training
              <span class="pijl" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        {andereNiveaus.length > 0 && (
          <div class="rounded-xl border border-lijn bg-vlak-warm p-6">
            <h2 class="text-lg font-bold text-marine">Andere niveaus</h2>
            <ul class="mt-4 space-y-2.5 text-sm">
              {andereNiveaus.map((t) => (
                <li class={`niveau-${t.data.niveau} flex items-start gap-2.5`}>
                  <span
                    class="mt-1.5 h-2 w-2 flex-none rounded-full"
                    style="background: var(--accent)"
                    aria-hidden="true"></span>
                  <a
                    href={link(`/trainingen/${t.data.slug}/`)}
                    class="font-semibold text-blauw hover:underline"
                  >
                    {t.data.titel}: {t.data.niveau}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {gerelateerd.length > 0 && (
          <div class="rounded-xl border border-lijn p-6">
            <h2 class="text-lg font-bold text-marine">Gerelateerde trainingen</h2>
            <ul class="mt-4 space-y-2.5 text-sm">
              {gerelateerd.map((t) => (
                <li>
                  <a
                    href={link(`/trainingen/${t.data.slug}/`)}
                    class="group inline-flex items-start gap-1.5 font-semibold text-blauw hover:underline"
                  >
                    {t.data.titel}
                    <span
                      class="pijl mt-0.5 transition-transform group-hover:translate-x-1"
                      aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </article>
</Base>
