---
import { link } from '../../lib/link';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SECTOR_NAMEN, NIVEAU_LABELS, telwoord } from '../../lib/sectoren';

/*
  Het volledige aanbod, gegroepeerd per beroepsgroep.

  Eerder stonden hier 132 losse kaarten. Dat leverde drie problemen op: de naam
  van de beroepsgroep stond er drie keer (één keer per niveau), de kaarten
  droegen nauwelijks informatie, en 132 vrijwel identieke blokjes onder elkaar
  zijn niet te overzien.

  Nu is elke beroepsgroep één rij met de drie niveaus naast elkaar. Dat is ook
  precies de vraag van een inkoper — welk niveau heeft mijn team nodig — en die
  vraag beantwoordt een rij die je van links naar rechts leest.

  Het filter werkt volledig met CSS, zonder JavaScript: de projectbrief eist dat
  de volledige inhoud ook zonder scripts zichtbaar is. Filteren op sector
  verbergt hele rijen, filteren op niveau verbergt tegels binnen elke rij.
*/
const alleTrainingen = await getCollection('trainingen');
const beroepsgroepen = await getCollection('beroepsgroepen');

const niveaus = ['basis', 'gevorderd', 'expert'] as const;
const niveauIndex = (n: string) => niveaus.indexOf(n as (typeof niveaus)[number]);

/* Eén rij per beroepsgroep, met de niveaus in volgorde van opbouw */
const groepen = beroepsgroepen
  .map((b) => ({
    slug: b.data.slug,
    naam: b.data.naam,
    sector: b.data.sector,
    trainingen: alleTrainingen
      .filter((t) => t.data.beroepsgroep === b.data.slug)
      .sort((a, c) => niveauIndex(a.data.niveau) - niveauIndex(c.data.niveau)),
  }))
  .filter((g) => g.trainingen.length > 0)
  .sort((a, b) => a.naam.localeCompare(b.naam));

const sectorSlugs = [...new Set(groepen.map((g) => g.sector))].sort((a, b) =>
  (SECTOR_NAMEN[a] ?? a).localeCompare(SECTOR_NAMEN[b] ?? b)
);

const perNiveau = (n: string) => alleTrainingen.filter((t) => t.data.niveau === n).length;
const groepenPerSector = (s: string) => groepen.filter((g) => g.sector === s).length;

const filterCss = [
  ...niveaus.map(
    (n) =>
      `.filterblok:has(#niveau-${n}:checked) .tegel:not([data-niveau="${n}"]) { display: none; }`
  ),
  ...sectorSlugs.map(
    (s) => `.filterblok:has(#sector-${s}:checked) .groep:not([data-sector="${s}"]) { display: none; }`
  ),
].join('\n  ');

/*
  De naam van de gekozen sector in de dichtgeklapte knop. Zonder dit weet je na
  het sluiten niet meer waarop je filtert. De radioknop blijft de bron van
  waarheid; dit is alleen de zichtbare weerslag daarvan, en dus aria-hidden.
*/
const sectorkeuzeCss = [
  `.sectorkeuze::after { content: 'alle'; }`,
  ...sectorSlugs.map(
    (s) =>
      `.filterblok:has(#sector-${s}:checked) .sectorkeuze::after { content: '${(
        SECTOR_NAMEN[s] ?? s
      ).replace(/'/g, "\\'")}'; }`
  ),
].join('\n  ');
---

<Base
  titel="Alle agressietrainingen"
  beschrijving="Alle agressietrainingen van Bureau Weerbaar en Veilig: 132 trainingen voor 44 beroepsgroepen in 19 sectoren, elk in drie niveaus. Filter op sector en niveau."
>
  <div class="vlak-donker op-donker relative overflow-hidden text-white">
    <div class="motief-chevron absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-10 md:py-14">
      <Breadcrumb pad={[{ naam: 'Home', pad: '/' }, { naam: 'Trainingen' }]} />
      <p class="kicker mt-7">Het volledige aanbod</p>
      <h1 class="mt-4 text-3xl font-bold leading-[1.15] md:text-5xl">Alle agressietrainingen</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-white/85">
        Bureau Weerbaar en Veilig geeft {alleTrainingen.length} agressietrainingen
        voor {groepen.length} beroepsgroepen in {sectorSlugs.length} sectoren, elk
        in drie niveaus. Per beroepsgroep zie je de drie niveaus naast elkaar,
        zodat je in één oogopslag kunt vergelijken wat ze van elkaar onderscheidt.
      </p>
    </div>
  </div>
  <div class="lijn-merk" aria-hidden="true"></div>

  <div class="filterblok">
    <!--
      De filterbalk blijft in beeld tijdens het scrollen: met 44 rijen ben je
      anders je keuzemogelijkheid kwijt zodra je begint te lezen.
    -->
    <div class="filterbalk">
      <div class="mx-auto max-w-6xl px-4 py-4">
        <form aria-label="Trainingen filteren">
          <p class="sr-only">
            Kies een niveau of sector om de lijst te beperken. De volledige lijst
            blijft beschikbaar via de knop Alle niveaus of Alle sectoren.
          </p>

          {/*
            Het label staat op dezelfde regel als de knoppen. Stond het erboven,
            dan las het blok als twee losse stapels grijze blokjes; zo leest het
            als één zin: "Niveau: alle, basis, gevorderd, expert".
          */}
          <div class="filterrij" role="group" aria-labelledby="label-niveau">
              <span class="filterlabel" id="label-niveau">Niveau</span>
            <div class="pillen">
              <label class="pil">
                <input type="radio" name="niveau" id="niveau-alle" checked />
                <span>Alle <span class="pil-aantal">{alleTrainingen.length}</span></span>
              </label>
              {niveaus.map((n) => (
                <label class={`pil niveau-${n}`}>
                  <input type="radio" name="niveau" id={`niveau-${n}`} />
                  <span>{NIVEAU_LABELS[n]} <span class="pil-aantal">{perNiveau(n)}</span></span>
                </label>
              ))}
            </div>
          </div>

          {/*
            De negentien sectoren staan ingeklapt. Uitgeklapt vulden ze drie
            regels, en dan staat er meer keuze op het scherm dan iemand in één
            blik kan overzien. Nu is de ruststand één regel, met de gekozen
            sector in de knop zelf, en zie je de lijst pas als je hem opent.

            Werkt zonder JavaScript: details/summary is gewoon HTML, en de
            radioknoppen erin blijven bestaan ook als het blok dicht is — dus het
            filter blijft werken en een crawler ziet alles.
          */}
          <details class="filterrij sectorfilter">
            <summary>
              <span class="filterlabel">Sector</span>
              <span class="sectorkeuze" aria-hidden="true"></span>
              <svg viewBox="0 0 20 20" class="chevron" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m5 7.5 5 5 5-5" />
              </svg>
            </summary>

            <div class="pillen" role="group" aria-label="Sector">
              <label class="pil">
                <input type="radio" name="sector" id="sector-alle" checked />
                {/* Het getal telt beroepsgroepen, net als bij de sectoren zelf */}
                <span>Alle sectoren <span class="pil-aantal">{groepen.length}</span></span>
              </label>
              {sectorSlugs.map((s) => (
                <label class="pil">
                  <input type="radio" name="sector" id={`sector-${s}`} />
                  <span>
                    {SECTOR_NAMEN[s] ?? s} <span class="pil-aantal">{groepenPerSector(s)}</span>
                  </span>
                </label>
              ))}
            </div>
          </details>
        </form>
      </div>
    </div>

    <div class="mx-auto max-w-6xl px-4 py-10">
      <ul class="space-y-4">
        {groepen.map((g) => (
          <li class="groep" data-sector={g.sector}>
            <div class="groep-kop">
              <h2 class="text-lg font-bold leading-snug text-marine">
                <a
                  href={link(`/sectoren/${g.sector}/${g.slug}/`)}
                  class="hover:text-blauw hover:underline"
                >
                  {g.naam}
                </a>
              </h2>
              <p class="mt-1 text-sm text-grijs">
                {SECTOR_NAMEN[g.sector] ?? g.sector} ·
                {' '}{telwoord(g.trainingen.length, 'niveau', 'niveaus')}
              </p>
            </div>

            <ul class="tegels">
              {g.trainingen.map((t) => (
                <li class={`tegel niveau-${t.data.niveau}`} data-niveau={t.data.niveau}>
                  <p class="tegel-niveau">{NIVEAU_LABELS[t.data.niveau]}</p>
                  <p class="tegel-belofte">{t.data.resultaat[0]}</p>
                  {/*
                    De zichtbare tekst staat vóórop en de volledige titel volgt
                    als verborgen aanvulling. Eerder stond hier een aria-label
                    met alleen de titel, en dan bevat de toegankelijke naam de
                    zichtbare woorden niet meer — dat is een schending van WCAG
                    2.5.3 (Label in Name). Wie met spraakbediening werkt zegt
                    "klik Bekijk training", en dat moet die link dan ook heten.
                  */}
                  <a href={link(`/trainingen/${t.data.slug}/`)} class="tegel-link">
                    Bekijk training
                    <span class="sr-only">: {t.data.titel}</span>
                    <span class="pijl" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>

<style is:inline set:html={`
  /* ---------- Filterbalk ---------- */
  /*
    Egale achtergrond, geen backdrop-filter. Met een blur hier én op de
    plakkende kop erboven ontstonden er twee compositielagen over elkaar, en
    liet Chrome het vlak ertussen ongetekend: een grote witte vlek tijdens het
    scrollen. Een dekkende balk leest bovendien rustiger dan een doorschijnende.
  */
  .filterbalk {
    position: sticky;
    top: var(--kophoogte, 5rem);
    z-index: 30;
    background: #fff;
    border-bottom: 1px solid var(--color-lijn);
    box-shadow: 0 1px 0 rgb(33 46 86 / .04), 0 6px 16px -12px rgb(33 46 86 / .25);
  }
  /* Label en knoppen op één regel, met het label op een vaste breedte zodat
     "Niveau" en "Sector" onder elkaar uitlijnen. */
  .filterrij {
    display: flex;
    align-items: baseline;
    gap: .85rem;
    padding: .3rem 0;
  }
  .filterrij + .filterrij { border-top: 1px solid var(--color-lijn); margin-top: .3rem; padding-top: .6rem; }

  /* ---------- De ingeklapte sectorkeuze ---------- */
  .sectorfilter { display: block; }
  .sectorfilter summary {
    display: flex;
    align-items: center;
    gap: .85rem;
    list-style: none;
    cursor: pointer;
    padding: .3rem 0;
    border-radius: .375rem;
  }
  .sectorfilter summary::-webkit-details-marker { display: none; }
  .sectorfilter summary:hover .sectorkeuze { background: var(--color-vlak); color: var(--color-marine); }
  .sectorfilter summary:focus-visible {
    outline: 3px solid var(--color-blauw);
    outline-offset: 2px;
  }
  .sectorkeuze {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: .3rem .7rem;
    border-radius: 9999px;
    background: var(--color-marine);
    color: #fff;
    font-size: .8125rem;
    font-weight: 600;
    transition: background-color 140ms ease, color 140ms ease;
  }
  .sectorfilter .chevron {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--color-grijs);
    transition: transform 180ms ease;
  }
  .sectorfilter[open] .chevron { transform: rotate(180deg); }
  .sectorfilter .pillen { padding: .5rem 0 .2rem; }
  @media (min-width: 601px) {
    .sectorfilter .pillen { padding-left: 4.85rem; }
  }
  .filterlabel {
    flex: none;
    width: 4rem;
    font-size: .75rem;
    font-weight: 700;
    color: var(--color-grijs);
  }
  @media (max-width: 600px) {
    .filterrij { flex-direction: column; align-items: stretch; gap: .4rem; }
    .filterlabel { width: auto; }
  }
  .pillen {
    display: flex;
    flex-wrap: wrap;
    gap: .15rem .35rem;
  }

  /*
    Rustige knoppen: in rust alleen tekst, geen vlak. Met drieëntwintig
    gevulde blokjes naast elkaar vroeg alles tegelijk om aandacht en viel er
    niets meer op. Nu krijgt alleen de gekozen knop een vlak, dus er is altijd
    precies één ding dat opvalt — en dat is waar je staat.
  */
  .pil input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .pil > span {
    display: inline-flex;
    align-items: baseline;
    gap: .35rem;
    /* Minimaal 24px hoog, conform WCAG 2.5.8 voor bedieningselementen */
    min-height: 1.75rem;
    padding: .3rem .6rem;
    border-radius: 9999px;
    font-size: .8125rem;
    font-weight: 600;
    color: var(--color-grijs);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 140ms ease, color 140ms ease;
  }
  .pil:hover > span { background: var(--color-vlak); color: var(--color-marine); }
  .pil:has(input:checked) > span {
    background: var(--accent-sterk, var(--color-marine));
    color: #fff;
  }
  .pil input:focus-visible + span {
    outline: 3px solid var(--color-blauw);
    outline-offset: 2px;
  }
  .pil-aantal { font-variant-numeric: tabular-nums; opacity: .65; font-weight: 700; }
  .pil:has(input:checked) .pil-aantal { opacity: .8; }

  /* ---------- Eén rij per beroepsgroep ---------- */
  .groep {
    display: grid;
    gap: 1rem;
    align-items: start;
    padding: 1.25rem;
    border: 1px solid var(--color-lijn);
    border-radius: .875rem;
    background: #fff;
    box-shadow: var(--shadow-kaart);
  }
  @media (min-width: 900px) {
    .groep { grid-template-columns: 15rem 1fr; gap: 1.5rem; align-items: center; }
    .groep-kop { padding-right: 1.5rem; border-right: 1px solid var(--color-lijn); }
  }

  .tegels {
    display: grid;
    gap: .75rem;
  }
  @media (min-width: 640px) { .tegels { grid-template-columns: repeat(3, 1fr); } }

  .tegel {
    display: flex;
    flex-direction: column;
    padding: .9rem 1rem;
    border-radius: .625rem;
    background: var(--accent-vlak);
    border: 1px solid transparent;
    border-top: 3px solid var(--accent);
    transition: border-color 160ms ease, transform 160ms ease;
  }
  .tegel:hover, .tegel:focus-within {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    border-top-color: var(--accent);
    transform: translateY(-2px);
  }
  .tegel-niveau {
    font-size: .6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--accent-tekst);
  }
  .tegel-belofte {
    margin-top: .35rem;
    flex: 1;
    font-size: .875rem;
    line-height: 1.45;
    color: var(--color-inkt);
  }
  /*
    Verticale ruimte zodat het klikvlak minstens 24px hoog is: WCAG 2.5.8 vraagt
    dat voor bedieningselementen. Zonder die padding was de link 20px, en dan
    moet je het van de uitzondering voor tussenruimte hebben. Beter gewoon een
    doel dat groot genoeg is — dat scheelt ook misklikken op een telefoon.
  */
  .tegel-link {
    margin-top: .6rem;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    min-height: 1.5rem;
    padding-block: .25rem;
    font-size: .8125rem;
    font-weight: 700;
    color: var(--accent-tekst);
  }
  .tegel-link:hover { text-decoration: underline; }

  /* Wie minder beweging wil, krijgt geen verschuiving */
  @media (prefers-reduced-motion: reduce) {
    .tegel:hover, .tegel:focus-within { transform: none; }
  }

  ${filterCss}

  ${sectorkeuzeCss}
`} />
