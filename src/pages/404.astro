---
import { link } from '../lib/link';
import Base from '../layouts/Base.astro';
---

<Base
  titel="Pagina niet gevonden"
  beschrijving="Deze pagina bestaat niet (meer). Bekijk het overzicht van sectoren of neem contact op met Bureau Weerbaar en Veilig."
>
  <section class="paginakop op-donker">
    <div class="wrap">
      <p class="eyebrow">Foutmelding 404</p>
      <h1>Deze pagina bestaat niet</h1>
      <p class="lede">
        Mogelijk is de pagina verhuisd of klopt het adres niet. Hieronder staan de
        snelste routes naar wat je waarschijnlijk zoekt.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid-2 sectorraster">
        {[
          ['Alle sectoren', 'Negentien sectoren, vierenveertig beroepsgroepen.', '/sectoren/'],
          ['De drie niveaus', 'Basis, gevorderd en expert — wat is het verschil?', '/niveaus/'],
          ['Trainingsgids', 'Vijf vragen die je langs de keuze leiden.', '/trainingsgids/'],
          ['Contact', 'Bel, mail of vraag een terugbelverzoek aan.', '/contact/'],
        ].map(([titel, tekst, pad]) => (
          <article class="card">
            <h2>
              <a href={link(pad)} class="vlakdek">{titel}</a>
            </h2>
            <p>{tekst}</p>
          </article>
        ))}
      </div>

      <p class="sectorlijst-noot">
        Kom je er niet uit? Bel Bureau Weerbaar en Veilig op
        {' '}<a href="tel:+31857600435">085 760 0435</a>. Op werkdagen tussen 08:30 en 17:00.
      </p>
    </div>
  </section>
</Base>
