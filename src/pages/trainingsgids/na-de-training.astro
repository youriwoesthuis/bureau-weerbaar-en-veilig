---
import { link } from '../../lib/link';
import Gids from '../../layouts/Gids.astro';

const momenten = [
  {
    wanneer: 'Dezelfde week',
    wat: 'Deel de afspraken die in de training zijn gemaakt met iedereen die er niet bij was. Anders gelden ze voor de helft van het team en dus voor niemand.',
  },
  {
    wanneer: 'Binnen twee weken',
    wat: 'Pak de punten op die niet bij het team lagen maar bij de organisatie: bezetting, alarmering, de inrichting van een balie, een protocol dat niet klopt. Als daar niets mee gebeurt, was de training een symbolische handeling.',
  },
  {
    wanneer: 'Na zes weken',
    wat: 'Het moment waarop het wegzakt. Bij de expertniveaus zit hier standaard een intervisiebijeenkomst; voor de andere niveaus is een teamoverleg van een half uur genoeg. Wat is er geprobeerd, wat werkte, waar liep je vast?',
  },
  {
    wanneer: 'Doorlopend',
    wat: 'Maak een incident bespreekbaar op het moment zelf, niet pas bij de jaarlijkse evaluatie. Een korte nabespreking direct na een voorval doet meer dan een training per jaar.',
  },
];
---

<Gids
  slug="na-de-training"
  titel="Wat gebeurt er na een agressietraining?"
  beschrijving="Hoe je voorkomt dat een agressietraining een losse dag blijft: afspraken delen, organisatiepunten oppakken, intervisie na zes weken en incidenten blijven bespreken."
  eyebrow="Borging"
  lede="Een training verandert pas iets als er daarna iets verandert. Deel de afspraken met het hele team, pak de punten op die bij de organisatie liggen, en plan een terugkommoment na ongeveer zes weken. Bij de experttrainingen van Bureau Weerbaar en Veilig zit dat moment er standaard in."
  stats={[
    ['4', 'Momenten'],
    ['6 weken', 'Terugkommoment'],
    ['Expert', 'Intervisie standaard'],
    ['30 min', 'Genoeg voor een teamoverleg'],
  ]}
  onderwerp="het vervolg na een training"
>
  {/* ═══ Waarom het wegzakt ═══ */}
  <section class="section">
    <div class="wrap">
      <div class="leestekst">
        <p class="eyebrow">Het eerlijke antwoord</p>
        <h2>Waarom trainingen wegzakken</h2>
        <p>
          Niet omdat de training slecht was, en niet omdat het team niet wil. Een
          vaardigheid die je zelden gebruikt zakt weg — dat is normaal. En juist
          agressie is iets wat je hoopt niet dagelijks tegen te komen, dus de
          gelegenheid om te oefenen ontbreekt precies daar waar je hem nodig hebt.
        </p>
        <p>
          De tweede reden is bekender maar ongemakkelijker: op een trainingsdag
          komen bijna altijd punten boven tafel waar het team zelf niet over gaat.
          Een balie waar je niet weg kunt. Een alarmknop die niemand ooit
          geprobeerd heeft. Een rooster waardoor iemand alleen op huisbezoek gaat.
          Als daar niets mee gebeurt, leert het team vooral dat melden geen zin
          heeft.
        </p>
      </div>
    </div>
  </section>

  {/* ═══ De vier momenten ═══ */}
  <section class="section section--soft" aria-labelledby="momenten-titel">
    <div class="wrap">
      <p class="eyebrow">De weken erna</p>
      <h2 id="momenten-titel">Vier momenten die het verschil maken</h2>
      <ol class="ladder ladderblok niveau-gevorderd">
        {momenten.map((m, i) => (
          <li class="ladder-item programma-blok">
            <div class="ladder-kop programma-kop">
              <span class="ladder-nr">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <span class="ladder-titel">{m.wanneer}</span>
                <span class="ladder-bij">{m.wat}</span>
              </span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ═══ Vervolgtraining ═══ */}
  <section class="section">
    <div class="wrap">
      <div class="leestekst">
        <p class="eyebrow">Een niveau hoger, geen herhaling</p>
        <h2>Wanneer is een vervolgtraining zinvol?</h2>
        <p>
          Niet als "herhaling", maar als een niveau hoger. Een team dat de basis
          beheerst en er structureel mee te maken heeft, zit na een jaar meestal
          toe aan gevorderd: complexere casuïstiek, grenzen stellen onder druk, en
          het onderscheid tussen agressie uit emotie en agressie als middel. Voor
          leidinggevenden is er het expertniveau, dat over beleid, teamnorm en
          nazorgstructuur gaat.
        </p>
        <p>
          Twijfel je waar je team nu staat? De
          {' '}<a href={link('/trainingsgids/welk-niveau/')}>keuzehulp</a> loopt het
          in drie vragen na.
        </p>
      </div>
    </div>
  </section>
</Gids>
