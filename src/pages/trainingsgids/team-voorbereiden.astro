---
import { link } from '../../lib/link';
import Gids from '../../layouts/Gids.astro';

const checklist = [
  {
    kop: 'Kondig aan waaróm, niet alleen wanneer',
    tekst:
      'Een agendaverzoek zonder uitleg leest als een correctie: blijkbaar doen we iets fout. Zeg dat het gaat om situaties die hoe dan ook voorkomen, en dat de training bedoeld is om die makkelijker te maken.',
  },
  {
    kop: 'Vraag vooraf om situaties',
    tekst:
      'De training draait op eigen casuïstiek. Vraag iedereen een of twee situaties mee te nemen, en laat weten dat een situatie die níét goed ging het meest oplevert.',
  },
  {
    kop: 'Zorg dat de dag echt vrij is',
    tekst:
      'Deelnemers die tussendoor de telefoon opnemen halen er een fractie uit. Regel de vervanging zoals je die voor een cursusdag buiten de deur zou regelen.',
  },
  {
    kop: 'Wees duidelijk over wat er met de inhoud gebeurt',
    tekst:
      'Wat in de zaal besproken wordt, blijft daar. Geen terugkoppeling per deelnemer aan de leidinggevende. Zonder die zekerheid brengt niemand iets echts in.',
  },
  {
    kop: 'Laat de leidinggevende meedoen of juist niet',
    tekst:
      'Beide kan, maar kies bewust. Meedoen laat zien dat het serieus is; wegblijven maakt de ruimte veiliger. Bespreek vooraf met de trainer wat in jouw team beter werkt.',
  },
  {
    kop: 'Plan de nazorg nu al',
    tekst:
      'Zet meteen een teamoverleg in de agenda voor een paar weken later. Dat is het verschil tussen een leuke dag en een verandering.',
  },
];
---

<Gids
  slug="team-voorbereiden"
  titel="Een agressietraining voorbereiden met je team"
  beschrijving="Wat je vooraf regelt en aankondigt bij een agressietraining: casuïstiek verzamelen, verwachtingen managen, weerstand voor zijn en de nazorg alvast plannen."
  eyebrow="Vooraf"
  lede="Een agressietraining valt of staat bij wat deelnemers meebrengen. Vraag vooraf om echte situaties, leg uit waarom de training er is, en zorg dat de dag vrij is van werk. Bureau Weerbaar en Veilig stemt de inhoud af op wat er binnenkomt."
  stats={[
    ['6', 'Dingen die je regelt'],
    ['1–2', 'Situaties per deelnemer'],
    ['1 dag', 'Volledig vrij'],
    ['Vooraf', 'Nazorg inplannen'],
  ]}
  onderwerp="de voorbereiding van je team"
>
  {/* ═══ De weerstand ═══ */}
  <section class="section section--oranje">
    <div class="wrap">
      <p class="eyebrow">Wees erop voorbereid</p>
      <h2>De reactie die je bij vrijwel elk team krijgt</h2>

      <div class="grid grid-2 situatieraster">
        <div class="situatie">
          <p class="situatie-tekst">
            "Moeten wij op cursus omdat wíj iets fout doen?" Dat is geen onwil,
            het is een logische lezing van een aankondiging zonder uitleg.
            Agressie komt van buiten, en een training kan daardoor voelen als een
            verwijt aan wie hem opvangt.
          </p>
          <p class="situatie-bron">De vraag</p>
        </div>
        <div class="situatie">
          <p class="situatie-tekst">
            Draai de reden om. Niet: jullie moeten beter omgaan met agressie.
            Maar: wij vinden dat jullie hier niet alleen voor moeten staan. Dat
            is ook inhoudelijk juister — een groot deel van wat er op zo'n dag
            boven tafel komt gaat over roosters, bezetting en afspraken, en daar
            gaat het team zelf niet over.
          </p>
          <p class="situatie-bron">Het antwoord</p>
        </div>
      </div>
    </div>
  </section>

  {/* ═══ De checklist ═══ */}
  <section class="section" aria-labelledby="checklist-titel">
    <div class="wrap">
      <p class="eyebrow">Zes dingen die je regelt</p>
      <h2 id="checklist-titel">Checklist vooraf</h2>
      <ol class="grid grid-2 sectorraster">
        {checklist.map((c, i) => (
          <li class="card niveau-basis komt-op">
            <span class="badge">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="niveau-kop">{c.kop}</h3>
            <p>{c.tekst}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ═══ Een gemengd team ═══ */}
  <section class="section section--soft">
    <div class="wrap">
      <div class="leestekst">
        <p class="eyebrow">Als niet iedereen even ver is</p>
        <h2>Een gemengd team</h2>
        <p>
          Zit de helft van je team op basisniveau en de andere helft verder? Dan
          is één training voor iedereen zelden de beste oplossing: de een
          verveelt zich, de ander haakt af. Splitsen kan, en soms is een
          basistraining voor iedereen gevolgd door een verdieping voor een deel
          de rustigste route. De
          {' '}<a href={link('/trainingsgids/welk-niveau/')}>keuzehulp</a> geeft een
          eerste richting.
        </p>
      </div>
    </div>
  </section>
</Gids>
