---
import { link } from '../../lib/link';
import Gids from '../../layouts/Gids.astro';
import { NIVEAU_BESCHRIJVING, NIVEAU_LABELS } from '../../lib/sectoren';

/*
  De keuzehulp is een beslisboom, geen puntentelling. Dat is bewust: met CSS
  valt niet op te tellen, en het hoeft ook niet. De drie niveaudefinities uit
  CLAUDE.md geven zelf de vertakking aan.

    leidinggevende of coördinator                        → expert
    uitvoerend, nog geen training gehad                  → basis
    uitvoerend, wel training gehad, agressie incidenteel → basis (opfrissen)
    uitvoerend, wel training gehad, agressie structureel → gevorderd

  Vier regels, en elke uitkomst is te herleiden tot een definitie in plaats van
  tot een score die niemand kan controleren.
*/
const uitkomsten = [
  {
    id: 'expert',
    niveau: 'expert' as const,
    voorwaarde: '.keuzehulp:has(#rol-leiding:checked)',
    waarom:
      'Je bent verantwoordelijk voor een team of voor het beleid. Dan gaat het niet alleen om je eigen reactie, maar om de norm in het team, de nazorgstructuur en de borging daarvan.',
  },
  {
    id: 'basis-nieuw',
    niveau: 'basis' as const,
    voorwaarde: '.keuzehulp:has(#rol-uitvoerend:checked):has(#ervaring-nee:checked)',
    waarom:
      'Het team heeft nog geen agressietraining gehad. Dan begin je bij het fundament: signalen herkennen, je eigen reactie reguleren en het gesprek terugbrengen.',
  },
  {
    id: 'basis-opfris',
    niveau: 'basis' as const,
    voorwaarde:
      '.keuzehulp:has(#rol-uitvoerend:checked):has(#ervaring-ja:checked):has(#frequentie-soms:checked)',
    waarom:
      'Er is eerder getraind, maar agressie komt niet dagelijks voor. Dan is opfrissen op basisniveau zinvoller dan verdiepen: vaardigheden die je zelden gebruikt, zakken weg.',
  },
  {
    id: 'gevorderd',
    niveau: 'gevorderd' as const,
    voorwaarde:
      '.keuzehulp:has(#rol-uitvoerend:checked):has(#ervaring-ja:checked):has(#frequentie-vaak:checked)',
    waarom:
      'De basis zit er en het team komt er structureel mee in aanraking. Dan is er ruimte voor complexere casuïstiek: grenzen stellen onder druk, instrumentele agressie, nazorg en melden.',
  },
];

/* Elke uitkomst zichtbaar maken zodra zijn eigen voorwaarde klopt */
const uitkomstCss = uitkomsten
  .map((u) => `${u.voorwaarde} #uitkomst-${u.id} { display: block; }`)
  .join('\n  ');
---

<Gids
  slug="welk-niveau"
  titel="Welk niveau agressietraining heeft mijn team nodig?"
  beschrijving="Keuzehulp van Bureau Weerbaar en Veilig: beantwoord drie vragen over je team en zie of basis, gevorderd of expert past. Werkt zonder account of e-mailadres."
  eyebrow="Keuzehulp"
  lede="Bureau Weerbaar en Veilig biedt elke agressietraining in drie niveaus. Basis is voor wie nog niet eerder trainde, gevorderd voor teams die de basis beheersen en er structureel mee te maken hebben, expert voor leidinggevenden en coördinatoren. Beantwoord hieronder drie vragen en je ziet welk niveau past."
  stats={[
    ['3', 'Vragen'],
    ['3', 'Niveaus'],
    ['0', 'Gegevens gevraagd'],
    ['1 dag', 'Elk niveau'],
  ]}
  onderwerp="het juiste niveau voor jouw team"
>
  {/* ═══ De keuzehulp ═══ */}
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Drie vragen</p>
      <h2>Welk niveau past bij jouw team?</h2>

      <form class="keuzehulp" aria-label="Keuzehulp niveau">
        <fieldset class="vraag">
          <legend><span class="vraagnummer" aria-hidden="true">1</span> Voor wie is de training?</legend>
          <div class="antwoorden">
            <label class="antwoord">
              <input type="radio" name="rol" id="rol-uitvoerend" />
              <span>
                <strong>Uitvoerende medewerkers</strong>
                Mensen die zelf met cliënten, klanten of bezoekers werken.
              </span>
            </label>
            <label class="antwoord">
              <input type="radio" name="rol" id="rol-leiding" />
              <span>
                <strong>Leidinggevenden of coördinatoren</strong>
                Wie verantwoordelijk is voor een team, het beleid of de nazorg.
              </span>
            </label>
          </div>
        </fieldset>

        <fieldset class="vraag vervolg">
          <legend><span class="vraagnummer" aria-hidden="true">2</span> Heeft het team eerder een agressietraining gehad?</legend>
          <div class="antwoorden">
            <label class="antwoord">
              <input type="radio" name="ervaring" id="ervaring-nee" />
              <span><strong>Nee, of lang geleden</strong> Er is geen gedeelde basis om op voort te bouwen.</span>
            </label>
            <label class="antwoord">
              <input type="radio" name="ervaring" id="ervaring-ja" />
              <span><strong>Ja, recent</strong> De basisvaardigheden zijn bekend en geoefend.</span>
            </label>
          </div>
        </fieldset>

        <fieldset class="vraag vervolg2">
          <legend><span class="vraagnummer" aria-hidden="true">3</span> Hoe vaak krijgt het team met agressie te maken?</legend>
          <div class="antwoorden">
            <label class="antwoord">
              <input type="radio" name="frequentie" id="frequentie-soms" />
              <span><strong>Af en toe</strong> Een enkele keer per maand of minder.</span>
            </label>
            <label class="antwoord">
              <input type="radio" name="frequentie" id="frequentie-vaak" />
              <span><strong>Structureel</strong> Wekelijks of vaker, en soms zwaar.</span>
            </label>
          </div>
        </fieldset>

        <div class="uitkomsten" aria-live="polite">
          {uitkomsten.map((u) => (
            <div id={`uitkomst-${u.id}`} class={`uitkomst niveau-${u.niveau}`}>
              <p class="eyebrow">Passend niveau</p>
              <h3 class="uitkomst-kop">{NIVEAU_LABELS[u.niveau]}</h3>
              <p class="uitkomst-waarom">{u.waarom}</p>
              <p class="uitkomst-definitie">{NIVEAU_BESCHRIJVING[u.niveau]}</p>
              <div class="hero-actions">
                <a href={link(`/niveaus/${u.niveau}/`)} class="btn btn-primary">
                  Bekijk alle {NIVEAU_LABELS[u.niveau].toLowerCase()}trainingen
                </a>
                <a href={link('/sectoren/')} class="btn btn-outline">Zoek op beroepsgroep</a>
              </div>
            </div>
          ))}
        </div>
      </form>
    </div>
  </section>

  {/* ═══ De nuance ═══ */}
  <section class="section section--soft">
    <div class="wrap">
      <div class="leestekst">
        <p class="eyebrow">Een richting, geen diagnose</p>
        <h2>Twijfel je nog?</h2>
        <p>
          Deze keuzehulp is een richting, geen diagnose. In de praktijk zit een
          team er soms tussenin: de helft trainde vorig jaar, de andere helft is
          nieuw. Bureau Weerbaar en Veilig denkt daar graag in mee, en splitst een
          groep als dat beter uitpakt.
        </p>
        <p>
          Niet elke beroepsgroep vraagt hetzelfde. Een baliemedewerker bij een
          gemeenteloket heeft een ander gesprek dan een ambulancemedewerker op
          straat, ook op hetzelfde niveau. Daarom is elke training per
          beroepsgroep uitgewerkt: kijk bij
          {' '}<a href={link('/sectoren/')}>jouw sector</a> welke er zijn.
        </p>
      </div>
    </div>
  </section>
</Gids>

<style is:inline set:html={`
  .keuzehulp { max-width: 46rem; margin-top: 38px; }

  .vraag {
    border-top: 1px solid var(--color-lijn);
    padding-top: 28px;
    margin-top: 28px;
  }
  .vraag:first-child { border-top: 0; padding-top: 0; margin-top: 0; }
  .vraag legend {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 20px;
    font-weight: 800;
    color: var(--color-marine);
    line-height: 1.3;
  }
  .vraagnummer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--color-oranje-donker);
    color: #fff;
    font-size: 13px;
    font-weight: 800;
  }

  .antwoorden {
    display: grid;
    gap: 12px;
    margin-top: 20px;
  }
  @media (min-width: 640px) { .antwoorden { grid-template-columns: 1fr 1fr; } }

  /* De radioknop blijft bedienbaar met het toetsenbord, maar is niet zichtbaar */
  .antwoord input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .antwoord > span {
    display: block;
    padding: 16px 18px;
    border: 1px solid var(--color-lijn);
    border-radius: var(--radius);
    background: #fff;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-tekst-grijs);
    cursor: pointer;
    transition: border-color .14s ease, background-color .14s ease, transform .14s ease;
  }
  .antwoord > span strong {
    display: block;
    margin-bottom: 3px;
    color: var(--color-marine);
  }
  .antwoord:hover > span {
    border-color: var(--color-oranje);
    transform: translateY(-2px);
  }
  .antwoord:has(input:checked) > span {
    border-color: var(--color-oranje-donker);
    background: var(--color-oranje-zacht);
    box-shadow: inset 0 0 0 1px var(--color-oranje-donker);
  }
  .antwoord input:focus-visible + span {
    outline: 3px solid var(--color-blauw);
    outline-offset: 2px;
  }

  /*
    Vraag 2 verschijnt pas als vraag 1 beantwoord is, vraag 3 pas als vraag 2
    beantwoord is — en vraag 2 en 3 vervallen zodra iemand "leidinggevende"
    kiest, want dan is de uitkomst al bepaald. Zo staan er nooit meer keuzes op
    het scherm dan nodig.
  */
  .vervolg, .vervolg2, .uitkomst { display: none; }
  .keuzehulp:has(#rol-uitvoerend:checked) .vervolg { display: block; }
  .keuzehulp:has(#rol-uitvoerend:checked):has(#ervaring-ja:checked) .vervolg2 { display: block; }

  .uitkomst {
    margin-top: 38px;
    border: 1px solid var(--color-lijn);
    border-top: 4px solid var(--accent);
    border-radius: var(--radius);
    background: var(--accent-zacht);
    padding: 28px;
  }
  .uitkomst-kop {
    margin-top: 10px;
    font-size: 26px;
    font-weight: 800;
    color: var(--color-marine);
  }
  .uitkomst-waarom {
    margin-top: 12px;
    line-height: 1.6;
    color: var(--color-inkt);
  }
  .uitkomst-definitie {
    margin-top: 18px;
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / .75);
    padding: 15px 17px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-inkt);
  }
  .uitkomst .hero-actions { margin-top: 22px; }

  ${uitkomstCss}
`} />
