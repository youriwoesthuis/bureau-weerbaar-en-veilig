---
import { link } from '../../lib/link';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Terugbelverzoek from '../../components/Terugbelverzoek.astro';
import { TRAININGSGIDS } from '../../lib/trainingsgids';

const trainingen = await getCollection('trainingen');
const beroepsgroepen = await getCollection('beroepsgroepen');

const lijstSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Trainingsgids: een agressietraining regelen',
  numberOfItems: TRAININGSGIDS.length,
  itemListElement: TRAININGSGIDS.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.titel,
    url: new URL(link(`/trainingsgids/${p.slug}/`), Astro.site).href,
  })),
});
---

<Base
  titel="Trainingsgids: een agressietraining regelen"
  beschrijving="Hulp bij het regelen van een agressietraining: welk niveau je team nodig heeft, hoe een trainingsdag verloopt, hoe je voorbereidt, borgt en intern akkoord krijgt."
  schema={[lijstSchema]}
>
  {/* ═══ Paginakop ═══ */}
  <section class="paginakop op-donker">
    <div class="wrap">
      <Breadcrumb pad={[{ naam: 'Home', pad: '/' }, { naam: 'Trainingsgids' }]} />
      <p class="eyebrow">Voor wie het regelt</p>
      <h1>Een agressietraining regelen</h1>
      <p class="lede">
        Vijf vragen die iedereen stelt die binnen een organisatie een
        agressietraining moet regelen. Bureau Weerbaar en Veilig beantwoordt ze
        hier, zodat je weet wat je kiest, wat je kunt verwachten en hoe je het
        intern rondkrijgt.
      </p>

      <div class="kop-stats">
        <div class="kop-stat"><b>{TRAININGSGIDS.length}</b><span>Vragen</span></div>
        <div class="kop-stat"><b>{trainingen.length}</b><span>Trainingen</span></div>
        <div class="kop-stat"><b>{beroepsgroepen.length}</b><span>Beroepsgroepen</span></div>
        <div class="kop-stat"><b>1 dag</b><span>Per training</span></div>
      </div>
    </div>
  </section>

  {/* ═══ De vijf vragen ═══ */}
  <section class="section">
    <div class="wrap">
      <ol class="grid grid-2 gidsraster">
        {TRAININGSGIDS.map((p, i) => (
          <li class="gidskaart komt-op">
            <span class="gidskaart-nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2>
                <a href={link(`/trainingsgids/${p.slug}/`)} class="vlakdek">{p.titel}</a>
              </h2>
              <p>{p.kort}</p>
            </div>
            <span class="gidskaart-pijl" aria-hidden="true">→</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/*
    ═══ Verwijzing naar het zustermerk ═══
    Bewust een verwijzing in plaats van eigen achtergrondartikelen: de scheiding
    uit MERKGROEP.md hoofdstuk 2 zegt dat kennis over agressie bij
    agressievisie.nl hoort en niet hier.
  */}
  <section class="section section--soft">
    <div class="wrap">
      <div class="leestekst">
        <p class="eyebrow">Andere vraag?</p>
        <h2>Zoek je achtergrond over agressie zelf?</h2>
        <p>
          Deze gids gaat over het regelen van een training: kiezen, voorbereiden,
          borgen en verantwoorden. Zoek je cijfers, wetgeving, onderzoek of
          uitleg van methodieken, dan is <a href="https://agressievisie.nl">agressievisie.nl</a>
          {' '}de plek daarvoor. Dat is het kennisplatform van dezelfde organisatie
          waar Bureau Weerbaar en Veilig onder valt, en het verkoopt niets.
        </p>
        <p>
          Wil je liever meteen weten wat er is: er staan {trainingen.length} trainingen
          klaar voor {beroepsgroepen.length} beroepsgroepen, te filteren op
          {' '}<a href={link('/trainingen/')}>de overzichtspagina</a>.
        </p>
      </div>
    </div>
  </section>

  {/* ═══ Afsluiting ═══ */}
  <section class="section section--tight">
    <div class="wrap">
      <Terugbelverzoek onderwerp="het regelen van een training" />
    </div>
  </section>
</Base>
