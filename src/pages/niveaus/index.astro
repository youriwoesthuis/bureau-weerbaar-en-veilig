---
import { link } from '../../lib/link';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import NiveauBadge from '../../components/NiveauBadge.astro';
import { NIVEAU_BESCHRIJVING, NIVEAU_LABELS, NIVEAU_LINKTEKST } from '../../lib/sectoren';

const niveaus = ['basis', 'gevorderd', 'expert'] as const;
---

<Base
  titel="Trainingsniveaus: basis, gevorderd en expert"
  beschrijving="Bureau Weerbaar en Veilig biedt elke agressietraining in drie niveaus: basis (herkennen en de-escaleren), gevorderd (complexe situaties) en expert (beleid en borging voor leidinggevenden)."
>
  <div class="vlak-donker op-donker relative overflow-hidden text-white">
    <div class="motief-chevron absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-10 md:py-14">
      <Breadcrumb pad={[{ naam: 'Home', pad: '/' }, { naam: 'Niveaus' }]} />
      <p class="kicker mt-7">Van herkennen tot borgen</p>
      <h1 class="mt-4 text-3xl font-bold leading-[1.15] md:text-5xl">
        Drie niveaus agressietraining
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-white/85">
        Bureau Weerbaar en Veilig bouwt elke agressietraining op in drie niveaus,
        zodat elke medewerker traint op het niveau dat past bij zijn of haar rol
        en ervaring.
      </p>
    </div>
  </div>
  <div class="lijn-merk" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 py-16">
    <ol class="grid gap-6 md:grid-cols-3">
      {niveaus.map((n, i) => (
        <li class={`niveau-${n} kaart flex flex-col p-7`}>
          <div class="flex items-center justify-between">
            <NiveauBadge niveau={n} />
            <span class="flex gap-0.5" aria-hidden="true">
              {Array.from({ length: i + 1 }).map(() => (
                <svg viewBox="0 0 12 16" class="h-5 w-4" style="color: var(--accent)" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 3l6 5-6 5" />
                </svg>
              ))}
            </span>
          </div>
          <h2 class="mt-5 text-xl font-bold text-marine">{NIVEAU_LABELS[n]}</h2>
          <p class="mt-3 flex-1 leading-relaxed text-grijs">{NIVEAU_BESCHRIJVING[n]}</p>
          <a
            href={link(`/niveaus/${n}/`)}
            class="mt-6 inline-flex items-center gap-2 text-sm font-bold after:absolute after:inset-0"
            style="color: var(--accent-tekst)"
          >
            {NIVEAU_LINKTEKST[n]}
            <span class="pijl" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>
