---
import { link } from '../../lib/link';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import NiveauBadge from '../../components/NiveauBadge.astro';
import { SECTOR_NAMEN, NIVEAU_BESCHRIJVING, NIVEAU_LABELS } from '../../lib/sectoren';

export function getStaticPaths() {
  return (['basis', 'gevorderd', 'expert'] as const).map((niveau) => ({ params: { niveau } }));
}

const niveau = Astro.params.niveau as 'basis' | 'gevorderd' | 'expert';
const label = NIVEAU_LABELS[niveau];

const trainingen = (await getCollection('trainingen'))
  .filter((t) => t.data.niveau === niveau)
  .sort((a, b) => a.data.sector.localeCompare(b.data.sector));

/* Groepeer per sector */
const perSector = new Map<string, typeof trainingen>();
for (const t of trainingen) {
  const lijst = perSector.get(t.data.sector) ?? [];
  lijst.push(t);
  perSector.set(t.data.sector, lijst);
}
---

<Base
  titel={`Agressietraining niveau ${label.toLowerCase()}`}
  beschrijving={`Overzicht van alle agressietrainingen op niveau ${label.toLowerCase()} van Bureau Weerbaar en Veilig, per sector en beroepsgroep. ${NIVEAU_BESCHRIJVING[niveau]}`}
>
  <div class="vlak-donker op-donker relative overflow-hidden text-white">
    <div class="motief-chevron absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-10 md:py-14">
      <Breadcrumb
        pad={[{ naam: 'Home', pad: '/' }, { naam: 'Niveaus', pad: '/niveaus/' }, { naam: label }]}
      />
      <div class="mt-6">
        <NiveauBadge niveau={niveau} />
        <h1 class="mt-4 text-3xl font-bold leading-[1.15] md:text-5xl">
          Agressietraining: niveau {label.toLowerCase()}
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-white/85">{NIVEAU_BESCHRIJVING[niveau]}</p>
      </div>
    </div>
  </div>
  <div class="lijn-merk" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 py-12">
    {perSector.size === 0 ? (
      <p class="text-grijs">De trainingen op dit niveau worden op dit moment toegevoegd.</p>
    ) : (
      [...perSector.entries()].map(([sector, lijst]) => (
        <section class="mb-10" aria-label={SECTOR_NAMEN[sector] ?? sector}>
          <h2 class="text-xl font-bold text-marine">
            <a href={link(`/sectoren/${sector}/`)} class="hover:underline">
              {SECTOR_NAMEN[sector] ?? sector}
            </a>
          </h2>
          <ul class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {lijst.map((t) => (
              <li class="rounded-xl border border-lijn p-5">
                <a
                  href={link(`/trainingen/${t.data.slug}/`)}
                  class="font-semibold leading-snug text-blauw hover:underline"
                >
                  {t.data.titel} →
                </a>
                <p class="mt-2 text-xs text-grijs">{t.data.duur} · {t.data.groepsgrootte}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    )}
  </div>
</Base>
