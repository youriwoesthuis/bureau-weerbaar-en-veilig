---
import { link } from '../../lib/link';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Terugbelverzoek from '../../components/Terugbelverzoek.astro';
import { situatieSelectie } from '../../lib/situaties';
import { SECTOR_NAMEN, NIVEAU_BESCHRIJVING, NIVEAU_LABELS } from '../../lib/sectoren';

export function getStaticPaths() {
  return (['basis', 'gevorderd', 'expert'] as const).map((niveau) => ({ params: { niveau } }));
}

const niveau = Astro.params.niveau as 'basis' | 'gevorderd' | 'expert';
const label = NIVEAU_LABELS[niveau];

const trainingen = (await getCollection('trainingen'))
  .filter((t) => t.data.niveau === niveau)
  .sort((a, b) => a.data.sector.localeCompare(b.data.sector));

/* Groepeer per sector */
const perSector = new Map<string, typeof trainingen>();
for (const t of trainingen) {
  const lijst = perSector.get(t.data.sector) ?? [];
  lijst.push(t);
  perSector.set(t.data.sector, lijst);
}

/*
  Deze pagina beantwoordt een vraag die mensen letterlijk zo stellen: "wat is
  een basis agressietraining". Er stond alleen de algemene niveauomschrijving,
  en die noemt de organisatie niet en geeft geen aantallen — losgeknipt van de
  pagina zegt zo'n alinea niets, en dat is precies wat een AI-antwoordsysteem
  ermee doet.

  De openingsalinea noemt nu de organisatie voluit, het aantal trainingen, de
  duur en de groepsgrootte: allemaal uit de trainingen zelf, dus na te trekken
  en niet te verouderen.
*/
const uniek = (veld: 'duur' | 'groepsgrootte') => {
  const waarden = [...new Set(trainingen.map((t) => t.data[veld]))];
  return waarden.length === 1 ? waarden[0] : waarden.join(' of ');
};
const sectorenTelling = perSector.size;

/*
  Vier praktijksituaties uit de trainingen van dít niveau. Een overzichtspagina
  van honderd links leest als een register; deze zinnen laten zien waar de dag
  daadwerkelijk over gaat, en ze verschillen per niveau omdat ze uit die
  trainingen komen.
*/
const situaties = await situatieSelectie(4);

/* Wat dit niveau ván de andere twee onderscheidt, in drie kenmerken. */
const KENMERKEN = {
  basis: [
    ['Herkennen', 'Signalen lezen voordat het escaleert: houding, stem, tempo.'],
    ['Reguleren', 'Je eigen reactie onder controle houden als het spannend wordt.'],
    ['De-escaleren', 'Het gesprek terugbrengen naar de inhoud, zonder de ander te verliezen.'],
  ],
  gevorderd: [
    ['Complexe casuïstiek', 'Situaties die niet met een standaardaanpak op te lossen zijn.'],
    ['Grenzen onder druk', 'Nee zeggen en vasthouden terwijl er aan je getrokken wordt.'],
    ['Melden en nazorg', 'Wat je vastlegt, aan wie je het meldt, en hoe je een collega opvangt.'],
  ],
  expert: [
    ['Teamnorm', 'Afspreken wat jullie wel en niet accepteren, en dat volhouden.'],
    ['Beleid en borging', 'Van incidentmelding naar een structuur die blijft staan.'],
    ['De eigen organisatie', 'Het gesprek voeren met directie, HR en collega-leidinggevenden.'],
  ],
} as const;

const lijstSchema = trainingen.length
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `Agressietraining niveau ${label.toLowerCase()}`,
      numberOfItems: trainingen.length,
      itemListElement: trainingen.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.data.titel,
        url: new URL(link(`/trainingen/${t.data.slug}/`), Astro.site).href,
      })),
    })
  : null;
---

<Base
  titel={`Agressietraining niveau ${label.toLowerCase()}`}
  beschrijving={`Overzicht van alle agressietrainingen op niveau ${label.toLowerCase()} van Bureau Weerbaar en Veilig, per sector en beroepsgroep. ${NIVEAU_BESCHRIJVING[niveau]}`}
  schema={lijstSchema ? [lijstSchema] : []}
>
  <div class={`niveau-${niveau}`}>
    {/* ═══ Paginakop ═══ */}
    <section class="paginakop op-donker">
      <div class="wrap">
        <Breadcrumb
          pad={[{ naam: 'Home', pad: '/' }, { naam: 'Niveaus', pad: '/niveaus/' }, { naam: label }]}
        />
        <p class="eyebrow">Niveau {label.toLowerCase()}</p>
        <h1>Agressietraining: niveau {label.toLowerCase()}</h1>
        <p class="lede">
          Bureau Weerbaar en Veilig geeft {trainingen.length} agressietrainingen op
          niveau {label.toLowerCase()}, verdeeld over {sectorenTelling} sectoren.
          {' '}{NIVEAU_BESCHRIJVING[niveau]} Elke training duurt {uniek('duur')} en
          telt {uniek('groepsgrootte')}.
        </p>

        <div class="kop-stats">
          <div class="kop-stat"><b>{trainingen.length}</b><span>Trainingen</span></div>
          <div class="kop-stat"><b>{sectorenTelling}</b><span>Sectoren</span></div>
          <div class="kop-stat"><b>{uniek('duur')}</b><span>Per training</span></div>
          <div class="kop-stat"><b>Neede</b><span>Of incompany</span></div>
        </div>
      </div>
    </section>

    {/* ═══ Waar dit niveau over gaat ═══ */}
    <section class="section">
      <div class="wrap">
        <p class="eyebrow">Wat dit niveau onderscheidt</p>
        <h2>Waar de dag over gaat</h2>
        <ol class="ladder ladderblok">
          {KENMERKEN[niveau].map(([titel, tekst], i) => (
            <li class="ladder-item programma-blok">
              <div class="ladder-kop programma-kop">
                <span class="ladder-nr">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <span class="ladder-titel">{titel}</span>
                  <span class="ladder-bij">{tekst}</span>
                </span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ═══ Praktijksituaties ═══ */}
    {situaties.length > 0 && (
      <section class="section section--oranje" aria-labelledby="situaties-titel">
        <div class="wrap">
          <p class="eyebrow">Waar het over gaat</p>
          <h2 id="situaties-titel">Situaties zoals ze in deze trainingen staan</h2>
          <div class="grid grid-2 situatieraster">
            {situaties.map((s) => (
              <div class="situatie komt-op">
                <p class="situatie-tekst">{s.tekst}</p>
                <p class="situatie-bron">
                  <a href={link(`/trainingen/${s.slug}/`)}>{s.beroepsgroep}</a>
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ═══ Het aanbod per sector ═══ */}
    <section class="section section--soft">
      <div class="wrap">
        <p class="eyebrow">Het aanbod</p>
        <h2>Niveau {label.toLowerCase()} per sector</h2>

        {perSector.size === 0 ? (
          <p class="sectorlijst-noot">
            De trainingen op dit niveau worden op dit moment toegevoegd.
          </p>
        ) : (
          <div class="groepenlijst">
            {[...perSector.entries()].map(([sector, lijst]) => (
              <article class="groep">
                <h3 class="groep-titel">
                  <a href={link(`/sectoren/${sector}/`)}>{SECTOR_NAMEN[sector] ?? sector}</a>
                </h3>
                <ul class="grid grid-3 groep-niveaus">
                  {lijst.map((t) => (
                    <li class="niveaukaart">
                      <a href={link(`/trainingen/${t.data.slug}/`)} class="niveaukaart-link vlakdek">
                        {t.data.titel}
                      </a>
                      <span class="niveaukaart-duur">{t.data.duur} · {t.data.groepsgrootte}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    {/* ═══ Afsluiting ═══ */}
    <section class="section section--tight">
      <div class="wrap">
        <Terugbelverzoek onderwerp={`de trainingen op niveau ${label.toLowerCase()}`} />
      </div>
    </section>
  </div>
</Base>
