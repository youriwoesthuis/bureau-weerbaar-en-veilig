---
/**
 * De homepage.
 *
 * Opgezet in dezelfde taal als agressievisie.nl, want dat is de site waar de
 * opdrachtgever naar wees: gesplitste kop met een tekening ernaast, een
 * klikbare cijferstrip die over de kop heen valt, kaarten met gekleurde
 * pictogrammen, een afwisseling van lichte en donkere vlakken, en een
 * afsluitende band in het merkverloop.
 *
 * Wat anders is: daar gaat het over kennis, hier over trainingen. En de
 * kleuren zijn die van dit merk — oranje, paars en indigo uit het beeldmerk,
 * waarbij elke kleur bovendien een niveau aanduidt.
 *
 * ── De tekst is kort gehouden ──
 *
 * De vorige homepage telde achttienhonderd woorden. Dit is een instappagina,
 * geen brochure: wie hier komt kiest, en leest pas op de pagina daarna. Uit
 * het overleg met Gemini kwam vierhonderd à vijfhonderd woorden als ondergrens,
 * mits de entiteitsdefinitie in de eerste vijftig woorden staat en de cijfers
 * aanwezig blijven. Dat is de opzet hier.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import SectorIcoon from '../components/SectorIcoon.astro';
import { link } from '../lib/link';
import { inZin } from '../lib/naam';
import { telwoord } from '../lib/sectoren';
import { alleSituaties } from '../lib/situaties';
import { voorDeGroep } from '../lib/team';

const sectoren = (await getCollection('sectoren')).sort((a, b) =>
  a.data.naam.localeCompare(b.data.naam)
);
const trainingen = await getCollection('trainingen');
const beroepsgroepen = await getCollection('beroepsgroepen');
const situaties = await alleSituaties();
const team = await voorDeGroep();

const fotos = import.meta.glob<{ default: ImageMetadata }>('../images/team/*.jpg', { eager: true });
const fotoVan = (id: string) => {
  const sleutel = Object.keys(fotos).find((p) => p.endsWith(`/${id}.jpg`));
  return sleutel ? fotos[sleutel].default : undefined;
};
const acteurs = team.filter((l) => /acteur/i.test(l.data.rol)).length;

/*
  De cijfers worden geteld uit de content, niet met de hand ingevuld. Komt er
  een training bij, dan klopt het getal de volgende build vanzelf nog steeds —
  en dat is precies waarom ze hier mogen staan: ze zijn na te rekenen.
*/
const cijfers = [
  { getal: trainingen.length, wat: 'trainingen', pad: '/trainingen/', niveau: 'basis' },
  { getal: beroepsgroepen.length, wat: 'beroepsgroepen', pad: '/sectoren/', niveau: 'gevorderd' },
  { getal: sectoren.length, wat: 'sectoren', pad: '/sectoren/', niveau: 'expert' },
  { getal: situaties.length, wat: 'praktijksituaties', pad: '/trainingen/', niveau: 'basis' },
];

const aantalTrainingen = (s: string) => trainingen.filter((t) => t.data.sector === s).length;
const aantalGroepen = (s: string) => beroepsgroepen.filter((b) => b.data.sector === s).length;

/* De drie niveaus rouleren over de merkkleuren, zodat het raster kleur krijgt. */
const NIVEAUS = ['basis', 'gevorderd', 'expert'] as const;

/*
  De ladder: drie treden die openklappen. Wat erin staat komt uit de
  trainingen zelf — de meest voorkomende leeruitkomsten per niveau, geteld over
  alle vierenveertig beroepsgroepen. Zo staat er geen bedachte omschrijving maar
  wat er daadwerkelijk geleerd wordt.
*/
const ladder = NIVEAUS.map((niveau, i) => {
  const vanNiveau = trainingen.filter((t) => t.data.niveau === niveau);
  const telling = new Map<string, number>();
  for (const t of vanNiveau) {
    for (const r of t.data.resultaat) telling.set(r, (telling.get(r) ?? 0) + 1);
  }
  return {
    niveau,
    nummer: String(i + 1).padStart(2, '0'),
    titel: { basis: 'Basis', gevorderd: 'Gevorderd', expert: 'Expert' }[niveau],
    kern: {
      basis: 'Herkennen en de-escaleren',
      gevorderd: 'Zwaardere en structurele situaties',
      expert: 'Beleid, teamnorm en borging',
    }[niveau],
    aantal: vanNiveau.length,
    voorWie: {
      basis: 'Voor iedereen die met agressie te maken kan krijgen.',
      gevorderd: 'Voor wie de basis beheerst en structureel met zwaardere situaties werkt.',
      expert: 'Voor leidinggevenden en coördinatoren.',
    }[niveau],
    leert: [...telling.entries()]
      .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
      .slice(0, 4)
      .map(([tekst]) => tekst),
  };
});

/* Vier situaties, elk uit een andere beroepsgroep, gespreid over het alfabet. */
const perGroep = new Map<string, typeof situaties>();
for (const s of situaties) {
  const l = perGroep.get(s.beroepsgroep) ?? [];
  l.push(s);
  perGroep.set(s.beroepsgroep, l);
}
const kandidaten = [...perGroep.values()]
  .map((l) => l.slice().sort((a, b) => b.tekst.length - a.tekst.length)[0])
  .sort((a, b) => a.beroepsgroep.localeCompare(b.beroepsgroep));
const stap = Math.max(1, Math.floor(kandidaten.length / 4));
const uitgelicht = [0, 1, 2, 3].map((i) => kandidaten[(i * stap) % kandidaten.length]);
---

<Base
  titel="Agressietraining per beroepsgroep | Bureau Weerbaar en Veilig"
  beschrijving="Bureau Weerbaar en Veilig is dé specialist in agressietraining: de-escaleren, grenzen stellen en veilig werken, per sector en beroepsgroep, in drie niveaus."
>
  {/* ═══ Kop ═══ */}
  <section class="hero">
    <div class="omvat hero-raster">
      <div>
        <p class="label">Specialist in agressietraining</p>

        {/*
          De entiteitsdefinitie staat in de eerste vijftig woorden: wie we
          zijn, wat we doen, voor wie. Dat is het stuk dat een AI-systeem
          overneemt als iemand vraagt wat Bureau Weerbaar en Veilig is.
        */}
        <h1 class="hero-titel">Agressietraining voor<br />jouw beroepsgroep.</h1>
        <p class="hero-lead">
          Bureau Weerbaar en Veilig traint teams in het omgaan met agressie,
          intimidatie en grensoverschrijdend gedrag op de werkvloer. Eén
          onderwerp, tot in de diepte, per beroepsgroep uitgewerkt — in drie
          niveaus. Incompany of in Neede, in groepen van maximaal tien.
        </p>

        <div class="hero-acties">
          <a href={link('/sectoren/')} class="knop knop-vol">
            Vind jouw beroepsgroep
            <span class="pijl" aria-hidden="true">↗</span>
          </a>
          <a href="#niveaus" class="knop knop-blauw">Welk niveau heb ik nodig?<span class="pijl" aria-hidden="true">↗</span></a>
        </div>
      </div>

      {/*
        De drie niveaus als oplopende staven. Geen sfeerplaatje: de tekening
        zegt wat de opbouw is, van herkennen via zwaardere situaties naar
        beleid. De staven staan op een wit vlak, dus ze dragen de volle
        merkkleuren zonder dat de tekst eronder lijdt.
      */}
      <div class="hero-beeld" aria-hidden="true">
        <svg viewBox="0 0 420 320" role="presentation">
          <defs>
            <linearGradient id="staafExpert" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0%" stop-color="#17203d" />
              <stop offset="100%" stop-color="#4a3455" />
            </linearGradient>
          </defs>

          {/* De grondlijn */}
          <line x1="20" y1="292" x2="400" y2="292" stroke="#23262b" stroke-opacity="0.3" stroke-width="2" />

          {/* Basis */}
          <rect x="52" y="196" width="72" height="96" rx="10" fill="#a35405" />
          <text x="88" y="180" text-anchor="middle" fill="#23262b" font-size="15" font-weight="700"
                font-family="Space Grotesk Variable, sans-serif">Basis</text>

          {/* Gevorderd */}
          <rect x="174" y="132" width="72" height="160" rx="10" fill="#735578" />
          <text x="210" y="116" text-anchor="middle" fill="#23262b" font-size="15" font-weight="700"
                font-family="Space Grotesk Variable, sans-serif">Gevorderd</text>

          {/* Expert */}
          <rect x="296" y="52" width="72" height="240" rx="10" fill="url(#staafExpert)" />
          <text x="332" y="36" text-anchor="middle" fill="#23262b" font-size="15" font-weight="700"
                font-family="Space Grotesk Variable, sans-serif">Expert</text>

          {/* De chevron uit het beeldmerk, bovenop de hoogste staaf */}
          <path d="M316 74 l16 14 l16 -14" fill="none" stroke="#f7a52b" stroke-opacity="0.9"
                stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M316 92 l16 14 l16 -14" fill="none" stroke="#f7a52b" stroke-opacity="0.5"
                stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>
  </section>

  {/* ═══ De cijfers ═══ */}
  <div class="omvat">
    <div class="cijferstrip">
      {/*
        De eerste kaart krijgt het volle merk-oranje als vlak. Dat trekt het oog
        naar het belangrijkste getal — het aantal trainingen — en laat de
        merkkleur op volle sterkte zien, zonder dat vier felle vlakken om
        aandacht gaan vechten.
      */}
      {cijfers.map((c, i) => (
        <a
          href={link(c.pad)}
          class={`cijferkaart niveau-${c.niveau}${i === 0 ? ' cijferkaart-vol' : ''}`}
        >
          <b>{c.getal}</b>
          <span>{c.wat}</span>
        </a>
      ))}
    </div>
  </div>

  {/* ═══ Sectoren ═══ */}
  <section class="vlak">
    <div class="omvat">
      <p class="label">Kies je vertrekpunt</p>
      <h2 class="sectie-titel">Trainingen per sector</h2>
      <p class="sectie-lead">
        Elke sector kent zijn eigen situaties. De balie van een gemeente is de
        spreekkamer van een huisarts niet, en dat verschil bepaalt de training.
      </p>

      <ul class="sectorraster">
        {sectoren.map((s, i) => (
          <li class={`sectorkaart niveau-${NIVEAUS[i % 3]} komt-op`}>
            <span class="sectoricoon" aria-hidden="true">
              <SectorIcoon sector={s.data.slug} />
            </span>
            <span>
              <span class="sectorkaart-naam">
                <a href={link(`/sectoren/${s.data.slug}/`)} class="vlakdek">{s.data.naam}</a>
              </span>
              <span class="sectorkaart-bij">
                {telwoord(aantalTrainingen(s.data.slug), 'training', 'trainingen')} ·
                {' '}{telwoord(aantalGroepen(s.data.slug), 'beroepsgroep', 'beroepsgroepen')}
              </span>
            </span>
            <span class="pijl sectorkaart-pijl" aria-hidden="true">→</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ═══ Wat er in het vak gebeurt ═══ */}
  <section class="vlak-papier vlak">
    <div class="omvat">
      <p class="label">Waar het over gaat</p>
      <h2 class="sectie-titel">Dit staat er in de trainingen, letterlijk</h2>
      <p class="sectie-lead">
        Geen bedachte voorbeelden. Deze situaties staan woordelijk in de
        trainingen, per beroepsgroep uitgewerkt.
      </p>

      <div class="dossierrij" style="margin-top: var(--ruimte-8)">
        {uitgelicht.map((s, i) => (
          <article class={`dossier niveau-${NIVEAUS[i % 3]} komt-op`}>
            <p class="dossier-kenmerk">
              <span>Casus {String(i + 1).padStart(2, '0')}</span>
              <span>{s.beroepsgroep}</span>
            </p>
            <p class="dossier-tekst">{s.tekst}</p>
          </article>
        ))}
      </div>

      <p class="dossier-bij">
        Er staan er {situaties.length} op deze site, verdeeld over
        {' '}{beroepsgroepen.length} beroepsgroepen.
      </p>
    </div>
  </section>

  {/* ═══ De niveaus, als ladder ═══ */}
  <section id="niveaus" class="vlak">
    <div class="omvat">
      <p class="label">Van herkennen tot borgen</p>
      <h2 class="sectie-titel">Drie niveaus, één opbouw</h2>
      <p class="sectie-lead">
        Klap een niveau open om te zien wat er geleerd wordt. Wat daar staat is
        geteld uit alle trainingen van dat niveau.
      </p>

      <div class="ladder">
        {ladder.map((n) => (
          <details class={`ladder-trede niveau-${n.niveau}`}>
            <summary class="ladder-kop">
              <span class="ladder-nummer">{n.nummer}</span>
              <span>
                <span class="ladder-titel">{n.titel} — {n.kern}</span>
                <span class="ladder-bij">{n.voorWie} · {n.aantal} trainingen</span>
              </span>
              <span class="ladder-teken" aria-hidden="true"></span>
            </summary>
            <div class="ladder-inhoud">
              <ul class="ladder-lijst">
                {n.leert.map((l) => <li>{l}</li>)}
              </ul>
              <a href={link(`/niveaus/${n.niveau}/`)} class="knop knop-rand" style="margin-top: var(--ruimte-6)">
                Alle {n.aantal} trainingen op dit niveau
                <span class="pijl" aria-hidden="true">→</span>
              </a>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ═══ De mensen ═══ */}
  <section class="vlak-donker op-donker vlak">
    <div class="omvat mensen">
      <div>
        <p class="label">Wie er voor de groep staat</p>
        <h2 class="sectie-titel mensen-titel">Eén vast team, met {acteurs} trainingsacteurs</h2>
        <p class="mensen-tekst">
          Iedereen hier geeft alle trainingen, want Bureau Weerbaar en Veilig
          doet maar één ding. Dankzij de acteurs oefen je met de situatie die
          jij inbrengt, in plaats van met een bedacht rollenspel.
        </p>
        <a href={link('/over-ons/')} class="knop knop-rand mensen-knop">
          Maak kennis met het team
          <span class="pijl" aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="gezichtenrij">
        {team.map((lid) => {
          const foto = fotoVan(lid.id);
          return foto ? (
            <li>
              <a href={link(`/team/${lid.id}/`)}>
                <Image
                  src={foto}
                  alt={`${lid.data.naam}, ${inZin(lid.data.rol)}`}
                  width={112}
                  height={112}
                  format="webp"
                  quality={86}
                  loading="lazy"
                  decoding="async"
                  class="gezicht"
                />
              </a>
            </li>
          ) : null;
        })}
      </ul>
    </div>
  </section>

  {/* ═══ Afsluiting ═══ */}
  <section class="vlak-krap">
    <div class="omvat">
      <div class="actieband">
        <div>
          <h2>Niet zeker welk niveau je team nodig heeft?</h2>
          <p>
            Bel of vraag een terugbelverzoek aan. We denken mee over de juiste
            training, en je krijgt binnen één werkdag antwoord.
          </p>
        </div>
        <div class="hero-acties" style="margin-top: 0">
          <a href="tel:+31857600435" class="knop knop-vol">Bel 085 760 0435</a>
          <a href={link('/contact/')} class="knop knop-rand">Vraag een terugbelverzoek</a>
        </div>
      </div>
    </div>
  </section>
</Base>
