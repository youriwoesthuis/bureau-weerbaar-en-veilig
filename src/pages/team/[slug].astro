---
import { link } from '../../lib/link';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Terugbelverzoek from '../../components/Terugbelverzoek.astro';

/*
  Een eigen pagina per teamlid.

  Het verhaal van elke persoon stond al in src/content/team/, maar werd nergens
  getoond: op /over-ons/ zag je alleen naam, rol en foto. Zonde, want juist die
  teksten laten zien wie er voor de groep staat — en voor een merk zonder
  klantreferenties is dat het bewijs dat er is.

  De adressen komen overeen met die van de oude site. Die stonden als
  doorverwijzing naar /over-ons/#team in redirects.ts; die regels zijn eruit,
  zodat de oude URL's weer op echte inhoud uitkomen in plaats van op een
  doorverwijzing.
*/
export async function getStaticPaths() {
  const team = await getCollection('team');
  return team.map((lid) => ({ params: { slug: lid.id }, props: { lid } }));
}

const { lid } = Astro.props;
const d = lid.data;
const { Content } = await render(lid);

const team = (await getCollection('team')).sort((a, b) => a.data.volgorde - b.data.volgorde);
const anderen = team.filter((t) => t.id !== lid.id);

const fotos = import.meta.glob<{ default: ImageMetadata }>('../../images/team/*.jpg', {
  eager: true,
});
const fotoVan = (id: string) => {
  const sleutel = Object.keys(fotos).find((pad) => pad.endsWith(`/${id}.jpg`));
  return sleutel ? fotos[sleutel].default : undefined;
};
const foto = fotoVan(lid.id);

const isActeur = /acteur/i.test(d.rol);

const persoonSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  /*
    De trainingspagina's noemen deze persoon als instructor en verwijzen daarbij
    naar deze URL. Zonder een @id dat daarmee overeenkomt blijven dat twee losse
    vermeldingen van dezelfde naam; mét dit @id is het één persoon die op
    honderdtweeëndertig trainingen staat en hier zijn eigen verhaal heeft.
  */
  '@id': new URL(link(`/team/${lid.id}/`), Astro.site).href,
  name: d.naam,
  jobTitle: d.rol,
  worksFor: {
    '@type': 'Organization',
    name: 'Bureau Weerbaar en Veilig',
    url: 'https://bureauweerbaarenveilig.nl',
  },
  url: new URL(link(`/team/${lid.id}/`), Astro.site).href,
});
---

<Base
  titel={`${d.naam}, ${d.rol.toLowerCase()}`}
  beschrijving={`${d.naam} is ${d.rol.toLowerCase()} bij Bureau Weerbaar en Veilig, specialist in agressietraining per beroepsgroep en niveau.`}
  schema={[persoonSchema]}
>
  <div class="vlak-donker op-donker relative overflow-hidden text-white">
    <div class="motief-chevron absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-10 md:py-14">
      <Breadcrumb
        pad={[
          { naam: 'Home', pad: '/' },
          { naam: 'Over ons', pad: '/over-ons/' },
          { naam: d.naam },
        ]}
      />
      <p class="kicker mt-7">{d.rol}</p>
      <h1 class="mt-4 text-3xl font-bold leading-[1.15] md:text-5xl">{d.naam}</h1>
    </div>
  </div>
  <div class="lijn-merk" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 py-14">
    <div class="grid gap-10 lg:grid-cols-[20rem_1fr] lg:gap-14">
      <div class="lg:sticky lg:top-28 lg:self-start">
        {foto && (
          <Image
            src={foto}
            alt={d.foto?.alt ?? `Portretfoto van ${d.naam}`}
            width={480}
            height={600}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 20rem, 90vw"
            format="webp"
            quality={88}
            class="w-full rounded-2xl object-cover object-top shadow-[var(--shadow-kaart)]"
          />
        )}

        {isActeur && (
          <p class="mt-5 rounded-xl bg-vlak-warm p-4 text-sm leading-relaxed text-grijs">
            Als trainingsacteur speelt {d.naam.split(' ')[0]} de situatie die
            deelnemers zelf inbrengen. Daardoor wordt er geoefend met wat er
            écht gebeurde, in plaats van met een bedacht rollenspel.
          </p>
        )}
      </div>

      <div class="min-w-0">
        <div class="leestekst">
          <Content />
        </div>

        <div class="mt-10">
          <Terugbelverzoek onderwerp="een training voor jouw team" />
        </div>
      </div>
    </div>

    <section class="mt-16 border-t border-lijn pt-10" aria-labelledby="collegas">
      <h2 id="collegas" class="text-sm font-bold uppercase tracking-wide text-grijs">
        De rest van het team
      </h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {anderen.map((c) => {
          const f = fotoVan(c.id);
          return (
            <li class="kaart overflow-hidden">
              {f && (
                <Image
                  src={f}
                  alt=""
                  width={200}
                  height={250}
                  format="webp"
                  quality={82}
                  loading="lazy"
                  class="aspect-[4/5] w-full object-cover object-top"
                />
              )}
              <div class="p-3">
                <h3 class="text-sm font-bold leading-snug text-marine">
                  <a href={link(`/team/${c.id}/`)} class="after:absolute after:inset-0">
                    {c.data.naam}
                  </a>
                </h3>
                <p class="mt-0.5 text-xs leading-snug text-grijs">{c.data.rol}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  </div>
</Base>
