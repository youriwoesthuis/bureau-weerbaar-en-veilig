---
import { link } from '../../lib/link';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { ORGANISATIE, persoonId } from '../../lib/organisatie';
import Terugbelverzoek from '../../components/Terugbelverzoek.astro';

/*
  Een eigen pagina per teamlid.

  Het verhaal van elke persoon stond al in src/content/team/, maar werd nergens
  getoond: op /over-ons/ zag je alleen naam, rol en foto. Zonde, want juist die
  teksten laten zien wie er voor de groep staat — en voor een merk zonder
  klantreferenties is dat het bewijs dat er is.

  De adressen komen overeen met die van de oude site. Die stonden als
  doorverwijzing naar /over-ons/#team in redirects.ts; die regels zijn eruit,
  zodat de oude URL's weer op echte inhoud uitkomen in plaats van op een
  doorverwijzing.
*/
export async function getStaticPaths() {
  const team = await getCollection('team');
  return team.map((lid) => ({ params: { slug: lid.id }, props: { lid } }));
}

const { lid } = Astro.props;
const d = lid.data;
const { Content } = await render(lid);

const team = (await getCollection('team')).sort((a, b) => a.data.volgorde - b.data.volgorde);
const anderen = team.filter((t) => t.id !== lid.id);

const fotos = import.meta.glob<{ default: ImageMetadata }>('../../images/team/*.jpg', {
  eager: true,
});
const fotoVan = (id: string) => {
  const sleutel = Object.keys(fotos).find((pad) => pad.endsWith(`/${id}.jpg`));
  return sleutel ? fotos[sleutel].default : undefined;
};
const foto = fotoVan(lid.id);

const isActeur = /acteur/i.test(d.rol);

const paginaUrl = new URL(link(`/team/${lid.id}/`), Astro.site).href;

const persoonSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  /*
    De trainingspagina's noemen deze persoon als instructor en verwijzen daarbij
    naar dit identificatienummer. Komt het niet overeen, dan blijven het twee
    losse vermeldingen van dezelfde naam; komt het wel overeen, dan is het één
    persoon die op honderdtweeëndertig trainingen staat en hier zijn eigen
    verhaal heeft.

    Het anker `#persoon` scheidt de mens van de pagina. Zonder anker zou het
    identificatienummer gelijk zijn aan de URL van dit document, en dan zeg je
    dat de webpagina en de persoon hetzelfde ding zijn.
  */
  '@id': persoonId(paginaUrl),
  name: d.naam,
  jobTitle: d.rol,
  worksFor: ORGANISATIE,
  url: paginaUrl,
  /*
    De portretfoto hoort erbij. Voor een merk zonder geschiedenis is een gezicht
    bij een naam een van de weinige harde aanknopingspunten die er zijn, en de
    foto staat toch al op de pagina.
  */
  ...(foto ? { image: new URL(foto.src, Astro.site).href } : {}),
});
---


<Base
  titel={`${d.naam}, ${d.rol.toLowerCase()}`}
  beschrijving={`${d.naam} is ${d.rol.toLowerCase()} bij Bureau Weerbaar en Veilig, specialist in agressietraining per beroepsgroep en niveau.`}
  schema={[persoonSchema]}
>
  {/* ═══ Paginakop ═══ */}
  <section class="paginakop op-donker">
    <div class="wrap">
      <Breadcrumb
        pad={[
          { naam: 'Home', pad: '/' },
          { naam: 'Over ons', pad: '/over-ons/' },
          { naam: d.naam },
        ]}
      />
      <p class="eyebrow">{d.rol}</p>
      <h1>{d.naam}</h1>
    </div>
  </section>

  {/* ═══ Portret en verhaal ═══ */}
  <section class="section">
    <div class="wrap">
      <div class="persoon">
        <div class="persoon-zij">
          {foto && (
            <Image
              src={foto}
              alt={d.foto?.alt ?? `Portretfoto van ${d.naam}`}
              width={480}
              height={600}
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 20rem, 90vw"
              format="webp"
              quality={88}
              loading="eager"
              fetchpriority="high"
              class="persoon-foto"
            />
          )}

          {isActeur && (
            <p class="persoon-noot">
              Als trainingsacteur speelt {d.naam.split(' ')[0]} de situatie die
              deelnemers zelf inbrengen. Daardoor wordt er geoefend met wat er
              écht gebeurde, in plaats van met een bedacht rollenspel.
            </p>
          )}
        </div>

        <div class="persoon-tekst">
          <div class="leestekst">
            <Content />
          </div>

          <div class="persoon-cta">
            <Terugbelverzoek onderwerp="een training voor jouw team" />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ═══ De collega's ═══ */}
  <section class="section section--soft" aria-labelledby="collegas">
    <div class="wrap">
      <p class="eyebrow">Samen op de trainingsdag</p>
      <h2 id="collegas">De rest van het team</h2>
      <ul class="collegas">
        {anderen.map((c) => {
          const f = fotoVan(c.id);
          return (
            <li class="collega">
              {f && (
                <Image
                  src={f}
                  alt=""
                  width={200}
                  height={250}
                  format="webp"
                  quality={82}
                  loading="lazy"
                  class="teamfoto"
                />
              )}
              <div class="collega-tekst">
                <h3>
                  <a href={link(`/team/${c.id}/`)} class="vlakdek">{c.data.naam}</a>
                </h3>
                <p>{c.data.rol}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Base>
