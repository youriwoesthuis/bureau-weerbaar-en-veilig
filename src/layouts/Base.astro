---
import { link } from '../lib/link';
import '../styles/global.css';
import { paginaTitel as maakTitel, metaBeschrijving } from '../lib/seo';
import { ClientRouter } from 'astro:transitions';
import Logo from '../components/Logo.astro';

interface Props {
  titel: string;
  beschrijving: string;
  /** Extra JSON-LD schema's, al gestringificeerd */
  schema?: string[];
  /** Eigen deelafbeelding; laat leeg voor de standaard van de site */
  deelafbeelding?: string;
}

const { titel, beschrijving, schema = [], deelafbeelding } = Astro.props;
const paginaTitel = maakTitel(titel);
const paginaBeschrijving = metaBeschrijving(beschrijving);

/*
  Deelgegevens. Zonder deze regels toont LinkedIn, WhatsApp of Slack niets meer
  dan een kale link: geen titel, geen omschrijving, geen beeld. Voor een dienst
  die per mail en via LinkedIn wordt doorgestuurd is dat direct verlies.

  De URL's moeten absoluut zijn — een relatief pad werkt niet bij die platforms.
*/
const paginaUrl = new URL(Astro.url.pathname, Astro.site);
const deelUrl = new URL(link(deelafbeelding ?? '/og-afbeelding.png'), Astro.site);

const organisatieSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  name: 'Bureau Weerbaar en Veilig',
  description:
    'Specialist in agressietraining: omgaan met agressie, intimidatie en grensoverschrijdend gedrag op de werkvloer, per sector en beroepsgroep.',
  url: 'https://bureauweerbaarenveilig.nl',
  telephone: '+31857600435',
  email: 'info@bureauweerbaarenveilig.nl',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Russchemorsweg 5-04',
    postalCode: '7161 RT',
    addressLocality: 'Neede',
    addressRegion: 'Gelderland',
    addressCountry: 'NL',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:30',
    closes: '17:00',
  },
  sameAs: ['https://actinmove.nl', 'https://agressievisie.nl'],
});

/*
  Welk menu-item hoort bij de pagina waar je nu bent? Een trainingspagina valt
  onder Trainingen, een beroepsgroeppagina onder Sectoren. Daarom vergelijken we
  op het beginstuk van het pad en niet op een exacte gelijkenis.

  De homepage is de uitzondering: die begint met "/" en zou anders bij élk item
  passen.
*/
const huidigPad = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActief = (pad: string) => (pad === '/' ? huidigPad === '/' : huidigPad.startsWith(pad));

const hoofdmenu = [
  { naam: 'Agressietraining', pad: '/agressietraining/' },
  { naam: 'Trainingen', pad: '/trainingen/' },
  { naam: 'Sectoren', pad: '/sectoren/' },
  { naam: 'Niveaus', pad: '/niveaus/' },
  { naam: 'Trainingsgids', pad: '/trainingsgids/' },
  { naam: 'Over ons', pad: '/over-ons/' },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{paginaTitel}</title>
    <meta name="description" content={paginaBeschrijving} />
    <link rel="canonical" href={paginaUrl} />

    <!-- Pictogram in het tabblad; SVG blijft op elk scherm scherp -->
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#17203d" />

    <!-- Hoe de link eruitziet in LinkedIn, WhatsApp, Slack en mail -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bureau Weerbaar en Veilig" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={paginaTitel} />
    <meta property="og:description" content={paginaBeschrijving} />
    <meta property="og:url" content={paginaUrl} />
    <meta property="og:image" content={deelUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Bureau Weerbaar en Veilig, specialist in agressietraining"
    />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Zachte overgang tussen pagina's in plaats van een harde sprong. Puur
      afwerking: de volledige HTML van elke pagina blijft gewoon op de server
      staan, dus een zoekmachine of AI-crawler die geen scripts uitvoert ziet
      exact hetzelfde als eerst. Wie minder beweging wil ingesteld heeft, krijgt
      geen overgang — dat regelt Astro zelf.
    */}
    <ClientRouter />

    <script type="application/ld+json" set:html={organisatieSchema} />
    {schema.map((s) => <script type="application/ld+json" set:html={s} />)}
  </head>
  <body>
    <a href="#inhoud" class="skip-link">Direct naar inhoud</a>

    {/*
      Dekkende achtergrond, geen backdrop-blur. Samen met een tweede plakkend
      element eronder (de filterbalk op de overzichtspagina) liet Chrome het
      vlak ertussen ongetekend tijdens het scrollen.
    */}
    <header class="sticky top-0 z-40 border-b border-lijn bg-white">
      <div class="relative mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-4">
        <a href={link('/')} aria-label="Bureau Weerbaar en Veilig, naar de homepage">
          <Logo class="h-14 w-auto md:h-16" />
        </a>

        <nav aria-label="Hoofdmenu" class="hidden items-center gap-6 md:flex">
          {hoofdmenu.map((item) => (
            <a
              href={link(item.pad)}
              aria-current={isActief(item.pad) ? 'page' : undefined}
              class="menulink py-1.5 text-sm font-semibold text-inkt hover:text-blauw"
            >
              {item.naam}
            </a>
          ))}
          <a href={link('/contact/')} class="knop knop-primair px-5 py-2.5 text-sm">
            Contact
          </a>
        </nav>

        <!-- Mobiel menu: werkt zonder JavaScript via details/summary -->
        <details class="menu-mobiel md:hidden">
          <summary
            class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-lijn px-3 py-2 text-sm font-semibold"
            aria-label="Menu openen en sluiten"
          >
            <svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true" fill="currentColor">
              <rect x="2" y="4" width="16" height="2" rx="1" />
              <rect x="2" y="9" width="16" height="2" rx="1" />
              <rect x="2" y="14" width="16" height="2" rx="1" />
            </svg>
            Menu
          </summary>
          <nav
            aria-label="Mobiel hoofdmenu"
            class="absolute left-0 right-0 z-40 border-b border-lijn bg-white px-4 pb-6 pt-2 shadow-lg"
          >
            <ul class="space-y-1">
              {hoofdmenu.map((item) => (
                <li>
                  <a
                    href={link(item.pad)}
                    aria-current={isActief(item.pad) ? 'page' : undefined}
                    class="block rounded-md px-3 py-3 font-semibold hover:bg-vlak aria-[current=page]:bg-vlak aria-[current=page]:text-marine"
                  >
                    {item.naam}
                  </a>
                </li>
              ))}
              <li class="pt-2">
                <a href={link('/contact/')} class="knop knop-primair w-full">
                  Contact
                </a>
              </li>
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="inhoud">
      <slot />
    </main>

    <footer class="op-donker mt-20 bg-marine text-white">
      <div class="lijn-merk" aria-hidden="true"></div>
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-3">
        <div>
          <Logo variant="wit" class="h-20 w-auto" />
          <p class="mt-4 text-sm leading-relaxed text-white/80">
            Dé specialist in agressietraining. Eén onderwerp, tot in de diepte,
            vertaald naar jouw beroepsgroep.
          </p>
          <p class="mt-4 text-sm text-white/80">
            Onderdeel van <a href="https://actinmove.nl" class="underline hover:text-white">Actinmove</a>
          </p>
        </div>
        <div>
          <p class="font-semibold">Contact</p>
          <ul class="mt-2 space-y-1 text-sm text-white/80">
            <li>Russchemorsweg 5-04, 7161 RT Neede</li>
            <li><a href="tel:+31857600435" class="hover:text-white">085 760 0435</a></li>
            <li>
              <a href="mailto:info@bureauweerbaarenveilig.nl" class="hover:text-white">
                info@bureauweerbaarenveilig.nl
              </a>
            </li>
            <li>ma t/m vr 08:30–17:00</li>
          </ul>
        </div>
        <div>
          <p class="font-semibold">Snel naar</p>
          <ul class="mt-2 space-y-1 text-sm text-white/80">
            {hoofdmenu.map((item) => (
              <li><a href={link(item.pad)} class="inline-block py-1 hover:text-white">{item.naam}</a></li>
            ))}
            <li><a href={link('/contact/')} class="hover:text-white">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/15 py-4 text-center text-xs text-white/60">
        © {new Date().getFullYear()} Bureau Weerbaar en Veilig · Meer over agressie op
        <a href="https://agressievisie.nl" class="underline hover:text-white">agressievisie.nl</a>
      </div>
    </footer>
  </body>
</html>
