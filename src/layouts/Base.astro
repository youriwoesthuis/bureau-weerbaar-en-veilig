---
import { link } from '../lib/link';
import '../styles/global.css';
import { paginaTitel as maakTitel, metaBeschrijving } from '../lib/seo';
import { ClientRouter } from 'astro:transitions';
import Logo from '../components/Logo.astro';
import { TRAININGSGIDS } from '../lib/trainingsgids';
import { ORGANISATIE_ID } from '../lib/organisatie';

interface Props {
  titel: string;
  beschrijving: string;
  /** Extra JSON-LD schema's, al gestringificeerd */
  schema?: string[];
  /** Eigen deelafbeelding; laat leeg voor de standaard van de site */
  deelafbeelding?: string;
  /**
   * Houd deze pagina uit de zoekresultaten. Voor pagina's die alleen bestaan
   * als vervolgstap in een handeling — een bedankpagina bijvoorbeeld. Zo'n
   * pagina heeft geen zoekwaarde, en wie er via Google op binnenkomt krijgt
   * een bevestiging te zien van iets wat diegene nooit heeft ingevuld.
   *
   * Let op: een pagina die op noindex staat hoort ook uit de sitemap; dat is
   * apart geregeld in astro.config.mjs.
   */
  nietIndexeren?: boolean;
}

const {
  titel,
  beschrijving,
  schema = [],
  deelafbeelding,
  nietIndexeren = false,
} = Astro.props;
const paginaTitel = maakTitel(titel);
const paginaBeschrijving = metaBeschrijving(beschrijving);

/*
  Deelgegevens. Zonder deze regels toont LinkedIn, WhatsApp of Slack niets meer
  dan een kale link: geen titel, geen omschrijving, geen beeld. Voor een dienst
  die per mail en via LinkedIn wordt doorgestuurd is dat direct verlies.

  De URL's moeten absoluut zijn — een relatief pad werkt niet bij die platforms.
*/
const paginaUrl = new URL(Astro.url.pathname, Astro.site);
const deelUrl = new URL(link(deelafbeelding ?? '/og-afbeelding.png'), Astro.site);

const organisatieSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  /*
    Het identificatienummer waar de rest van de site naar verwijst. Zonder dit
    was elke vermelding van de organisatie — als provider van een training, als
    werkgever van een trainer, als uitgever van een certificaat — een los
    knooppunt dat toevallig dezelfde naam droeg. Zie src/lib/organisatie.ts.
  */
  '@id': ORGANISATIE_ID,
  name: 'Bureau Weerbaar en Veilig',
  description:
    'Specialist in agressietraining: omgaan met agressie, intimidatie en grensoverschrijdend gedrag op de werkvloer, per sector en beroepsgroep.',
  url: 'https://bureauweerbaarenveilig.nl',
  telephone: '+31857600435',
  email: 'info@bureauweerbaarenveilig.nl',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Russchemorsweg 5-04',
    postalCode: '7161 RT',
    addressLocality: 'Neede',
    addressRegion: 'Gelderland',
    addressCountry: 'NL',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:30',
    closes: '17:00',
  },
  sameAs: ['https://actinmove.nl', 'https://agressievisie.nl'],
});

/*
  Welk menu-item hoort bij de pagina waar je nu bent? Een trainingspagina valt
  onder Trainingen, een beroepsgroeppagina onder Sectoren. Daarom vergelijken we
  op het beginstuk van het pad en niet op een exacte gelijkenis.

  De homepage is de uitzondering: die begint met "/" en zou anders bij élk item
  passen.
*/
const huidigPad = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActief = (pad: string) => (pad === '/' ? huidigPad === '/' : huidigPad.startsWith(pad));

const hoofdmenu = [
  { naam: 'Agressietraining', pad: '/agressietraining/' },
  { naam: 'Trainingen', pad: '/trainingen/' },
  { naam: 'Sectoren', pad: '/sectoren/' },
  { naam: 'Niveaus', pad: '/niveaus/' },
  { naam: 'Trainingsgids', pad: '/trainingsgids/' },
  { naam: 'Over ons', pad: '/over-ons/' },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{paginaTitel}</title>
    <meta name="description" content={paginaBeschrijving} />
    {
      /*
        Canonical en noindex sluiten elkaar uit. Ze spreken elkaar tegen: de
        canonical zegt "dit is het origineel, neem dit op" en de noindex zegt
        het omgekeerde. Google negeert er dan een van, en welke ligt niet vast.

        Dezelfde fout stond eerder op de doorverwijspagina's van deze site, en
        staat als les vastgelegd in de netlify.toml van agressievisie.nl. Dus:
        of een canonical, of een noindex — nooit allebei.
      */
      nietIndexeren ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <link rel="canonical" href={paginaUrl} />
      )
    }

    <!-- Pictogram in het tabblad; SVG blijft op elk scherm scherp -->
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#17203d" />

    <!-- Hoe de link eruitziet in LinkedIn, WhatsApp, Slack en mail -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bureau Weerbaar en Veilig" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={paginaTitel} />
    <meta property="og:description" content={paginaBeschrijving} />
    <meta property="og:url" content={paginaUrl} />
    <meta property="og:image" content={deelUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Bureau Weerbaar en Veilig, specialist in agressietraining"
    />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Zachte overgang tussen pagina's in plaats van een harde sprong. Puur
      afwerking: de volledige HTML van elke pagina blijft gewoon op de server
      staan, dus een zoekmachine of AI-crawler die geen scripts uitvoert ziet
      exact hetzelfde als eerst. Wie minder beweging wil ingesteld heeft, krijgt
      geen overgang — dat regelt Astro zelf.
    */}
    <ClientRouter />

    <script type="application/ld+json" set:html={organisatieSchema} />
    {schema.map((s) => <script type="application/ld+json" set:html={s} />)}
  </head>
  <body>
    <a href="#inhoud" class="skip-link">Direct naar inhoud</a>

    <header class="site niet-printen">
      <div class="nav">
        <a href={link('/')} class="brand" aria-label="Bureau Weerbaar en Veilig, naar de homepage">
          <Logo />
        </a>

        <nav class="nav-links" id="hoofdmenu" aria-label="Hoofdmenu">
          {hoofdmenu.map((item) => (
            <a
              href={link(item.pad)}
              class={isActief(item.pad) ? 'current' : undefined}
              aria-current={isActief(item.pad) ? 'page' : undefined}
            >
              {item.naam}
            </a>
          ))}
        </nav>

        <div class="nav-cta">
          <a href={link('/contact/')} class="btn btn-primary">Contact</a>
          {/*
            Het mobiele menu werkt met een klein stukje script. Valt dat weg,
            dan blijft de navigatie bereikbaar: de voettekst bevat dezelfde
            links, en elke pagina heeft een kruimelpad.
          */}
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="hoofdmenu">
            <span></span><span></span><span></span>
            <span class="sr-only">Menu openen en sluiten</span>
          </button>
        </div>
      </div>
    </header>

    <main id="inhoud">
      <slot />
    </main>

    <footer class="site">
      <div class="footer-accent" aria-hidden="true"></div>
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <Logo variant="wit" />
            <p>
              Dé specialist in agressietraining. Eén onderwerp, tot in de diepte,
              vertaald naar jouw beroepsgroep.
            </p>
          </div>

          <div>
            <span class="voet-kop">Contact</span>
            <ul>
              <li>Russchemorsweg 5-04</li>
              <li>7161 RT Neede</li>
              <li><a href="tel:+31857600435">085 760 0435</a></li>
              <li><a href="mailto:info@bureauweerbaarenveilig.nl">info@bureauweerbaarenveilig.nl</a></li>
              <li>ma t/m vr 08:30–17:00</li>
            </ul>
          </div>

          <div>
            <span class="voet-kop">Trainingen</span>
            <ul>
              {hoofdmenu.map((item) => (
                <li><a href={link(item.pad)}>{item.naam}</a></li>
              ))}
              <li><a href={link('/contact/')}>Contact</a></li>
            </ul>
          </div>

          <div>
            <span class="voet-kop">Voordat je boekt</span>
            <ul>
              {TRAININGSGIDS.map((p) => (
                <li><a href={link(`/trainingsgids/${p.slug}/`)}>{p.kortelabel}</a></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Bureau Weerbaar en Veilig · onderdeel van <a href="https://actinmove.nl">Actinmove</a></span>
          <span>Meer over agressie op <a href="https://agressievisie.nl">agressievisie.nl</a></span>
        </div>
      </div>
    </footer>

    <script is:inline>
      /*
        Het mobiele menu. Bewust een paar regels en geen framework: de
        navigatie staat volledig in de HTML, dit zet alleen een klasse om.
      */
      document.querySelector('.nav-toggle')?.addEventListener('click', (e) => {
        const knop = e.currentTarget;
        const menu = document.getElementById('hoofdmenu');
        const open = menu.classList.toggle('open');
        knop.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
