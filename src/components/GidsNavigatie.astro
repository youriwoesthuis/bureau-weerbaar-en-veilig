---
import { link } from '../lib/link';
import { TRAININGSGIDS } from '../lib/trainingsgids';

/**
 * Vorige en volgende pagina binnen de trainingsgids.
 * De vijf vragen vormen samen één route van kiezen naar verantwoorden; zonder
 * deze navigatie is elke pagina een doodlopend eind.
 */
interface Props {
  huidig: string;
}
const { huidig } = Astro.props;

const i = TRAININGSGIDS.findIndex((p) => p.slug === huidig);
const vorige = i > 0 ? TRAININGSGIDS[i - 1] : undefined;
const volgende = i >= 0 && i < TRAININGSGIDS.length - 1 ? TRAININGSGIDS[i + 1] : undefined;
---

<nav class="mt-14 border-t border-lijn pt-6" aria-label="Trainingsgids">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-stretch sm:justify-between">
    {vorige ? (
      <a
        href={link(`/trainingsgids/${vorige.slug}/`)}
        class="group flex-1 rounded-lg border border-lijn p-4 transition-colors hover:border-marine"
      >
        <span class="text-xs font-bold uppercase tracking-wide text-grijs">Vorige</span>
        <span class="mt-1 block font-bold text-marine">
          <span class="inline-block transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
          {' '}{vorige.titel}
        </span>
      </a>
    ) : (
      <span class="flex-1"></span>
    )}

    {volgende && (
      <a
        href={link(`/trainingsgids/${volgende.slug}/`)}
        class="group flex-1 rounded-lg border border-lijn p-4 text-right transition-colors hover:border-marine"
      >
        <span class="text-xs font-bold uppercase tracking-wide text-grijs">Volgende</span>
        <span class="mt-1 block font-bold text-marine">
          {volgende.titel}{' '}
          <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </span>
      </a>
    )}
  </div>

  <p class="mt-4 text-center text-sm text-grijs">
    <a href={link('/trainingsgids/')} class="font-semibold text-blauw hover:underline">
      Alle vijf de vragen in de trainingsgids
    </a>
  </p>
</nav>
