---
import { link } from '../lib/link';
import { TRAININGSGIDS } from '../lib/trainingsgids';

/**
 * Vorige en volgende pagina binnen de trainingsgids.
 * De vijf vragen vormen samen één route van kiezen naar verantwoorden; zonder
 * deze navigatie is elke pagina een doodlopend eind.
 */
interface Props {
  huidig: string;
}
const { huidig } = Astro.props;

const i = TRAININGSGIDS.findIndex((p) => p.slug === huidig);
const vorige = i > 0 ? TRAININGSGIDS[i - 1] : undefined;
const volgende = i >= 0 && i < TRAININGSGIDS.length - 1 ? TRAININGSGIDS[i + 1] : undefined;
---

<nav class="gidsnav" aria-label="Trainingsgids">
  <div class="gidsnav-paar">
    {vorige ? (
      <a href={link(`/trainingsgids/${vorige.slug}/`)} class="gidsnav-stap">
        <span class="gidsnav-label">Vorige</span>
        <span class="gidsnav-titel"><span aria-hidden="true">←</span> {vorige.titel}</span>
      </a>
    ) : (
      <span class="gidsnav-leeg"></span>
    )}

    {volgende && (
      <a href={link(`/trainingsgids/${volgende.slug}/`)} class="gidsnav-stap gidsnav-stap--rechts">
        <span class="gidsnav-label">Volgende</span>
        <span class="gidsnav-titel">{volgende.titel} <span aria-hidden="true">→</span></span>
      </a>
    )}
  </div>

  <p class="gidsnav-alle">
    <a href={link('/trainingsgids/')}>Alle vijf de vragen in de trainingsgids</a>
  </p>
</nav>
