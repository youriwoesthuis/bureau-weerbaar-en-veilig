---
import { link } from '../lib/link';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * "Wie deze training geeft" — de gezichten van het team op een trainingspagina.
 *
 * Iedereen geeft alle trainingen, want het bureau doet maar één onderwerp. Er is
 * dus geen koppeling tussen een training en een trainer, en die zou hier ook
 * niets toevoegen: je krijgt dit team, wie er die dag ook staat.
 *
 * Alleen de mensen die daadwerkelijk voor een groep staan. Wie de organisatie
 * draaiend houdt hoort thuis op de teampagina, niet bij de vraag wie er straks
 * in de zaal staat.
 */
const team = (await getCollection('team')).sort((a, b) => a.data.volgorde - b.data.volgorde);
const voorDeGroep = team.filter((lid) => /trainer|coach|acteur/i.test(lid.data.rol));
const acteurs = voorDeGroep.filter((lid) => /acteur/i.test(lid.data.rol));

const fotos = import.meta.glob<{ default: ImageMetadata }>('../images/team/*.jpg', { eager: true });
const fotoVan = (id: string) => {
  const sleutel = Object.keys(fotos).find((pad) => pad.endsWith(`/${id}.jpg`));
  return sleutel ? fotos[sleutel].default : undefined;
};
---

<section
  class="vlak-donker op-donker relative overflow-hidden rounded-2xl p-7 text-white md:p-9"
  aria-labelledby="trainers-titel"
>
  <div class="motief-chevron absolute inset-0" aria-hidden="true"></div>

  <div class="relative">
    <p class="kicker">Wie deze training geeft</p>
    <h2 id="trainers-titel" class="mt-4 text-2xl font-bold leading-snug">
      Ons vaste team, met {acteurs.length} trainingsacteurs
    </h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-white/85">
      Iedereen hier geeft alle trainingen: Bureau Weerbaar en Veilig doet maar
      één onderwerp. Dankzij de acteurs kan er geoefend worden met de situatie
      die jij inbrengt, in plaats van met een bedacht rollenspel.
    </p>

    <ul class="gezichten mt-7" aria-label={`De ${voorDeGroep.length} trainers en trainingsacteurs`}>
      {voorDeGroep.map((lid) => {
        const foto = fotoVan(lid.id);
        return (
          <li class="gezicht">
            {foto && (
              <Image
                src={foto}
                alt={lid.data.foto?.alt ?? `Portretfoto van ${lid.data.naam}`}
                width={140}
                height={140}
                format="webp"
                quality={88}
                loading="lazy"
              />
            )}
            <span class="gezicht-naam">
              {lid.data.naam}
              <span class="gezicht-rol">{lid.data.rol}</span>
            </span>
          </li>
        );
      })}
    </ul>

    <a href={link('/over-ons/')} class="knop knop-omlijnd-licht mt-6 text-sm">
      Maak kennis met het team
      <span class="pijl" aria-hidden="true">→</span>
    </a>
  </div>
</section>
