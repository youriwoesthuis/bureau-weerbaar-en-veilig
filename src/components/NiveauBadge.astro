---
interface Props {
  niveau: 'basis' | 'gevorderd' | 'expert';
  /**
   * Laat het woord "Niveau:" weg. Voor lijsten waarin de badge tientallen keren
   * onder elkaar staat: daar is die aanhef puur herhaling, en dragen de kleur en
   * de omgeving de betekenis al.
   */
  kort?: boolean;
}
const { niveau, kort = false } = Astro.props;

/*
  De drie niveaus dragen de drie merkkleuren, in de volgorde van het
  logoverloop: oranje (basis) → paars (gevorderd) → indigo (expert).
  Alle drie de combinaties halen ruim de AA-eis van 4,5:1 op hun eigen
  achtergrondtint.
*/
const stijl = {
  basis: 'bg-oranje-licht text-oranje-tekst',
  gevorderd: 'bg-paars-licht text-paars',
  expert: 'bg-blauw-licht text-indigo',
}[niveau];

const stip = {
  basis: 'bg-oranje',
  gevorderd: 'bg-paars',
  expert: 'bg-indigo',
}[niveau];

const label = { basis: 'Basis', gevorderd: 'Gevorderd', expert: 'Expert' }[niveau];
---

<span
  {/*
    self-start houdt de badge om zijn tekst heen. Zonder dat rekt hij mee tot de
    volle breedte zodra hij in een flexkolom staat, wat op de kaarten gebeurt.
    Buiten een flexcontainer heeft de regel geen effect.
  */}
  class={`inline-flex self-start items-center gap-2 rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide ${stijl}`}
>
  <span class={`h-1.5 w-1.5 rounded-full ${stip}`} aria-hidden="true"></span>
  {kort ? label : `Niveau: ${label}`}
</span>
