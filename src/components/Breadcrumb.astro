---
import { link } from '../lib/link';

interface Kruimel {
  naam: string;
  pad?: string;
}
interface Props {
  pad: Kruimel[];
}
const { pad } = Astro.props;

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: pad.map((k, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: k.naam,
    ...(k.pad ? { item: new URL(link(k.pad), Astro.site).href } : {}),
  })),
});
---

<nav aria-label="Kruimelpad" class="kruimelpad text-sm text-grijs">
  <ol class="flex flex-wrap items-center gap-1">
    {pad.map((k, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span aria-hidden="true">›</span>}
        {k.pad ? (
          /*
            py-1.5 brengt het klikdoel van twintig naar vierentwintig pixels
            hoog. Dat is geen eis onder WCAG 2.1 AA — daar is doelgrootte
            niveau AAA — maar op een telefoon is een kruimelpad van twintig
            pixels gewoon lastig te raken, en de regel kost geen ruimte omdat
            er toch al lucht boven en onder staat.
          */
          <a href={link(k.pad)} class="inline-block py-1.5 hover:text-blauw hover:underline">
            {k.naam}
          </a>
        ) : (
          <span aria-current="page" class="font-medium text-inkt">{k.naam}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={schema} />
