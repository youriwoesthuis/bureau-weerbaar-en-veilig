---
import { link } from '../lib/link';

interface Kruimel {
  naam: string;
  pad?: string;
}
interface Props {
  pad: Kruimel[];
}
const { pad } = Astro.props;

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: pad.map((k, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: k.naam,
    ...(k.pad ? { item: new URL(link(k.pad), Astro.site).href } : {}),
  })),
});
---

<nav aria-label="Kruimelpad" class="breadcrumbs">
  <ol>
    {pad.map((k, i) => (
      <li>
        {i > 0 && <span aria-hidden="true">›</span>}
        {k.pad ? (
          /*
            De verticale opvulling brengt het klikdoel van twintig naar
            vierentwintig pixels hoog. Dat is geen eis onder WCAG 2.1 AA —
            doelgrootte is daar niveau AAA — maar op een telefoon is een
            kruimelpad van twintig pixels gewoon lastig te raken, en de regel
            kost geen ruimte omdat er toch al lucht boven en onder staat.
          */
          <a href={link(k.pad)}>{k.naam}</a>
        ) : (
          <span aria-current="page">{k.naam}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={schema} />
