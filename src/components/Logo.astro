---
/**
 * Het logo van Bureau Weerbaar en Veilig.
 *
 * Opbouw, volgens het aangeleverde logo:
 *   - woordmerk "Bureau" (oranje) boven "Weerbaar en Veilig" (marineblauw)
 *   - daaronder een oranje cirkel die in de holte van de eerste chevron ligt
 *   - de bovenste chevron loopt symmetrisch over de volle breedte
 *   - de onderste chevron heeft een halve linkerarm en een volle rechterarm
 *   - één kleurverloop over beide chevrons, van oranje linksboven naar blauw
 *     rechtsonder
 *
 * Het originele logobestand heeft altijd voorrang. Zet het neer als
 * `public/images/logo/logo-origineel.svg` (of .png, of -wit.svg voor de footer);
 * de site pakt het dan automatisch op, zonder codewijziging.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  /** 'kleur' voor lichte achtergronden, 'wit' voor de donkere footer */
  variant?: 'kleur' | 'wit';
  class?: string;
}

const { variant = 'kleur', class: extraKlasse = '' } = Astro.props;
const wit = variant === 'wit';

const kandidaten = wit
  ? ['logo-origineel-wit.svg', 'logo-origineel-wit.png', 'logo-origineel.svg', 'logo-origineel.png']
  : ['logo-origineel.svg', 'logo-origineel.png'];

const publiekeMap = join(process.cwd(), 'public', 'images', 'logo');
const origineel = kandidaten.find((naam) => existsSync(join(publiekeMap, naam)));

const oranje = wit ? '#ffffff' : '#f18919';
const marine = wit ? '#ffffff' : '#212e56';
const verloopId = `bwv-verloop-${variant}`;
const merkvulling = wit ? '#ffffff' : `url(#${verloopId})`;

/* Chevron boven: symmetrisch, volle breedte. */
const chevronBoven = 'M210 182 L304 252 L398 182 L398 236 L304 306 L210 236 Z';
/* Chevron onder: linkerarm halveert op x=257, rechterarm loopt door tot x=398. */
const chevronOnder = 'M257 306 L304 341 L398 271 L398 325 L304 395 L257 360 Z';
---

{
  origineel ? (
    <img
      src={`/images/logo/${origineel}`}
      alt="Bureau Weerbaar en Veilig"
      class={extraKlasse}
      width="608"
      height="400"
    />
  ) : (
    <svg
      viewBox="0 0 608 400"
      class={extraKlasse}
      role="img"
      aria-label="Bureau Weerbaar en Veilig"
      xmlns="http://www.w3.org/2000/svg"
    >
      {!wit && (
        <defs>
          <linearGradient id={verloopId} x1="210" y1="182" x2="400" y2="330" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#f18919" />
            <stop offset="50%" stop-color="#e8801f" />
            <stop offset="72%" stop-color="#b06a55" />
            <stop offset="100%" stop-color="#35409b" />
          </linearGradient>
        </defs>
      )}

      <text
        x="304"
        y="41"
        text-anchor="middle"
        textLength="172"
        lengthAdjust="spacing"
        fill={oranje}
        font-family="'Montserrat Variable', Montserrat, system-ui, sans-serif"
        font-size="47"
        font-weight="500"
      >
        Bureau
      </text>
      <text
        x="304"
        y="104"
        text-anchor="middle"
        textLength="596"
        lengthAdjust="spacing"
        fill={marine}
        font-family="'Montserrat Variable', Montserrat, system-ui, sans-serif"
        font-size="63"
        font-weight="700"
      >
        Weerbaar en Veilig
      </text>

      <circle cx="304" cy="182" r="40" fill={oranje} />
      <path d={chevronBoven} fill={merkvulling} />
      <path d={chevronOnder} fill={merkvulling} />
    </svg>
  )
}
