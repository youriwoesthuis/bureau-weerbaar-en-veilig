---
import { inZin } from '../../lib/naam';
/**
 * De drie niveaus naast elkaar, als echte tabel.
 *
 * Dit is de component die in het plan "RiskMatrixTable" heette. De opzet is
 * overgenomen — een getypeerde datastructuur, een toegankelijke HTML-tabel,
 * een vergelijking die een AI-systeem in één keer kan uitlezen — maar de
 * kolommen zijn andere.
 *
 * ── Waarom niet primaryThreat, legalFramework en recommendedFrequency ──
 *
 * Die drie velden bestaan niet in de data van deze site, en ze zijn ook niet af
 * te leiden. Welke dreiging "primair" is bij een van vierenveertig
 * beroepsgroepen is een empirische uitspraak; een aanbevolen trainingsfrequentie
 * is een productbelofte die het bureau nooit heeft gedaan. Ze invullen zou
 * betekenen dat ze verzonnen worden, en dan staan er verzonnen feiten in
 * precies het blok dat gebouwd is om geciteerd te worden.
 *
 * Het wettelijk kader is bovendien voor alle vierenveertig gelijk — de Arbowet
 * verplicht werkgevers tot beleid tegen psychosociale arbeidsbelasting,
 * ongeacht het beroep. Dat vierenveertig keer herhalen levert vierenveertig
 * identieke tabelrijen op, en dat is het tegenovergestelde van wat deze tabel
 * moet doen. Het hoort één keer op de uitlegpagina, en de verdieping erover
 * hoort bij agressievisie.nl.
 *
 * Wat er wél in staat komt uit de trainingen zelf en verschilt per niveau: voor
 * wie het bedoeld is, wat je vooraf moet kunnen, wat je meeneemt en hoe groot
 * de groep is. Dat is ook de vergelijking waar een opdrachtgever op deze pagina
 * voor komt.
 */

export interface NiveauRij {
  niveau: 'basis' | 'gevorderd' | 'expert';
  label: string;
  /** Voor wie dit niveau bedoeld is. Uit het veld doelgroep van de training. */
  voorWie: string;
  /** Wat er vooraf nodig is, of dat er niets nodig is. */
  vooraf: string;
  /** De belangrijkste leeruitkomsten, hooguit drie. */
  meeneemt: string[];
  duur: string;
  groepsgrootte: string;
  /** Naar de trainingspagina zelf. */
  pad: string;
}

interface Props {
  /** Waar deze vergelijking over gaat; komt in de tabelbeschrijving. */
  beroepsgroep: string;
  rijen: NiveauRij[];
}

const { beroepsgroep, rijen } = Astro.props;
---

{/*
  De tabel scrolt binnen zijn eigen kader in plaats van de pagina breed te
  maken. tabindex en role maken van dat kader een gebied dat ook met het
  toetsenbord te scrollen is — zonder die twee kan iemand die geen muis
  gebruikt niet bij de rechterkolommen.
*/}
<div
  class="niveaumatrix-omhulling"
  tabindex="0"
  role="region"
  aria-labelledby="niveaumatrix-titel"
>
  <table class="niveaumatrix">
    <caption id="niveaumatrix-titel" class="niveaumatrix-caption">
      De {rijen.length} niveaus agressietraining voor {inZin(beroepsgroep)}
      vergeleken op doelgroep, voorkennis, leeruitkomsten en groepsgrootte.
    </caption>
    <thead>
      <tr>
        {/*
          De hoek linksboven blijft leeg: daar staat geen kolomkop maar het
          snijpunt van rij- en kolomkoppen. Een woord als "Kenmerk" zou een
          schermlezer laten voorlezen bij elke cel in de eerste kolom.
        */}
        <td class="niveaumatrix-hoek"></td>
        {rijen.map((r) => (
          <th scope="col" class={`niveaumatrix-kop niveau-${r.niveau}`}>
            <span class="niveaumatrix-koplabel">{r.label}</span>
            <a href={r.pad} class="niveaumatrix-koplink">
              Bekijk het programma
              <span class="sr-only"> van het niveau {r.label.toLowerCase()}</span>
              <span class="pijl" aria-hidden="true">→</span>
            </a>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">Voor wie</th>
        {rijen.map((r) => <td>{r.voorWie}</td>)}
      </tr>
      <tr>
        <th scope="row">Vooraf nodig</th>
        {rijen.map((r) => <td>{r.vooraf}</td>)}
      </tr>
      <tr>
        <th scope="row">Wat je meeneemt</th>
        {rijen.map((r) => (
          <td>
            <ul class="niveaumatrix-lijst">
              {r.meeneemt.map((m) => <li>{m}</li>)}
            </ul>
          </td>
        ))}
      </tr>
      <tr>
        <th scope="row">Duur</th>
        {rijen.map((r) => <td>{r.duur}</td>)}
      </tr>
      <tr>
        <th scope="row">Groepsgrootte</th>
        {rijen.map((r) => <td>{r.groepsgrootte}</td>)}
      </tr>
    </tbody>
  </table>
</div>
