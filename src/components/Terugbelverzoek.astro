---
import { link } from '../lib/link';
/**
 * Terugbelverzoek-blok: de ene duidelijke actie per scherm.
 * Het contactformulier draait op Web3Forms (zie /contact/); de telefoon- en
 * maillinks hier werken sowieso, ook zonder JavaScript.
 */
interface Props {
  onderwerp?: string;
}
const { onderwerp = 'deze training' } = Astro.props;
---

<aside class="cta-band" aria-labelledby="terugbel-titel">
  <div>
    <p class="eyebrow">Even overleggen?</p>
    <h2 id="terugbel-titel">Vragen over {onderwerp}?</h2>
    <p>
      Bureau Weerbaar en Veilig denkt graag mee over de juiste training voor jouw
      team. Bel, mail of vraag een terugbelverzoek aan — reactie binnen één
      werkdag.
    </p>
  </div>

  <div class="hero-actions">
    <a href="tel:+31857600435" class="btn btn-outline">Bel 085 760 0435</a>
    <a href={link('/contact/')} class="btn btn-outline">Vraag een terugbelverzoek</a>
  </div>
</aside>
